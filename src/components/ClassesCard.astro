---
import { Image } from "astro:assets"
import CloudinaryImage from "./ui/CloudinaryImage.astro"
import type { ImageMetadata } from "astro";

// import bgTitle from "../../assets/27250374_1290.webp";
import bgPattern from "../../../src/assets/bg-pattern.webp";
import bgTitle from "../assets/27250374_1290.webp";

interface Classes {
  name: string;
  img: ImageMetadata | string;
  width: number;
  height: number;
  alt: string;
  url: string;
}

interface Props {
  classes: Classes[];
}

const { classes } = Astro.props as Props;
---

<div class="class-grid flex flex-wrap justify-center gap-8 max-w-7xl px-4 py-8 mx-auto">
  {
    classes.map((kelas) => (
      <a href={kelas.url} class="class-card group">
        <div class="class-item relative overflow-hidden rounded-2xl shadow-md transition-all duration-500 group-hover:shadow-2xl group-hover:-translate-y-2">
          
          {/* Ribbon */}
          <div class="ribbon-container absolute top-0 right-0 w-32 h-32 overflow-hidden z-30 pointer-events-none">
            <div class="ribbon bg-white text-slate-900 py-1.5 font-bold text-[10px] md:text-xs shadow-xl text-center uppercase tracking-tighter">
              {kelas.name}
            </div>
          </div>

          {/* Hover Overlay */}
          <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center z-20">
            <div class="text-white text-center transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
              <span class="block text-sm opacity-80 uppercase tracking-widest mb-1">Kelas</span>
              <span class="block font-bold text-xl md:text-2xl tracking-wide">XII {kelas.name}</span>
            </div>
          </div>

          {
            typeof kelas.img === "string" && kelas.img.includes("res.cloudinary.com") ? (
              <CloudinaryImage
                src={kelas.img}
                alt={kelas.alt}
                class="rounded-2xl transition-transform duration-700 group-hover:scale-110 object-cover w-full h-full"
                widths={[400, 800]}
                loading="lazy"
              />
            ) : (
              <Image
                src={kelas.img as any}
                width={kelas.width}
                height={kelas.height}
                alt={kelas.alt}
                class="rounded-2xl transition-transform duration-700 group-hover:scale-110"
              />
            )
          }
        </div>
      </a>
    ))
  }
</div>

<style>
  .class-card {
    flex: 0 0 100%;
    text-decoration: none;
    color: inherit;
  }

  .ribbon-container {
    /* Container for clipping the ribbon */
  }

  .ribbon {
    position: absolute;
    top: 20px;
    right: -40px;
    width: 160px;
    transform: rotate(45deg);
    z-index: 40;
  }

  /* Tablet: 2 per row - 768px */
  @media (min-width: 768px) {
    .class-card {
      flex: 0 0 calc(50% - 1rem);
    }
  }

  /* Laptop: 4 per row - 1024px */
  @media (min-width: 1024px) {
    .class-card {
      flex: 0 0 calc(25% - 1.5rem);
    }
  }

  .class-item img {
    width: 100%;
    height: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
</style>
