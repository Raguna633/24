---
import { getOptimizedCloudinaryUrl, getCloudinarySrcset } from "../../utils/cloudinary";

interface Props {
  src: string;
  alt: string;
  class?: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  fetchpriority?: "high" | "low" | "auto";
  fallbackSrc?: string;
  [key: string]: any;
}

const { 
  src, 
  alt, 
  class: className, 
  widths = [400, 800, 1200, 1600, 1920], 
  sizes = "(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw",
  loading = "lazy",
  decoding = "async",
  fetchpriority = "auto",
  fallbackSrc = "/assets/placeholder.jpg",
  ...rest
} = Astro.props;

const optimizedSrc = getOptimizedCloudinaryUrl(src, widths[1]); // Default ke lebar menengah
const srcset = getCloudinarySrcset(src, widths);
---

<img
  src={optimizedSrc}
  srcset={srcset}
  sizes={sizes}
  alt={alt}
  class={className}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  onerror={`this.onerror=null;this.srcset='';this.src='${fallbackSrc}';this.classList.add('cloudinary-fallback');`}
  {...rest}
/>
