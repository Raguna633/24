---
// AltieHero.astro
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";
import heroBg from "../../assets/bg/DSC08738.jpg";
import Copy from "../Copy";
import { ReactLenis } from "lenis/react";
---

<section class="hero relative w-screen h-screen min-w-screen min-h-screen">
  <div class="hero-bg w-screen h-screen z-0">
    <div
      class="overlay absolute w-full h-full bg-linear-to-b bg-amber-50 opacity-70 z-0"
    >
    </div>
    <Image
      alt="hero"
      src={heroBg}
      width={1920}
      height={1080}
      class:list={"-z-10 relative"}
      loading={"eager"}
    />
  </div>
  <div class="text text-black absolute top-1/2 left-1/2">
    <Copy client:visible>
    <p>
      Lorem ipsum dolor sit amet consectetur adipisicing elit. Ut, corrupti!
      Commodi praesentium soluta quod suscipit sit corrupti incidunt minima
      veniam. Corrupti facilis sint distinctio possimus nisi totam quam, maxime
      quos.
    </p>
    </Copy>
  </div>
</section>
