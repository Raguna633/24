---
const dummyImg = 'https://res.cloudinary.com/dhbps9kvp/image/upload/v1775104998/dummy.webp';
import BlockReveal from '../BlockReveal.astro';

interface Props {
  name: string;
  subjects: string;
  index: number;
  offset?: boolean;
  photo?: string;
}

const { name, subjects, index, offset = false, photo } = Astro.props;
const displayImg = photo || dummyImg;

// Helper for Cloudinary optimization (Rule 04)
const optimizeCloudinaryUrl = (url: string, width: number = 600) => {
  if (!url || !url.includes('cloudinary.com')) return url;
  if (url.includes('f_auto')) return url; // Already optimized
  
  const parts = url.split('/upload/');
  if (parts.length === 2) {
    // Add f_auto, q_auto, c_fill, and specific width & aspect ratio
    return `${parts[0]}/upload/f_auto,q_auto,w_${width},c_fill,ar_3:4/${parts[1]}`;
  }
  return url;
};

// Optimized URL for the grid card
const optimizedImg = optimizeCloudinaryUrl(displayImg, 600);
// High-res optimized URL for the modal (passed via data-img)
const modalImg = optimizeCloudinaryUrl(displayImg, 1200);
---

<div 
  class={`teacher-card flex-shrink-0 w-full sm:w-[calc(50%-1rem)] lg:w-[calc(33.333%-2rem)] group cursor-pointer opacity-0 translate-y-12 ${offset ? 'is-offset sm:translate-y-8 lg:translate-y-8' : ''}`} 
  data-animate-scroll 
  data-index={index} 
  data-name={name} 
  data-subjects={subjects} 
  data-img={modalImg}
>
  <div class="image-container relative mb-4 overflow-hidden rounded-xl bg-gray-200 shadow-[0_20px_40px_-20px_rgba(24,63,137,0.12)]">
    <img 
      src={optimizedImg} 
      alt={name} 
      width="600"
      height="800"
      transition:name={`teacher-photo-${index}`} 
      class="teacher-photo w-full aspect-[3/4] object-cover group-hover:scale-105 transition-all duration-700" 
      loading="lazy" 
      decoding="async"
      onload="this.classList.add('loaded'); this.parentElement.classList.add('is-loaded')"
    />
    <div class="absolute inset-0 bg-[#183f89]/10 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-xl pointer-events-none"></div>
  </div>
  
  <!-- Content Details -->
  <div class="px-1 text-center">
    <div class="text-[22px] md:text-2xl font-sans font-bold text-[#183f89] mb-1" transition:name={`teacher-name-${index}`}>
      <BlockReveal blockColor="#183f89" text={name} />
    </div>
    <div class="text-sm md:text-[15px] font-sans text-[#3557a2] font-medium" transition:name={`teacher-subjects-${index}`}>
      <BlockReveal blockColor="#183f89" text={subjects} />
    </div>
  </div>
</div>

<style>
  /* Skeleton Shimmer Animation */
  .image-container {
    background: #f6f7f8;
    background-image: linear-gradient(
      to right,
      #f6f7f8 0%,
      #edeef1 20%,
      #f6f7f8 40%,
      #f6f7f8 100%
    );
    background-repeat: no-repeat;
    background-size: 800px 100%;
    animation: shimmer 1.5s infinite linear;
  }

  @keyframes shimmer {
    0% {
      background-position: -468px 0;
    }
    100% {
      background-position: 468px 0;
    }
  }

  /* Image fade-in effect */
  .teacher-photo {
    opacity: 0;
    transition: opacity 0.5s ease-in-out, transform 0.7s ease-in-out !important;
  }

  .teacher-photo.loaded {
    opacity: 1;
  }

  /* Stop shimmer when loaded */
  .image-container.is-loaded {
    animation: none;
    background: transparent;
  }
</style>
