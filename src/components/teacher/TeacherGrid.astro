---
import { getCollection } from 'astro:content';
import TeacherCard from './TeacherCard.astro';

const allTeachers = await getCollection('teachers');
const sortedTeachers = allTeachers.sort((a, b) => a.data.name.localeCompare(b.data.name));

const teachersData = sortedTeachers.map((t, i) => ({
  name: t.data.name,
  subjects: t.data.subjects,
  photo: t.data.photo,
  index: i
}));
---

<section class="max-w-screen-xl mx-auto px-8 pt-32 mb-48 text-secondary" id="teacher-grid" transition:name="teacher-grid-section">
  <!-- Faculty Header -->
  <div class="mb-16">
    <h3 class="text-3xl font-sans font-bold text-[#183f89] mb-2 tracking-tight">Our Beloved Teachers</h3>
    <div class="h-1 w-24 bg-[#183f89] rounded-full"></div>
  </div>

  <!-- Flexbox Layout -->
  <div class="teacher-grid-container flex flex-wrap justify-center md:justify-start gap-x-8 gap-y-16 lg:gap-x-12 lg:gap-y-24">
    {teachersData.map((teacher, index) => (
      <TeacherCard 
        name={teacher.name} 
        subjects={teacher.subjects} 
        photo={teacher.photo}
        index={teacher.index} 
        offset={index % 2 !== 0} 
      />
    ))}
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const initGrid = () => {
    gsap.registerPlugin(ScrollTrigger);
    const cards = document.querySelectorAll('[data-animate-scroll]');
    if (cards.length === 0) return;
    
    // 1. Click Event Listeners
    cards.forEach(card => {
      card.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('openTeacherModal', {
          detail: { 
            name: card.getAttribute('data-name'), 
            subjects: card.getAttribute('data-subjects'), 
            image: card.getAttribute('data-img') 
          }
        }));
      });
    });

    // 2. Optimized Batch Animation (Rule 05a)
    // Batching ensures triggers are calculated efficiently for large grids
    ScrollTrigger.batch(cards, {
      onEnter: (batch) => {
        gsap.to(batch, {
          opacity: 1,
          y: (i, target) => {
            // Check if element has 'is-offset' class for secondary parallax feel
            return (target as HTMLElement).classList.contains('is-offset') ? 32 : 0;
          },
          duration: 1,
          ease: "power3.out",
          stagger: {
            each: 0.1,
            grid: "auto",
            from: "start"
          },
          overwrite: "auto"
        });
      },
      // Animasi mulai ketika 85% layar
      start: "top 85%",
      // Only animate once for better performance on long grids
      once: true
    });

    // 3. Robust Refresh with ResizeObserver (Rule 05a)
    // This handles dynamic height changes as 56 cards render or images load
    const gridContainer = document.querySelector('.teacher-grid-container');
    if (gridContainer) {
      let resizeTimeout: any;
      const observer = new ResizeObserver(() => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          ScrollTrigger.refresh();
        }, 200);
      });
      observer.observe(gridContainer);
      
      // Cleanup observer on swap
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    }

    // Initial refresh
    ScrollTrigger.refresh();
  };

  document.addEventListener('astro:page-load', () => {
    if(document.querySelector("#teacher-grid")) {
      initGrid();
    }
  });

  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach(t => t.kill());
  });
</script>
