<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const initGrid = () => {
    gsap.registerPlugin(ScrollTrigger);
    const cards = document.querySelectorAll('[data-animate-scroll]');
    if (cards.length === 0) return;
    
    // 1. Click Event Listeners
    cards.forEach(card => {
      card.addEventListener('click', () => {
        window.dispatchEvent(new CustomEvent('openTeacherModal', {
          detail: { 
            name: card.getAttribute('data-name'), 
            subjects: card.getAttribute('data-subjects'), 
            image: card.getAttribute('data-img') 
          }
        }));
      });
    });

    // 2. Optimized Batch Animation (Rule 05a)
    // Batching ensures triggers are calculated efficiently for large grids
    ScrollTrigger.batch(cards, {
      onEnter: (batch) => {
        gsap.to(batch, {
          opacity: 1,
          y: (i, target) => {
            // Check if element has 'is-offset' class for secondary parallax feel
            return (target as HTMLElement).classList.contains('is-offset') ? 32 : 0;
          },
          duration: 1,
          ease: "power3.out",
          stagger: {
            each: 0.1,
            grid: "auto",
            from: "start"
          },
          overwrite: "auto"
        });
      },
      // Animasi mulai ketika 85% layar
      start: "top 85%",
      // Only animate once for better performance on long grids
      once: true
    });

    // 3. Robust Refresh with ResizeObserver (Rule 05a)
    // This handles dynamic height changes as 56 cards render or images load
    const gridContainer = document.querySelector('.teacher-grid-container');
    if (gridContainer) {
      let resizeTimeout: any;
      const observer = new ResizeObserver(() => {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          ScrollTrigger.refresh();
        }, 200);
      });
      observer.observe(gridContainer);
      
      // Cleanup observer on swap
      document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    }

    // Initial refresh
    ScrollTrigger.refresh();
  };

  document.addEventListener('astro:page-load', () => {
    if(document.querySelector("#teacher-grid")) {
      initGrid();
    }
  });

  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach(t => t.kill());
  });
</script>
