---
/**
 * TeacherCTA.astro
 * Seksi penutup untuk halaman Teacher yang mengajak user menjelajahi kelas pertama.
 */
---

<section class="teacher-cta py-32 px-6 bg-[#f5f0ea] relative overflow-hidden">
  <div class="max-w-4xl mx-auto text-center relative z-10">
    <div class="cta-label opacity-0 translate-y-10 mb-6">
      <p class="text-[#2A358F]/40 text-sm tracking-[0.4em] uppercase">
        The Journey Continues
      </p>
    </div>
    
    <h2 class="cta-title opacity-0 translate-y-10 text-4xl md:text-6xl font-bold text-[#2A358F] mb-10 leading-tight">
      Setiap ilmu yang mereka titipkan, kini menjadi kisah abadi di setiap ruang kelas
    </h2>

    <div class="cta-button-wrapper opacity-0 translate-y-10">
      <a 
        href="/classes/xii-a-pplg" 
        class="group inline-flex items-center gap-4 bg-[#2A358F] text-white px-10 py-5 rounded-full hover:bg-[#2A358F]/90 transition-all duration-500 shadow-xl hover:shadow-2xl hover:scale-105 active:scale-95"
      >
        <span class="text-lg font-medium tracking-wider">XII A PPLG</span>
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="24" 
          height="24" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2" 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          class="group-hover:translate-x-2 transition-transform duration-300"
        >
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <div class="cta-subtext opacity-0 mt-12">
      <p class="text-gray-400 text-sm italic">
        "Setiap guru adalah jembatan menuju masa depan yang cerah."
      </p>
    </div>
  </div>

  <!-- Decorative Elements -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[150%] aspect-square -z-0 opacity-[0.03] pointer-events-none">
    <div class="w-full h-full border-[1px] border-[#2A358F] rounded-full animate-ping-slow"></div>
  </div>
</section>

<style>
  .animate-ping-slow {
    animation: ping-slow 10s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes ping-slow {
    75%, 100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { waitForLoading } from '../../utils/loadingState';

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', async () => {
    await waitForLoading();

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '.teacher-cta',
        start: 'top 80%',
        once: true
      }
    });

    tl.to('.cta-label', { opacity: 1, y: 0, duration: 1, ease: 'power4.out' })
      .to('.cta-title', { opacity: 1, y: 0, duration: 1, ease: 'power4.out' }, '-=0.7')
      .to('.cta-button-wrapper', { opacity: 1, y: 0, duration: 1, ease: 'back.out(1.7)' }, '-=0.7')
      .to('.cta-subtext', { opacity: 1, duration: 1.5, ease: 'power2.out' }, '-=0.5');
  });
</script>
