---
// Floating Header with Advanced Animations
// FIXED: Compatible dengan Astro View Transitions lifecycle events

// Get current path untuk active state
const currentPath = Astro.url.pathname;

// Navigation items
const navItems = [
  { href: "/", label: "Home", icon: "🏠" },
  { href: "/about-altie", label: "Altie History", icon: "📖" },
  { href: "/teachers", label: "Teachers", icon: "👨‍🏫" },
  { href: "/classes", label: "Classes", icon: "👥" },
  { href: "/gallery", label: "Gallery", icon: "🖼️" },
  { href: "/yearbook-committee", label: "Yearbook Committee", icon: "ℹ️" },
];

// Helper function untuk check active link
function isActive(href: string, currentPath: string): boolean {
  if (href === "/") {
    return currentPath === "/";
  }
  return currentPath.startsWith(href);
}
---

<!-- Floating Header Container -->
<div id="floating-header" class="fixed top-4 right-4 z-50">
  <!-- Logo Button (Floating) -->
  <button
    id="logo-button"
    class="group relative flex items-center justify-center
           w-14 h-14 backdrop-blur-md rounded-full
           shadow-lg border border-white/20
           opacity-0 scale-0 transform transition-all duration-500 ease-out
           hover:shadow-xl hover:scale-110
           focus:outline-none focus:ring-2 focus:ring-white/20 focus:ring-offset-2"
    aria-label="Toggle navigation menu"
  >
    <!-- Logo SVG -->
    <div
      class="w-8 h-8 bg-[url('/src/assets/azzarqo.svg')] bg-contain bg-center bg-no-repeat"
    >
    </div>

    <!-- Pulse effect on hover -->
    <div
      class="absolute inset-0 rounded-full bg-white/20 scale-0 group-hover:scale-100 transition-transform duration-300"
    >
    </div>
  </button>

  <!-- Desktop Navigation Menu (Toggle from logo click) -->
  <nav
    id="desktop-nav"
    class="hidden max-w-screen md:flex absolute right-16 top-0 items-center overflow-auto
           bg-white/35 backdrop-blur-md rounded-2xl shadow-xl border border-white/20
           opacity-0 translate-x-[-20px] pointer-events-none
           transition-all duration-300 ease-out px-6 py-3"
  >
    <!-- Navigation Items in one background -->
    <div class="flex items-center gap-4">
      {
        navItems.map((item, index) => (
          <a
            href={item.href}
            class={`flex items-center gap-2 px-3 py-2 rounded-lg font-medium
                   transition-all duration-200 transform
                   ${
                     isActive(item.href, currentPath)
                       ? "bg-primary-500 text-white shadow-md scale-105"
                       : "text-gray-700 hover:bg-gray-100 hover:scale-105"
                   }`}
            style={`animation-delay: ${index * 50}ms;`}
            aria-current={isActive(item.href, currentPath) ? "page" : undefined}
          >
            <span class="text-sm">{item.icon}</span>
            <span>{item.label}</span>
          </a>
        ))
      }

      <!-- CTA Button -->
      <a
        href="/contact"
        class="ml-2 px-4 py-2 bg-primary text-white rounded-lg font-medium
               hover:bg-primary-600 hover:shadow-lg transform hover:scale-105
               transition-all duration-200"
      >
        Contact
      </a>
    </div>
  </nav>

  <!-- Mobile Navigation Pills (Floating) -->
  <div
    id="mobile-nav"
    class="hidden absolute right-4 top-20 flex flex-col gap-3
           opacity-0 translate-y-[-20px] pointer-events-none
           transition-all duration-300 ease-out"
  >
    {
      navItems.map((item, index) => (
        <a
          href={item.href}
          class={`flex items-center gap-3 px-4 py-3 rounded-2xl font-medium
                 transition-all duration-200 transform hover:scale-105 shadow-lg
                 ${
                   isActive(item.href, currentPath)
                     ? "bg-primary-500 text-white"
                     : "bg-white/95 backdrop-blur-md text-gray-700 border border-white/20"
                 }`}
          style={`animation-delay: ${index * 50}ms;`}
          aria-current={isActive(item.href, currentPath) ? "page" : undefined}
        >
          <span class="text-lg">{item.icon}</span>
          <span>{item.label}</span>
          {isActive(item.href, currentPath) && (
            <div class="ml-auto w-2 h-2 bg-white rounded-full" />
          )}
        </a>
      ))
    }

    <!-- CTA Button -->
    <a
      href="/contact"
      class="flex items-center justify-center px-4 py-3 rounded-2xl
             bg-primary-500 text-white font-medium shadow-lg
             hover:bg-primary-600 hover:shadow-xl transform hover:scale-105
             transition-all duration-200"
    >
      📞 Contact Us
    </a>
  </div>

  <!-- Mobile Overlay -->
  <div id="mobile-overlay" class="hidden fixed inset-0 backdrop-blur-sm -z-10">
  </div>
</div>

<script>
  // =================================================================
  // PENTING: Fungsi initHeader membungkus SEMUA logika navigasi.
  //
  // Kenapa dibungkus dalam fungsi?
  // - Dengan Astro View Transitions, halaman tidak di-reload sepenuhnya
  //   saat navigasi. DOM di-swap sebagian oleh Astro.
  // - Event 'DOMContentLoaded' hanya terpanggil SEKALI saat pertama load.
  // - Kita perlu me-reinisialisasi event listeners setiap kali Astro
  //   selesai mengganti konten halaman.
  // - Solusi: bungkus dalam fungsi, lalu panggil via dua event:
  //     1. 'astro:page-load'  → terpanggil setiap kali halaman selesai dimuat
  //     2. 'DOMContentLoaded' → fallback jika View Transitions tidak aktif
  // =================================================================

  function initHeader() {
    // --- Ambil elemen dari DOM ---
    const logoButton = document.getElementById("logo-button");
    const desktopNav = document.getElementById("desktop-nav");
    const mobileNav = document.getElementById("mobile-nav");
    const mobileOverlay = document.getElementById("mobile-overlay");

    // Guard: jika elemen tidak ditemukan, hentikan eksekusi
    // (bisa terjadi jika komponen ini tidak ada di halaman tertentu)
    if (!logoButton || !desktopNav || !mobileNav || !mobileOverlay) return;

    // --- State internal ---
    let isLogoVisible = false;
    let isDesktopNavVisible = false;
    let isDesktopNavHovered = false;
    let isMobileNavVisible = false;

    // =================================================================
    // PENTING: Bersihkan event listener lama sebelum menambahkan yang baru.
    //
    // Kenapa perlu dibersihkan?
    // - Setiap kali 'astro:page-load' terpanggil, initHeader() dijalankan.
    // - Tanpa cleanup, event listener akan menumpuk (double, triple, dst).
    // - Cara termudah: kloning elemen untuk menghapus semua listener lama.
    //   cloneNode(true) menyalin elemen beserta child-nya tapi TANPA listeners.
    // =================================================================
    const cleanLogoButton = logoButton.cloneNode(true) as HTMLButtonElement;
    logoButton.parentNode?.replaceChild(cleanLogoButton, logoButton);

    // Gunakan referensi baru setelah kloning
    const btn = cleanLogoButton;

    // =================================================================
    // PENTING: Cleanup scroll listener dari sesi sebelumnya.
    //
    // Karena kita tidak bisa removeEventListener tanpa referensi fungsi aslinya,
    // kita simpan referensi fungsi di properti elemen window menggunakan
    // custom property. Sebelum menambahkan listener baru, hapus yang lama.
    // =================================================================
    if ((window as any)._headerScrollHandler) {
      window.removeEventListener("scroll", (window as any)._headerScrollHandler);
    }
    if ((window as any)._headerKeydownHandler) {
      document.removeEventListener("keydown", (window as any)._headerKeydownHandler);
    }
    if ((window as any)._headerClickHandler) {
      document.removeEventListener("click", (window as any)._headerClickHandler);
    }
    if ((window as any)._headerResizeHandler) {
      window.removeEventListener("resize", (window as any)._headerResizeHandler);
    }

    // ========================
    // FUNGSI-FUNGSI HELPER
    // ========================

    // Tampilkan/sembunyikan logo saat scroll
    const handleScroll = () => {
      const shouldShowLogo = window.scrollY > 100;

      if (shouldShowLogo !== isLogoVisible) {
        isLogoVisible = shouldShowLogo;
        if (shouldShowLogo) {
          btn.classList.remove("opacity-0", "scale-0");
          btn.classList.add("opacity-100", "scale-100");
        } else {
          btn.classList.remove("opacity-100", "scale-100");
          btn.classList.add("opacity-0", "scale-0");
        }
      }
    };

    // Toggle desktop navigation (untuk klik)
    const toggleDesktopNav = () => {
      if (window.innerWidth < 768) return;

      isDesktopNavVisible = !isDesktopNavVisible;

      if (isDesktopNavVisible) {
        desktopNav.classList.remove(
          "hidden", "opacity-0", "translate-x-[-20px]", "pointer-events-none"
        );
        desktopNav.classList.add("opacity-100", "translate-x-0", "pointer-events-auto");
      } else {
        desktopNav.classList.remove("opacity-100", "translate-x-0", "pointer-events-auto");
        desktopNav.classList.add(
          "opacity-0", "translate-x-[-20px]", "pointer-events-none"
        );
        btn.blur();
      }
    };

    // Toggle mobile navigation
    const toggleMobileNav = () => {
      if (window.innerWidth >= 768) return;

      isMobileNavVisible = !isMobileNavVisible;

      if (isMobileNavVisible) {
        mobileNav.classList.remove(
          "hidden", "opacity-0", "translate-y-[-20px]", "pointer-events-none"
        );
        mobileNav.classList.add("opacity-100", "translate-y-0", "pointer-events-auto");
        mobileOverlay.classList.remove("hidden");
      } else {
        mobileNav.classList.remove("opacity-100", "translate-y-0", "pointer-events-auto");
        mobileNav.classList.add(
          "opacity-0", "translate-y-[-20px]", "pointer-events-none"
        );
        mobileOverlay.classList.add("hidden");
        btn.blur();
        document.body.style.overflow = "";
      }
    };

    // Tampilkan desktop nav saat hover (sebelum diklik)
    const showDesktopNavOnHover = () => {
      if (window.innerWidth < 768 || isDesktopNavVisible) return;
      isDesktopNavHovered = true;
      desktopNav.classList.remove(
        "hidden", "opacity-0", "translate-x-[-20px]", "pointer-events-none"
      );
      desktopNav.classList.add("opacity-100", "translate-x-0", "pointer-events-auto");
    };

    // Sembunyikan desktop nav saat mouse pergi (jika belum diklik/persistent)
    const hideDesktopNavOnLeave = () => {
      if (window.innerWidth < 768 || isDesktopNavVisible) return;
      setTimeout(() => {
        if (!desktopNav.matches(":hover") && isDesktopNavHovered) {
          isDesktopNavHovered = false;
          desktopNav.classList.remove("opacity-100", "translate-x-0", "pointer-events-auto");
          desktopNav.classList.add(
            "opacity-0", "translate-x-[-20px]", "pointer-events-none"
          );
        }
      }, 100);
    };

    // ========================
    // DAFTARKAN EVENT LISTENERS
    // ========================

    // Hover behavior pada logo (desktop only)
    btn.addEventListener("mouseenter", showDesktopNavOnHover);
    btn.addEventListener("mouseleave", hideDesktopNavOnLeave);

    // Klik logo: buka/tutup nav sesuai viewport
    btn.addEventListener("click", () => {
      if (window.innerWidth >= 768) {
        toggleDesktopNav();
      } else {
        toggleMobileNav();
      }
    });

    // Klik overlay untuk menutup mobile nav
    mobileOverlay.addEventListener("click", toggleMobileNav);

    // Tutup dengan tombol Escape
    const handleKeydown = (event: KeyboardEvent) => {
      if (event.key === "Escape") {
        if (isDesktopNavVisible) toggleDesktopNav();
        if (isMobileNavVisible) toggleMobileNav();
      }
    };

    // Tutup mobile nav saat resize ke desktop
    const handleResize = () => {
      if (window.innerWidth >= 768 && isMobileNavVisible) {
        toggleMobileNav();
      }
    };

    // Tutup nav saat klik di luar area header
    const handleClickOutside = (event: MouseEvent) => {
      if (!isDesktopNavVisible && !isMobileNavVisible) return;

      const target = event.target as Element;
      const isInsideBtn = btn.contains(target);
      const isInsideMobileNav = mobileNav.contains(target);

      if (!isInsideBtn && !isInsideMobileNav) {
        if (isDesktopNavVisible) toggleDesktopNav();
        if (isMobileNavVisible) toggleMobileNav();
      }
    };

    document.addEventListener("keydown", handleKeydown);
    document.addEventListener("click", handleClickOutside);
    window.addEventListener("resize", handleResize);
    window.addEventListener("scroll", handleScroll, { passive: true });

    // Simpan referensi agar bisa di-cleanup pada sesi berikutnya
    (window as any)._headerScrollHandler = handleScroll;
    (window as any)._headerKeydownHandler = handleKeydown;
    (window as any)._headerClickHandler = handleClickOutside;
    (window as any)._headerResizeHandler = handleResize;
  }

  // =================================================================
  // TITIK MASUK UTAMA
  //
  // Kita mendengarkan DUA event:
  //
  // 1. 'astro:page-load'
  //    → Event khusus Astro yang terpanggil setiap kali halaman selesai
  //      dimuat, baik saat pertama kali maupun setelah navigasi
  //      View Transitions. INI adalah cara yang benar untuk Astro.
  //
  // 2. 'DOMContentLoaded'
  //    → Fallback standar browser. Terpanggil saat pertama load jika
  //      View Transitions belum aktif atau script dimuat sebelum
  //      'astro:page-load' sempat terdaftar.
  //
  // Dengan mendaftar keduanya, kode ini aman di semua kondisi.
  // =================================================================
  document.addEventListener("astro:page-load", initHeader);
  document.addEventListener("DOMContentLoaded", initHeader);
</script>

<style>
  #floating-header {
    will-change: transform;
  }

  #desktop-nav a {
    animation: slideInRight 0.3s ease-out both;
  }

  #mobile-nav a {
    animation: slideInUp 0.3s ease-out both;
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>