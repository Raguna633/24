---
// src/components/ParallaxStack.astro
---

<div data-parallax-stack class="parallax-stack-container">
  <slot />
</div>

<style>
  .parallax-stack-container {
    position: relative;
    overflow: hidden;
    height: 100vh;
    width: 100%;
  }

  /* Optimized: Static layout in CSS prevents layout thrashing during JS init */
  .parallax-stack-container > :global(*) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    /* GPU Layering hint */
    will-change: transform, opacity;
  }
</style>

<script>
  import gsap from "gsap";
  import { CSSPlugin } from "gsap/CSSPlugin";
  import { waitForLoading } from "../utils/loadingState";

  const EXIT_PRESETS: Record<string, gsap.TweenVars> = {
    down: {
      y: () => window.innerHeight * 1.1,
      autoAlpha: 0,
      ease: "power2.inOut",
    },
    up: {
      y: () => window.innerHeight * -1.1,
      autoAlpha: 0,
      ease: "power2.inOut",
    },
    left: {
      x: () => window.innerWidth * -1.1,
      autoAlpha: 0,
      ease: "power2.inOut",
    },
    right: {
      x: () => window.innerWidth * 1.1,
      autoAlpha: 0,
      ease: "power2.inOut",
    },
    fade: {
      autoAlpha: 0,
      ease: "power1.inOut",
    },
    scale: {
      scale: 0.8,
      autoAlpha: 0,
      ease: "power2.inOut",
    },
    "diagonal-up-left": {
      x: () => window.innerWidth * -0.4,
      y: () => window.innerHeight * -0.5,
      scale: 1.3,
      autoAlpha: 0,
      ease: "power2.inOut",
    },
    "diagonal-down-right": {
      x: () => window.innerWidth * 0.4,
      y: () => window.innerHeight * 0.5,
      scale: 1.3,
      autoAlpha: 0,
      ease: "power2.inOut",
    },
  };

  async function initParallaxStack() {
    gsap.registerPlugin(CSSPlugin);

    const stacks = document.querySelectorAll("[data-parallax-stack]");
    const isMobile = window.innerWidth < 768;

    // Phase 1: Immediate Stacking Order (Prevent FOUC/Sequence Flash)
    stacks.forEach((stack) => {
      const sections = Array.from(stack.children) as HTMLElement[];
      sections.forEach((section, index) => {
        section.style.zIndex = String(sections.length - index);
      });
    });

    // Phase 2: Wait for Loading to start GSAP setup
    await waitForLoading();

    stacks.forEach(async (stack) => {
      const stackEl = stack as HTMLElement;
      const sections = Array.from(stackEl.children) as HTMLElement[];
      if (sections.length < 2) return;

      // Mobile check: reduce scroll distance on mobile to save CPU/Battery
      // Lower duration = faster transitions = less time spending CPU on interpolation
      const duration = isMobile ? window.innerHeight * 1.2 : window.innerHeight * 1.5;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: stackEl,
          scrub: isMobile ? 0.5 : 1, // Faster scrub response on mobile
          start: "top top",
          end: `+=${sections.length * duration}`,
          pin: true,
          anticipatePin: 1,
          invalidateOnRefresh: true, // Crucial for responsive resizing
        },
      });

      // Phase 3: Content Animation Sync (Unified Timeline)
      // We use a for...of loop to ensure sequential timeline construction
      for (const [index, section] of sections.entries()) {
        if (index === sections.length - 1) continue;

        const exitDirection = (section as HTMLElement).dataset.exit ?? "fade";
        const exitVars = EXIT_PRESETS[exitDirection] ?? EXIT_PRESETS.fade;

        // --- SPECIFIC SECTION LOGIC ---
        
        // 1. HERO SECTION (Index 0) & ABOUT SECTION (Index 1) SYNC
        if (index === 0) {
          // Robust retrieval: wait for promises to be defined if they are late
          let hPromise = (window as any).heroSectionPromise;
          let aPromise = (window as any).aboutSectionPromise;
          
          for (let i = 0; i < 20 && (!hPromise || !aPromise); i++) {
            await new Promise(r => setTimeout(r, 10));
            hPromise = hPromise || (window as any).heroSectionPromise;
            aPromise = aPromise || (window as any).aboutSectionPromise;
          }

          const heroData = await hPromise;
          const aboutData = await aPromise;
          
          if (heroData?.txtAngkatan && heroData?.svg) {
            tl.to(heroData.txtAngkatan, { 
              opacity: 0, 
              filter: "blur(10px)", 
              y: -30, 
              duration: 0.5 
            }, 0);
            
            tl.to(heroData.svg, { 
              scale: 0.85, 
              opacity: 0, 
              rotation: -3, 
              duration: 0.8 
            }, 0);
          }

          if (aboutData?.allElements && aboutData?.allElements.length > 0) {
             tl.to(aboutData.allElements, {
                y: 0,
                opacity: 1,
                rotationX: 0,
                filter: "blur(0px)",
                stagger: 0.08,
                duration: 0.8,
                ease: "power2.out"
             }, ">-0.4");
             
             if (aboutData.sectionBg) {
                tl.to(aboutData.sectionBg, {
                  scale: 1.15,
                  duration: 1.2
                }, "<");
             }
          }
        }

        // General Exit for non-special or fallback
        tl.to(
          section,
          {
            ...exitVars,
            duration: 1,
            force3D: true,
          },
          index === 0 ? "<+0.2" : ">",
        );
      }

      // Buffer space at the end to prevent immediate unpin jump
      tl.set({}, {}, "+=0.4");
    });
  }

  document.addEventListener("astro:page-load", () => {
    initParallaxStack();
  });
</script>
