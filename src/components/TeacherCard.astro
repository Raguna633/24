---
// src/components/ui/TeacherCard.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  subject?: string;
  photo: ImageMetadata;
  message?: string;
}

const { name, role, subject, photo, message } = Astro.props;
---

<article class="card group">
  <div class="relative">
    <!-- Image -->
    <div class="aspect-photo overflow-hidden bg-gray-200">
      <Image
        src={photo}
        alt={`Photo of ${name}`}
        class="w-full h-full object-cover"
        widths={[300, 600]}
        sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
        format="webp"
        quality={85}
        loading="lazy"
      />
    </div>
    
    <!-- Message overlay (shown on hover) -->
    {message && (
      <div class="absolute inset-0 bg-primary-900/95 p-6 
                  flex flex-col justify-center
                  opacity-0 group-hover:opacity-100 
                  transition-opacity duration-300">
        <div class="relative">
          <!-- Quote icon -->
          <svg 
            class="w-8 h-8 text-primary-300 mb-3" 
            fill="currentColor" 
            viewBox="0 0 24 24"
          >
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
          </svg>
          
          <!-- Message text -->
          <p class="text-white text-sm leading-relaxed italic">
            {message}
          </p>
          
          <!-- Decoration line -->
          <div class="mt-4 w-12 h-1 bg-accent-400 rounded-full"></div>
        </div>
      </div>
    )}
  </div>
  
  <!-- Content -->
  <div class="p-4 text-center">
    <!-- Name -->
    <h3 class="font-heading font-bold text-lg text-gray-900 mb-1">
      {name}
    </h3>
    
    <!-- Role -->
    <p class="text-sm text-primary-600 font-medium mb-1">
      {role}
    </p>
    
    <!-- Subject -->
    {subject && (
      <p class="text-sm text-gray-600">
        {subject}
      </p>
    )}
    
    <!-- Hover hint (only if there's a message) -->
    {message && (
      <p class="text-xs text-gray-400 mt-3 opacity-0 
                group-hover:opacity-100 transition-opacity">
        Hover to read message
      </p>
    )}
  </div>
</article>