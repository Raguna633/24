---
// src/components/HorizontalScrollCarousel.astro
//
// Komponen pengganti Swiper Carousel berbasis GSAP ScrollTrigger.
// Memungkinkan navigasi horizontal antar section HANYA lewat scroll vertikal.
//

interface Props {
    // Opsional: judul atau label carousel
    id?: string;
}

const { id = "horizontal-carousel" } = Astro.props;
---

<div
    class="horizontal-scroll-container bg-[rgb(var(--color-primary))] overflow-hidden section-reveal"
    id={id}
>
    <div
        class="horizontal-scroll-wrapper relative h-screen w-screen overflow-hidden"
    >
        <slot />
    </div>
</div>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { waitForLoading } from "../utils/loadingState";

    async function initHorizontalCarousels() {
        // 🛡️ Safety timeout for loading state
        const loadingPromise = waitForLoading();
        const timeoutPromise = new Promise((resolve) => setTimeout(resolve, 2500));
        await Promise.race([loadingPromise, timeoutPromise]);

        // 🚀 Critical: Register plugin
        gsap.registerPlugin(ScrollTrigger);

        const carousels = document.querySelectorAll(
            ".horizontal-scroll-container",
        );

        carousels.forEach((container, i) => {
            const wrapper = container.querySelector(
                ".horizontal-scroll-wrapper",
            ) as HTMLElement;
            if (!wrapper) return;

            const slides = Array.from(wrapper.children) as HTMLElement[];
            if (slides.length <= 1) return;

            const carouselId = container.id || `carousel-${i}`;

            // Set each slide to exactly viewport width/height and stack them
            slides.forEach((slide, j) => {
                slide.style.position = "absolute";
                slide.style.top = "0";
                slide.style.left = "0";
                slide.style.width = "100vw";
                slide.style.height = "100vh";
                slide.style.zIndex = String(slides.length - j);

                // Start second slide onwards offscreen to the right
                if (j > 0) {
                    gsap.set(slide, { xPercent: 100 });
                }

                // Prepare text elements inside slides
                const textContents = slide.querySelectorAll(
                    ".greeting-text-content",
                );
                textContents.forEach((txt) => {
                    (txt as HTMLElement).style.overflowY = "hidden";
                    (txt as HTMLElement).scrollTop = 0;
                });

                // Ensure hint is visible initially if overflow exists
                const hints = slide.querySelectorAll(".scroll-hint");
                hints.forEach((hint) => {
                    const txt = slide.querySelector(
                        ".greeting-text-content",
                    ) as HTMLElement;
                    if (txt && txt.scrollHeight > txt.clientHeight) {
                        (hint as HTMLElement).style.display = "flex";
                        (hint as HTMLElement).style.opacity = "1";
                    } else {
                        (hint as HTMLElement).style.display = "none";
                    }
                });
            });

            // Calculate dynamic scroll distance
            const getScrollDist = () => {
                let dist = (slides.length - 1) * window.innerWidth;

                slides.forEach((slide) => {
                    const txt = slide.querySelector(
                        ".greeting-text-content",
                    ) as HTMLElement;
                    if (txt) {
                        const overflow = Math.max(
                            0,
                            txt.scrollHeight - txt.clientHeight,
                        );
                        // Multiply by 3 to make text scrolling slower and easier to read
                        dist += overflow * 1.5;
                    }
                });

                return dist;
            };

            const tl = gsap.timeline({
                scrollTrigger: {
                    id: `h-carousel-${carouselId}`,
                    trigger: container,
                    start: "top top",
                    end: () => `+=${getScrollDist()}`,
                    pin: true,
                    scrub: 0.1,
                    anticipatePin: 1,
                    fastScrollEnd: true,
                    invalidateOnRefresh: true,
                },
            });

            slides.forEach((slide, k) => {
                // 1. Enter the new slide and push back the previous one
                if (k > 0) {
                    const slideLabel = `slideEnter-${k}`;
                    tl.addLabel(slideLabel);

                    // Bring current slide in from right
                    tl.to(
                        slide,
                        {
                            xPercent: 0,
                            ease: "none",
                            duration: () => window.innerWidth,
                            force3D: true,
                        },
                        slideLabel,
                    );

                    // Push the immediately preceding slide back
                    tl.to(
                        slides[k - 1],
                        {
                            scale: 0.92,
                            opacity: 0,
                            ease: "none",
                            duration: () => window.innerWidth,
                            force3D: true,
                        },
                        slideLabel,
                    );
                }

                // 2. Scroll the text vertically while paused horizontally
                const txt = slide.querySelector(
                    ".greeting-text-content",
                ) as HTMLElement;
                const hint = slide.querySelector(".scroll-hint") as HTMLElement;

                if (txt && txt.scrollHeight > txt.clientHeight) {
                    const scrollAmount = txt.scrollHeight - txt.clientHeight;
                    const durationVal = Math.max(1, scrollAmount * 3);

                    const syncLabel = `scrollSlide-${k}`;
                    tl.to(
                        txt,
                        {
                            scrollTop: scrollAmount,
                            ease: "none",
                            duration: durationVal,
                        },
                        syncLabel,
                    );

                    if (hint) {
                        tl.to(
                            hint,
                            {
                                opacity: 0,
                                ease: "power1.inOut",
                                duration: durationVal * 0.8,
                            },
                            syncLabel,
                        );
                    }
                }
            });
        });
    }

    // Initialize on page load
    document.addEventListener("astro:page-load", () => {
        // ⏳ Add small delay to ensure internal GreetingSection layout is calculated
        // after potential layout shifts or font loading.
        setTimeout(initHorizontalCarousels, 100);
    });

    // 🧹 Cleanup
    document.addEventListener("astro:before-swap", () => {
        ScrollTrigger.getAll().forEach(st => {
            if (st.vars.id?.startsWith("h-carousel-")) {
                st.kill();
            }
        });
    }, { once: true });
</script>

<style>
    .horizontal-scroll-container {
        position: relative;
        z-index: 10; /* Lower than Header (z-50) */
        width: 100vw;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .horizontal-scroll-container::-webkit-scrollbar {
        display: none;
    }
</style>
