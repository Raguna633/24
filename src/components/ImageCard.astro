---
// ImageCard.astro - Reusable Image Grid Component (Flexbox Version)
// Supports flexible layouts with elegant centering for premium storytelling

import { Image } from "astro:assets";
import CloudinaryImage from "./ui/CloudinaryImage.astro";
import type { ImageMetadata } from "astro";
import BlockReveal from "./BlockReveal.astro"

interface ImageData {
  id?: string;
  img: ImageMetadata | string;
  alt: string;
  title?: string;
}

interface Props {
  images: ImageData[];
  gridCols?: number; // Kept for API compatibility, used as basis
  imageWidth?: number;
  imageHeight?: number;
  gap?: string;
  className?: string;
}

const {
  images,
  gridCols = 4,
  imageWidth = 480,
  imageHeight = 480,
  gap = "gap-y-12 gap-x-6",
  className = "",
} = Astro.props;

// Determine dynamic width classes based on gridCols
// We use basis-[calc(...)] to account for the gaps so they don't cause wrapping prematurely
// gridCols 4 (default): 2 per row on mobile (basis-[calc(50%-1rem)]), 4 per row on desktop (lg:basis-[calc(25%-1.5rem)])
const itemWidthClass = gridCols === 5 
  ? "basis-[calc(50%-1rem)] md:basis-[calc(33.333%-1rem)] lg:basis-[calc(20%-1.25rem)]" 
  : "basis-[calc(50%-1rem)] md:basis-[calc(33.333%-1rem)] lg:basis-[calc(25%-1.25rem)]";
---

<div class={`flex flex-wrap justify-center items-start ${gap} ${className}`}>
  {
    images.map((image) => (
      <div 
        class={`flex flex-col items-center justify-center scroll-animate px-2 ${itemWidthClass}`} 
        data-animate-scroll="true"
      >
        {image.id ? (
          <button 
            class="w-full text-center group appearance-none focus:outline-none cursor-pointer" 
            data-gallery-id={image.id} 
            aria-label={`View ${image.title || image.alt}`}
          >
            <div class="relative overflow-hidden rounded-lg mx-auto max-w-[240px]">
              {
                typeof image.img === "string" && image.img.includes("res.cloudinary.com") ? (
                  <CloudinaryImage
                    src={image.img}
                    alt={image.alt}
                    class="object-cover w-full aspect-photo transition-transform duration-700 ease-out group-hover:scale-110"
                    widths={[240, 480, 800]}
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={image.img as any}
                    alt={image.alt}
                    width={imageWidth}
                    height={imageHeight}
                    widths={[240, 480, 800]}
                    sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 20vw"
                    class="object-cover w-full aspect-photo transition-transform duration-700 ease-out group-hover:scale-110"
                    loading="lazy"
                    decoding="async"
                  />
                )
              }
              <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
            </div>
            
            {image.title && (
              <div class="mt-4 text-xs md:text-sm font-medium text-gray-700 transition-colors duration-300 group-hover:text-primary">
                <BlockReveal blockColor="#3557A2" text={image.title} />
              </div>
            )}
          </button>
        ) : (
          <div class="w-full text-center">
            <div class="relative overflow-hidden rounded-lg mx-auto max-w-[240px]">
              {
                typeof image.img === "string" && image.img.includes("res.cloudinary.com") ? (
                  <CloudinaryImage
                    src={image.img}
                    alt={image.alt}
                    class="object-cover w-full aspect-photo"
                    widths={[240, 480, 800]}
                    loading="lazy"
                  />
                ) : (
                  <Image
                    src={image.img as any}
                    alt={image.alt}
                    width={imageWidth}
                    height={imageHeight}
                    widths={[240, 480, 800]}
                    sizes="(max-width: 640px) 45vw, (max-width: 1024px) 30vw, 20vw"
                    class="object-cover w-full aspect-photo"
                    loading="lazy"
                    decoding="async"
                  />
                )
              }
            </div>
            {image.title && (
              <div class="mt-4 text-xs md:text-sm font-medium text-gray-700">
                <BlockReveal blockColor="#3557A2" text={image.title} />
              </div>
            )}
          </div>
        )}
      </div>
    ))
  }
</div>

<style>
  /* Ensure consistent aspect ratios for premium look (3:4) */
  .aspect-photo {
    aspect-ratio: 3 / 4;
  }
  
  /* Prevent layout jump when loading */
  .scroll-animate {
    opacity: 0;
    will-change: transform, opacity;
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { waitForLoading } from "../utils/loadingState";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", async () => {
    // Only target items specifically within ImageCards if needed, but `.scroll-animate` is fine.
    const items = document.querySelectorAll(".scroll-animate");
    if (items.length === 0) return;

    // Reset styles just in case
    gsap.set(items, { opacity: 0, y: 50 });

    // Wait for the loading overlay to finish before calculating positions
    await waitForLoading();

    ScrollTrigger.batch(items, {
      start: "top 85%",
      once: true,
      onEnter: (elements) => {
        gsap.to(elements, {
          opacity: 1,
          y: 0,
          duration: 1.2,
          stagger: 0.15,
          ease: "power3.out",
          force3D: true,
        });
      },
    });
  });
</script>
