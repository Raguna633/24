---
// ImageCard.astro - Reusable Image Grid Component
// Supports configurable grid layouts with special alignment options

import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

interface ImageData {
  img: ImageMetadata;
  alt: string;
  title?: string;
}

interface Props {
  images: ImageData[];
  gridCols?: number;
  gridRows?: number;
  lastRowAlignment?: 'center' | 'space-between' | 'normal';
  imageWidth?: number;
  imageHeight?: number;
  gap?: string;
  className?: string;
}

const {
  images,
  gridCols = 5,
  gridRows, // Now optional - will be calculated automatically
  lastRowAlignment = 'center',
  imageWidth = 480,
  imageHeight = 480,
  gap = 'gap-6',
  className = '',
} = Astro.props;

// Calculate grid layout dynamically
const calculatedGridRows = gridRows || Math.ceil(images.length / gridCols);
const totalCells = gridCols * calculatedGridRows;
const lastRowStartIndex = (calculatedGridRows - 1) * gridCols;
const lastRowImages = images.slice(lastRowStartIndex).filter(Boolean); // Get all remaining images for last row
const regularImages = images.slice(0, lastRowStartIndex);
---

<div class={`grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 ${className}`}>
  <!-- Regular grid items (first 3 rows = 15 items) -->
  {regularImages.map((image) => (
    <div class="flex flex-col items-center justify-center">
      <Image
        src={image.img}
        alt={image.alt}
        width={imageWidth}
        height={imageHeight}
        class="rounded-lg object-cover w-full max-w-[200px] aspect-square"
        loading="lazy"
      />
      {image.title && (
        <p class="text-center mt-2 text-xs md:text-sm font-medium text-gray-700">
          {image.title}
        </p>
      )}
    </div>
  ))}

  <!-- Last row with special alignment -->
  {lastRowAlignment === 'center' && lastRowImages.length > 0 && (
    <div class={`col-span-2 md:col-span-4 flex justify-center gap-4 md:gap-6 ${lastRowImages.length === 1 ? 'md:justify-center' : lastRowImages.length === 2 ? 'md:justify-center' : 'md:justify-start'}`}>
      {lastRowImages.map((image) => (
        <div class="flex flex-col items-center justify-center">
          <Image
            src={image.img}
            alt={image.alt}
            width={imageWidth}
            height={imageHeight}
            class="rounded-lg object-cover w-full max-w-[200px] aspect-square"
            loading="lazy"
          />
          {image.title && (
            <p class="text-center mt-2 text-xs md:text-sm font-medium text-gray-700">
              {image.title}
            </p>
          )}
        </div>
      ))}
    </div>
  )}

  {lastRowAlignment === 'space-between' && lastRowImages.length > 0 && (
    <div class="col-span-2 md:col-span-4 flex md:justify-between items-center justify-center gap-4 md:gap-6">
      {lastRowImages.map((image, index) => (
        <div class="flex flex-col items-center justify-center">
          <Image
            src={image.img}
            alt={image.alt}
            width={imageWidth}
            height={imageHeight}
            class="rounded-lg object-cover w-full max-w-[200px] aspect-square"
            loading="lazy"
          />
          {image.title && (
            <p class="text-center mt-2 text-xs md:text-sm font-medium text-gray-700">
              {image.title}
            </p>
          )}
        </div>
      ))}
    </div>
  )}

  {lastRowAlignment === 'normal' && lastRowImages.length > 0 && (
    <div class="col-span-2 md:col-span-4 flex flex-wrap justify-start gap-4 md:gap-6">
      {lastRowImages.map((image) => (
        <div class="flex flex-col justify-center">
          <Image
            src={image.img}
            alt={image.alt}
            width={imageWidth}
            height={imageHeight}
            class="rounded-lg object-cover w-full max-w-[200px] aspect-square"
            loading="lazy"
          />
          {image.title && (
            <p class="text-center mt-2 text-xs md:text-sm font-medium text-gray-700">
              {image.title}
            </p>
          )}
        </div>
      ))}
    </div>
  )}
</div>

<style>
  /* Ensure consistent aspect ratios */
  .aspect-square {
    aspect-ratio: 1 / 1.1;
  }
</style>
