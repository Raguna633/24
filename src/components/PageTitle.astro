---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import WaveCanvas from "./WaveCanvas.astro";
import bgTitle from "../assets/27250374_1290.webp";
import "../styles/global.css";
---

<div
  class="pt-8 z-0 absolute w-full h-32 inset-0 flex-col text-center justify-center items-center"
  id="title-container"
>
  <h1
    class="z-10 relative text-white text-center lg:mb-8 lg:mt-4 font-black tracking-wider lg:text-2xl"
  >
    WELCOME TO OUR CLASS
  </h1>
  <WaveCanvas
    color="#f5f0ea"
    position="bottom"
    height={40}
    speed={0.05}
    gradientMode="linear"
    gradientDirection="to-bottom"
    gradientStops={[
      { offset: 0, color: "#f5f0ea", opacity: 0 }, // Top: transparent
      { offset: 0.4, color: "#f5f0ea", opacity: 0.4 },
      { offset: 0.7, color: "#f5f0ea", opacity: 0.7 },
      { offset: 1, color: "#f5f0ea", opacity: 1 }, // Bottom: solid
    ]}
  />
</div>

<style>
  #title-container {
    background:
      linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0) 0%,
        /* Transparan di atas */ rgba(255, 255, 255, 0.3) 50%,
        /* Sedikit putih di tengah */ #f5f0ea 100% /* Putih penuh di bawah */
      ),
      url("https://res.cloudinary.com/dhbps9kvp/image/upload/v1775105080/27250374_1290.webp");
    background-size: cover;
    background-position: center;
    text-align: justify;
  }
  .title-text {
  }
</style>
