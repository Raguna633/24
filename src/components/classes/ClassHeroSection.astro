---
import CloudinaryImage from "../ui/CloudinaryImage.astro";

interface Props {
  className: string;
  heroImageSrc: string;
}

const { className, heroImageSrc } = Astro.props;
---

<section
  class="hero-section w-full h-dvh relative overflow-hidden bg-[#f5f0eaff] box-border"
>
  <div class="relative w-full h-full">
    <!-- Skenario 2: Teks Raksasa Tengah (Temporer) -->
    <div
      class="hero-center-text absolute inset-0 z-40 flex items-center justify-center pointer-events-none opacity-0 will-animate"
    >
      <h2
        class="text-[#2A358F] font-bold text-[clamp(2.5rem,10vw,12rem)] tracking-widest text-center"
        style="font-family: 'Orbitron', sans-serif;"
      >
        {className}
      </h2>
    </div>

    <!-- Skenario 4: Background container -->
    <div
      class="hero-title absolute right-0 top-0 z-50 h-fit bg-[#f5f0eaff] rounded-b-2xl sm:rounded-b-4xl md:rounded-bl-[2.5rem] md:rounded-br-none shadow-xl flex items-center justify-center px-12 py-4 sm:py-6 max-w-none md:max-w-[70%] lg:max-w-[40%] opacity-0 will-animate"
    >
      <div class="hero-title-inner overflow-hidden w-full relative">
        <!-- Skenario 5: Text di dalam box -->
        <h1
          class="hero-title-text text-black text-[clamp(1.5rem,6vw,4rem)] tracking-widest text-center text-shadow-[8px_8px_12px_rgb(0_0_0/0.3)] will-animate"
        >
          XII {className}
        </h1>
      </div>
    </div>

    <!-- Skenario 3: Background Image -->
    <div class="hero absolute inset-0 z-10 w-full h-full pt-20 px-8">
      <!-- Kontainer ini yang akan memunculkan gambar dengan opacity dan scale -->
      <div
        class="hero-image-wrapper relative w-full h-full overflow-hidden sm:rounded-4xl drop-shadow-black z-10 opacity-0 will-animate"
      >
        <CloudinaryImage
          src={heroImageSrc}
          alt={`Hero Background XII ${className}`}
          class="object-cover w-full h-full border-0 sm:border-3 border-[#b1b2b5FF] z-0"
          sizes="100vw"
        />
        <div
          class="bg-linear-to-t from-[#f5f0eaff] to-transparent h-1/3 absolute bottom-0 inset-x-0 w-full z-20 pointer-events-none"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-title-text {
    font-family: "qontra", sans-serif;
    text-shadow: -5px 5px 4px #00000033;
  }
</style>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { waitForLoading } from "../../utils/loadingState";

  gsap.registerPlugin(SplitText);

  document.addEventListener("astro:page-load", async () => {
    const section = document.querySelector(".hero-section");
    const centerText = document.querySelector(".hero-center-text");
    const centerTextH2 = document.querySelector(".hero-center-text h2");
    const heroImageWrapper = document.querySelector(".hero-image-wrapper");
    const heroTitle = document.querySelector(".hero-title");
    const heroTitleText = document.querySelector(".hero-title-text");

    if (
      !section ||
      !centerText ||
      !centerTextH2 ||
      !heroImageWrapper ||
      !heroTitle ||
      !heroTitleText
    )
      return;

    // Split text untuk animasi kemunculan kata per kata atau karakter per karakter
    const splitCenterText = new SplitText(centerTextH2, {
      type: "chars, words",
    });

    // Matikan Tailwind transforms sementara agar GSAP yang pegang kendali
    gsap.set(centerText, { opacity: 0 });
    gsap.set(splitCenterText.chars, { opacity: 0, y: 80, rotateX: -90 });
    // Mulai dari scale 1.05 untuk effect zoom out
    gsap.set(heroImageWrapper, { opacity: 0, scale: 1.05 });

    // Setel yPercent -100 agar naik ke atas (tersembunyi)
    gsap.set(heroTitle, { yPercent: -100, opacity: 0 });

    // Posisikan text title-text di bawah box (disembunyikan oleh parent overflow-hidden)
    gsap.set(heroTitleText, { yPercent: 100 });

    // Tunggu overlay loading layar diturunkan
    await waitForLoading();

    // Mulai penganimasian
    const tl = gsap.timeline();

    // Skenario 2: Text reveal raksasa lalu hilang
    tl.to(centerText, { opacity: 1, duration: 0.1 });

    tl.to(splitCenterText.chars, {
      opacity: 1,
      y: 0,
      rotateX: 0,
      stagger: 0.05,
      duration: 1.2,
      ease: "back.out(1.5)",
      force3D: true,
    });

    // Jeda sejenak sebelum menghilang
    tl.to(
      splitCenterText.chars,
      {
        opacity: 0,
        scale: 1.3,
        y: -40,
        stagger: 0.03,
        duration: 0.6,
        ease: "power3.in",
        force3D: true,
      },
      "+=0.6",
    );

    // Skenario 3: Background Image Reveal
    tl.to(
      heroImageWrapper,
      {
        opacity: 1,
        scale: 1,
        duration: 1.8,
        ease: "power4.out",
        force3D: true,
        clearProps: "scale", // Bersihkan supaya saat diresize/normal tidak kacau
      },
      "-=0.2",
    );

    // Skenario 4: Background container turun
    tl.to(
      heroTitle,
      {
        yPercent: 0,
        opacity: 1,
        duration: 1.2,
        ease: "power4.out",
        force3D: true,
      },
      "-=1.2",
    ); // Bersamaan dengan gambar muncul

    // Skenario 5: Text reveal (XII [Kelas]) muncul dari overflow hidden
    tl.to(
      heroTitleText,
      {
        yPercent: 0,
        duration: 1.2,
        ease: "power4.out",
        force3D: true,
      },
      "-=0.6",
    ); // Dimulai di pertengahan kontainer sedang turun
  });
</script>
