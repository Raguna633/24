---
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import ClassHeroSection from "../ClassHeroSection.astro";
import StudentCard from "../../StudentCard.astro";
import NextClassesCTA from "../NextClassesCTA.astro";
import FadeOverlay from "../../FadeOverlay.astro";
import StoryTextReveal from "../../sections/StoryTextReveal.astro";

// Import Assets
// import polaroidMask from "../../../assets/polaroid-mask.svg?raw";
import tape from "../../../assets/washi-tape-strip1.svg?raw";

// Import Photos
import group1 from "../../../assets/ips2-group1.webp";
import group2 from "../../../assets/ips2-group2.webp";
import group3 from "../../../assets/ips2-group3.webp";

const classData = await getEntry("classes", "ips2");
if (!classData) {
  throw new Error("Data kelas ips2 tidak ditemukan di collection");
}
const classContent = classData.data;

const heroBg1 =
  typeof classContent.heroPhoto?.[0] === "string"
    ? classContent.heroPhoto[0]
    : (classContent.heroPhoto?.[0] as any)?.src || "";
const heroBg2 =
  typeof classContent.heroPhoto?.[1] === "string"
    ? classContent.heroPhoto[1]
    : (classContent.heroPhoto?.[1] as any)?.src || "";
const walasPic =
  typeof classContent.walasPhoto === "string"
    ? classContent.walasPhoto
    : (classContent.walasPhoto as any)?.src || "";

// Scattered Memory Collection
const polaroidMemories = [
  { image: group1, date: "AUGUST 2023", note: "The Beginning" },
  { image: group2, date: "OCTOBER 2023", note: "Class Project" },
  { image: group3, date: "JANUARY 2024", note: "Break Time" },
];

const allStudents = await getCollection(
  "students",
  ({ data }) => data.kelas === "IPS II",
);
allStudents.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<div class="overflow-x-hidden bg-[#e5e7eb]">
  <ClassHeroSection className={classContent.className} heroImageSrc={heroBg1} />

  <FadeOverlay connectorHeight="200" zIndex={10} translateY="-100%" />

  <StoryTextReveal
    walasImage={walasPic}
    walasName={classContent.walasName}
    walasTitle={`Wali Kelas XII ${classContent.className}`}
    topTexts={classContent.walasGreeting.topText}
    bottomTexts={classContent.walasGreeting.bottomText}
    bgImage={heroBg2}
    textColor="text-black"
  />

  <FadeOverlay />

  <!-- Polaroid Wall Section -->
  <section id="ips2-wall-section" class="min-h-screen bg-[#d1d5db] py-16 relative polaroid-wall-section">
     {/* Wall Texture Decor */}
     <div class="absolute inset-0 opacity-[0.03] pointer-events-none select-none" style="background-image: radial-gradient(#000 1px, transparent 0); background-size: 40px 40px;"></div>

     <div class="max-w-6xl mx-auto px-6 relative h-[80vh] md:h-[100vh]">
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none z-0">
           <h3 class="text-[20vw] font-black text-black/5 uppercase tracking-tighter leading-none select-none">MEMORIES</h3>
        </div>

        <div class="relative w-full h-full polaroid-container">
           {
             polaroidMemories.map((memory, index) => (
               <div 
                 class="absolute polaroid-card will-animate opacity-0"
                 style={`z-index: ${index + 10};`}
               >
                  <div class="relative bg-white p-3 pb-8 md:p-4 md:pb-12 shadow-2xl transform-gpu">
                    {/* Tape Decoration */}
                    <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-24 h-12 opacity-80 z-20" set:html={tape} />
                    
                    {/* Photo Container */}
                    <div class="relative aspect-square overflow-hidden bg-gray-200">
                       <Image 
                         src={memory.image} 
                         alt={`Memory ${index+1}`} 
                         class="w-full h-full object-cover grayscale-[30%] hover:grayscale-0 transition-all duration-700" 
                       />
                       {/* <div class="absolute inset-0 z-10 pointer-events-none" set:html={polaroidMask} /> */}
                    </div>

                    {/* Handwritten Note */}
                    <div class="mt-4 md:mt-6 text-center">
                       <p class="font-serif italic text-gray-800 text-lg md:text-xl transform rotate-[-2deg]">{memory.note}</p>
                       <span class="block text-[10px] font-mono text-gray-400 mt-1 uppercase tracking-widest">{memory.date}</span>
                    </div>
                  </div>
               </div>
             ))
           }
        </div>
     </div>
  </section>

  <FadeOverlay />

  <!-- Students Grid -->
  <section
    class="students-section py-32 px-6 bg-[#f5f0ea]"
    aria-label={`Daftar siswa kelas ${classContent.className}`}
  >
    <div class="max-w-7xl mx-auto">
      <div class="students-heading mb-24 text-center relative">
        <p class="font-mono text-[#2A358F]/50 text-xs tracking-[0.6em] uppercase mb-6 opacity-0 students-heading-label will-animate">
          The Graduates
        </p>
        <h2 class="text-7xl md:text-9xl font-black text-[#2A358F] uppercase italic tracking-tighter leading-[0.8] opacity-0 students-heading-title will-animate">
          {classContent.className}
        </h2>
        <p class="text-sm text-gray-400 mt-8 opacity-0 students-heading-count will-animate tracking-[0.2em] font-mono italic">
          // {allStudents.length} STORIES COLLECTED
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {
          allStudents.map((student) => (
            <div class="student-card-wrapper opacity-0 will-animate">
              <StudentCard
                name={student.data.name}
                slug={student.slug}
                photo={student.data.photo}
                quote={student.data.quote}
                class={student.data.kelas ?? ""}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <NextClassesCTA
    prevClass={classContent.prevClass}
    nextClass={classContent.nextClass}
  />

  <style>
    body {
      @apply bg-[#e5e7eb];
    }
    .polaroid-card {
      width: 250px;
      @screen md {
        width: 320px;
      }
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { waitForLoading } from "../../../utils/loadingState";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", async () => {
      // 1. Cleanup existing triggers
      ScrollTrigger.getAll().forEach(t => t.kill());

      await waitForLoading();

      const ctx = gsap.context(() => {
        const section = document.querySelector("#ips2-wall-section");
        if (!section) return;

        // --- POLAROID WALL ANIMATIONS ---
        const cards = gsap.utils.toArray<HTMLElement>(".polaroid-card", section);
        
        // Define target positions for 3 cards (Spaced proportionally)
        const positions = [
          { top: "20%", left: "22%", rotate: -8 },   // Top Left
          { top: "25%", left: "75%", rotate: 12 },   // Top Right
          { top: "65%", left: "48%", rotate: -4 },   // Bottom Center
        ];

        // Set static positions once (Target State)
        cards.forEach((card, i) => {
          const pos = positions[i % positions.length];
          gsap.set(card, {
            top: pos.top,
            left: pos.left,
            xPercent: -50,
            yPercent: -50,
            rotation: pos.rotate,
            opacity: 1 // Target is visible
          });
        });

        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: section,
            start: "top top",
            end: "+=150%",
            pin: true,
            scrub: 1.2,
            anticipatePin: 1
          }
        });

        // Entrance animation from center using ONLY GPU properties
        cards.forEach((card, i) => {
          tl.from(card, {
            // Calculate dynamic offset from viewport center
            x: () => {
              const rect = card.getBoundingClientRect();
              return (window.innerWidth / 2) - (rect.left + rect.width / 2);
            },
            y: () => {
              const rect = card.getBoundingClientRect();
              return (window.innerHeight / 2) - (rect.top + rect.height / 2);
            },
            rotation: (Math.random() - 0.5) * 100,
            scale: 0.2,
            opacity: 0,
            duration: 1.5,
            ease: "power3.out",
            force3D: true
          }, i * 0.4);
        });

        // --- STUDENTS HEADING ---
        gsap.fromTo(".students-heading-label, .students-heading-title, .students-heading-count", 
          { opacity: 0, y: 50 },
          {
            opacity: 1,
            y: 0,
            duration: 1.5,
            stagger: 0.15,
            ease: "expo.out",
            force3D: true,
            scrollTrigger: {
              trigger: ".students-section",
              start: "top 85%",
              once: true
            }
          }
        );

        // --- CARDS STAGGER (Optimized with Batch) ---
        ScrollTrigger.batch(".student-card-wrapper", {
          onEnter: (elements) => {
            gsap.fromTo(elements, 
              { opacity: 0, y: 30 },
              {
                opacity: 1,
                y: 0,
                duration: 1,
                stagger: 0.1,
                ease: "power2.out",
                force3D: true
              }
            );
          },
          start: "top 95%",
          once: true
        });
      });

      ScrollTrigger.refresh();

      document.addEventListener("astro:before-swap", () => {
        ctx.revert();
      }, { once: true });
    });
  </script>
</div>
