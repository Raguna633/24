---
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import ClassHeroSection from "../ClassHeroSection.astro";
import StudentCard from "../../StudentCard.astro";
import NextClassesCTA from "../NextClassesCTA.astro";
import FadeOverlay from "../../FadeOverlay.astro";
import StoryTextReveal from "../../sections/StoryTextReveal.astro";

// Import Assets
import plant1 from "../../../assets/plant1.svg?raw";
import plant2 from "../../../assets/plant2.svg?raw";
import specimenFrame from "../../../assets/specimen-frame.svg?raw";

// Import Photos
import group1 from "../../../assets/ipa2-group1.webp";
import group2 from "../../../assets/ipa2-group2.webp";
import group3 from "../../../assets/ipa2-group3.webp";
import group4 from "../../../assets/ipa2-group4.webp";
import group5 from "../../../assets/ipa2-group5.webp";
import group6 from "../../../assets/ipa2-group6.webp";

const classData = await getEntry("classes", "ipa2");
if (!classData) {
  throw new Error("Data kelas ipa2 tidak ditemukan di collection");
}
const classContent = classData.data;

const heroBg1 =
  typeof classContent.heroPhoto?.[0] === "string"
    ? classContent.heroPhoto[0]
    : (classContent.heroPhoto?.[0] as any)?.src || "";
const heroBg2 =
  typeof classContent.heroPhoto?.[1] === "string"
    ? classContent.heroPhoto[1]
    : (classContent.heroPhoto?.[1] as any)?.src || "";
const walasPic =
  typeof classContent.walasPhoto === "string"
    ? classContent.walasPhoto
    : (classContent.walasPhoto as any)?.src || "";

// Botanical Collection
const botanicalSpecimens = [
  { image: group1, label: "SEEDLING", text: "Awal mula persemaian mimpi di tanah IPA 2." },
  { image: group2, label: "ROOTING", text: "Akar persahabatan yang mulai menghujam dalam." },
  { image: group3, label: "STAMEN", text: "Energi yang merekah di setiap praktikum dan tawa." },
  { image: group4, label: "PHOTOSYNTHESIS", text: "Mengolah lelah menjadi energi keberhasilan." },
  { image: group5, label: "POLLINATION", text: "Menyebarkan inspirasi ke setiap sudut sekolah." },
  { image: group6, label: "BLOOMING", text: "Kini kita siap mekar di taman yang lebih luas." },
];

const allStudents = await getCollection(
  "students",
  ({ data }) => data.kelas === "IPA II",
);
allStudents.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<div class="overflow-x-hidden bg-[#faf7f2]">
  <ClassHeroSection className={classContent.className} heroImageSrc={heroBg1} />

  <FadeOverlay connectorHeight="200" zIndex={10} translateY="-100%" />

  <StoryTextReveal
    walasImage={walasPic}
    walasName={classContent.walasName}
    walasTitle={`Wali Kelas XII ${classContent.className}`}
    topTexts={classContent.walasGreeting.topText}
    bottomTexts={classContent.walasGreeting.bottomText}
    bgImage={heroBg2}
    textColor="#2A358F"
  />

  <FadeOverlay connectorHeight="200" />

  <!-- Botanical Collection Section -->
  <div class="botanical-wrap">
    {
      botanicalSpecimens.map((specimen, index) => (
        <section class="min-h-screen py-24 flex items-center justify-center p-6 relative overflow-hidden specimen-section border-b border-black/5">
          {/* Decorative Plants */}
          <div 
            class={`absolute ${index % 2 === 0 ? '-left-10' : '-right-10'} top-1/2 -translate-y-1/2 w-64 md:w-96 opacity-[0.07] pointer-events-none rotate-[10deg] plant-bg`}
            set:html={index % 2 === 0 ? plant1 : plant2}
          />

          <div class="max-w-4xl w-full flex flex-col items-center z-10">
            {/* Specimen Frame with Circular Photo */}
            <div class="relative w-72 h-72 md:w-[400px] md:h-[400px] flex items-center justify-center group">
               <div class="absolute inset-0 z-20 pointer-events-none scale-105" set:html={specimenFrame} />
               <div class="w-[85%] h-[85%] rounded-full overflow-hidden border-2 border-dashed border-[#2A358F]/20 p-1 relative">
                  <div class="w-full h-full rounded-full overflow-hidden bg-gray-100 reveal-mask translate-z-0">
                    <Image 
                      src={specimen.image} 
                      alt={specimen.label} 
                      class="w-full h-full object-cover filter sepia-[20%] group-hover:sepia-0 transition-all duration-1000 scale-110"
                    />
                  </div>
               </div>

               {/* Botanical Label */}
               <div class="absolute bottom-4 -right-4 bg-white/80 backdrop-blur-sm border border-[#2A358F]/10 px-4 py-2 shadow-md rotate-[3deg] will-animate specimen-label">
                  <span class="font-mono text-[10px] text-[#2A358F] font-bold tracking-tighter uppercase">No_{index+1} / {specimen.label}</span>
               </div>
            </div>

            {/* Description */}
            <div class="mt-12 text-center max-w-lg space-y-4 will-animate specimen-text">
               <p class="text-xl md:text-2xl italic font-serif text-gray-800 leading-relaxed">
                 "{specimen.text}"
               </p>
               <div class="flex items-center justify-center gap-3">
                  <div class="h-px w-8 bg-gray-300"></div>
                  <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-gray-400">Classis Secundus</span>
                  <div class="h-px w-8 bg-gray-300"></div>
               </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <FadeOverlay />

  <!-- Students Grid -->
  <section
    class="students-section py-32 px-6 bg-[#f5f0ea]"
    aria-label={`Daftar siswa kelas ${classContent.className}`}
  >
    <div class="max-w-7xl mx-auto">
      <div class="students-heading mb-20 text-center">
        <p class="font-mono text-[#2A358F]/50 text-xs tracking-[0.5em] uppercase mb-4 opacity-0 students-heading-label will-animate">
          Herbarium Personale
        </p>
        <h2 class="text-6xl md:text-8xl font-bold text-[#2A358F] opacity-0 students-heading-title will-animate">
          {classContent.className}
        </h2>
        <p class="text-sm text-gray-400 mt-6 opacity-0 students-heading-count will-animate tracking-widest italic">
          {allStudents.length} Unique Species Cataloged
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {
          allStudents.map((student) => (
            <div class="student-card-wrapper opacity-0 will-animate">
              <StudentCard
                name={student.data.name}
                slug={student.slug}
                photo={student.data.photo}
                quote={student.data.quote}
                class={student.data.kelas ?? ""}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <NextClassesCTA
    prevClass={classContent.prevClass}
    nextClass={classContent.nextClass}
  />

  <style>
    body {
      @apply bg-[#faf7f2];
    }
    /* Clip-path for circular reveal */
    .reveal-mask {
       clip-path: circle(0% at 50% 50%);
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { waitForLoading } from "../../../utils/loadingState";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", async () => {
      const ctx = gsap.context(() => {});
      document.addEventListener("astro:before-swap", () => {
        ctx.revert();
        ScrollTrigger.getAll().forEach(t => t.kill());
      }, { once: true });

      await waitForLoading();

      ctx.add(() => {
        // --- SPECIMEN ANIMATIONS ---
        const sections = gsap.utils.toArray<HTMLElement>(".specimen-section");
        sections.forEach((section) => {
          const mask = section.querySelector(".reveal-mask");
          const label = section.querySelector(".specimen-label");
          const text = section.querySelector(".specimen-text");
          const img = section.querySelector("img");

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: section,
              start: "top 60%",
              once: true
            }
          });

          tl.to(mask, {
            clipPath: "circle(50% at 50% 50%)",
            duration: 1.5,
            ease: "power2.inOut"
          })
          .to(img, {
            scale: 1,
            duration: 1.5,
            ease: "power2.out"
          }, 0)
          .from(label, {
            opacity: 0,
            x: 20,
            rotation: 10,
            duration: 0.8
          }, "-=0.5")
          .from(text, {
            opacity: 0,
            y: 20,
            duration: 1
          }, "-=0.6");
        });

        // --- STUDENTS HEADING ---
        gsap.to(".students-heading-label, .students-heading-title, .students-heading-count", {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.2,
          scrollTrigger: {
            trigger: ".students-section",
            start: "top 80%",
            once: true
          }
        });

        // --- CARDS STAGGER ---
        const cards = gsap.utils.toArray<HTMLElement>(".student-card-wrapper");
        cards.forEach((card, i) => {
          gsap.to(card, {
            opacity: 1,
            y: 0,
            duration: 0.8,
            delay: (i % 4) * 0.1,
            scrollTrigger: {
              trigger: card,
              start: "top 95%",
              once: true
            }
          });
        });
      });
    });
  </script>
</div>
