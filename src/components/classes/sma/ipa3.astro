---
import { getEntry, getCollection } from "astro:content";
import { mapStudentCollection } from "../../../utils/student";
import { Image } from "astro:assets";
import CloudinaryImage from "../../ui/CloudinaryImage.astro";
import ClassHeroSection from "../ClassHeroSection.astro";
import StudentCard from "../../StudentCard.astro";
import NextClassesCTA from "../NextClassesCTA.astro";
import FadeOverlay from "../../FadeOverlay.astro";
import StoryTextReveal from "../../sections/StoryTextReveal.astro";

// Import Assets
import redBloodCell from "../../../assets/red-blood-cell.svg?raw";
import boneCell from "../../../assets/bone-cell.svg?raw";
import nerveCell from "../../../assets/nerve-cell.svg?raw";
import magnify from "../../../assets/magnify.svg?raw";
import specimenFrame from "../../../assets/specimen-frame.svg?raw";

// Photos (Using string constants for external URLs)
const group1 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599573/ipa3-group1.webp";
const group2 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599572/ipa3-group2.webp";
const group3 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599573/ipa3-group3.webp";
const group4 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599575/ipa3-group4.webp";
const group5 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599573/ipa3-group5.webp";
const group6 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599572/ipa3-group6.webp";

const classData = await getEntry("classes", "ipa3");
if (!classData) {
  throw new Error("Data kelas ipa3 tidak ditemukan di collection");
}
const classContent = classData.data;

const heroBg1 =
  typeof classContent.heroPhoto?.[0] === "string"
    ? classContent.heroPhoto[0]
    : (classContent.heroPhoto?.[0] as any)?.src || "";
const heroBg2 =
  typeof classContent.heroPhoto?.[1] === "string"
    ? classContent.heroPhoto[1]
    : (classContent.heroPhoto?.[1] as any)?.src || "";
const heroBg3 =
  typeof classContent.heroPhoto?.[2] === "string"
    ? classContent.heroPhoto[2]
    : (classContent.heroPhoto?.[2] as any)?.src || "";
const walasPic =
  typeof classContent.walasPhoto === "string"
    ? classContent.walasPhoto
    : (classContent.walasPhoto as any)?.src || "";

// Anatomy Records
const anatomyFiles = [
  { image: group1, label: "CELL_FORMATION", text: "Unit terkecil dari kebersamaan kita mulai terbentuk di sini." },
  { image: group2, label: "NERVOUS_SYSTEM", text: "Jalinan komunikasi yang menghubungkan setiap tawa dan mimpi." },
  { image: group3, label: "SKELETAL_BASE", text: "Struktur persahabatan yang kuat, menopang setiap beban bersama." },
  { image: group4, label: "VITAL_ORGANS", text: "Aksi-aksi vital yang menghidupkan suasana kelas setiap harinya." },
  { image: group5, label: "CIRCULATION", text: "Irama yang sama, mengalirkan semangat ke seluruh penjuru IPA 3." },
  { image: group6, label: "FULL_ANATOMY", text: "Kini kita adalah satu organisme yang utuh dan tak terpisahkan." },
];

const studentsRaw = await getCollection(
  "students",
  ({ data }) => data.kelas === "IPA III",
);
const allStudents = mapStudentCollection(studentsRaw);
allStudents.sort((a, b) => a.name.localeCompare(b.name));
---

<div class="overflow-x-hidden bg-[#fdfaf6]">
  <ClassHeroSection className={classContent.className} heroImageSrc={heroBg1} />

  <FadeOverlay connectorHeight="200" zIndex={10} translateY="-100%" />

  <StoryTextReveal
    walasImage={walasPic}
    walasName={classContent.walasName}
    walasTitle={`Wali Kelas XII ${classContent.className}`}
    topTexts={classContent.walasGreeting.topText}
    bottomTexts={classContent.walasGreeting.bottomText}
    bgImage={heroBg3}
    textColor="text-black"
  />

  <FadeOverlay connectorHeight="40" />

  <!-- Anatomy Record Section -->
  <div class="anatomy-wrap">
    {
      anatomyFiles.map((file, index) => (
        <section class="min-h-screen py-24 flex items-center justify-center p-6 relative  anatomy-section border-b border-black/5">
          {/* Microscopic Elements */}
          <div  
            class={`absolute ${index % 2 === 0 ? '-left-20' : '-right-20'} top-1/3 w-72 md:w-[500px] opacity-[0.05] pointer-events-none anatomy-bg`}
            set:html={[boneCell, nerveCell, redBloodCell][index % 3]}
          />

          
          {/* Magnify Icon Decoration */}
          <div class="absolute top-10 left-10 w-12 h-12 opacity-10 text-[#2A358F] hidden md:block" set:html={magnify} />

          <div class={`max-w-5xl w-full flex flex-col md:items-center z-10 gap-12 md:gap-20 ${index % 2 === 0 ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
            {/* Specimen Frame with Microscopic View */}
            <div class="relative w-80 h-80 md:w-112 md:h-112 flex-shrink-0 flex items-center justify-center group mx-auto md:mx-0">
               <div class="absolute inset-0 z-20 pointer-events-none scale-105 opacity-80 specimen-frame-svg-wrapper" set:html={specimenFrame} />
               <div class="w-[85%] h-[85%] rounded-full overflow-hidden border-4 border-gray-200 p-0.5 relative">
                  <div class="w-full h-full rounded-full overflow-hidden bg-gray-100 reveal-mask translate-z-0">
                    <CloudinaryImage
                      src={file.image}
                      alt={file.label}
                      class="w-full h-full object-cover filter contrast-[1.1] grayscale-[10%] group-hover:grayscale-0 transition-all duration-1000 scale-110"
                      widths={[800, 1200]}
                      loading="lazy"
                    />
                  </div>
                  {/* Glass Reflection Effect */}
                  <div class="absolute inset-0 bg-gradient-to-tr from-white/10 to-transparent pointer-events-none z-10"></div>
               </div>

               {/* Clinical Label */}
               <div class={`absolute top-4 ${index % 2 === 0 ? '-left-4' : '-right-4'} bg-white border-l-4 border-[#2A358F] px-4 py-2 shadow-xl ${index % 2 === 0 ? 'rotate-[2deg]' : 'rotate-[-2deg]'} will-animate anatomy-label z-30`}>
                  <span class="font-mono text-[10px] text-[#2A358F] font-bold tracking-widest uppercase">REC_{index+1} // {file.label}</span>
               </div>
            </div>

            {/* Observation Text */}
            <div class={`flex-1 space-y-6 will-animate anatomy-text text-center ${index % 2 === 0 ? 'md:text-left' : 'md:text-right'}`}>
               <div class={`flex items-center justify-center gap-2 mb-2 ${index % 2 === 0 ? 'md:justify-start' : 'md:justify-end'}`}>
                  <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
                  <span class="font-mono text-[9px] uppercase tracking-widest text-red-600 font-bold">Observation in Progress</span>
               </div>
               <p class="text-2xl md:text-4xl font-serif text-gray-900 leading-tight">
                 "{file.text}"
               </p>
               <div class={`pt-6 border-t border-gray-200 inline-block w-48 ${index % 2 === 0 ? 'md:border-l-0' : ''}`}>
                  <span class="text-[9px] font-mono uppercase tracking-[0.4em] text-gray-500">Department of Anatomy III</span>
               </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <FadeOverlay />

  <!-- Students Grid -->
  <section
    class="students-section py-32 px-6 bg-[#f5f0ea]"
    aria-label={`Daftar siswa kelas ${classContent.className}`}
  >
    <div class="max-w-7xl mx-auto">
      <div class="students-heading mb-24 text-center">
        <p class="font-mono text-[#2A358F]/50 text-xs tracking-[0.5em] uppercase mb-4 opacity-0 students-heading-label will-animate">
          Anatomical Registry
        </p>
        <h2 class="text-6xl md:text-8xl font-bold text-[#2A358F] opacity-0 students-heading-title will-animate">
          {classContent.className}
        </h2>
        <div class="h-0.5 w-16 bg-[#2A358F]/10 mx-auto mt-6 opacity-0 students-heading-line will-animate"></div>
        <p class="text-sm text-gray-400 mt-6 opacity-0 students-heading-count will-animate tracking-[0.2em] font-mono uppercase">
          Total Nodes: {allStudents.length}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {
          allStudents.map((student) => (
            <div class="student-card-wrapper opacity-0 will-animate">
              <StudentCard
                name={student.name}
                slug={student.slug}
                photo={student.photo}
                quote={student.quote}
                class={student.class}
                classSlug="xii-ipa-3"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <NextClassesCTA
    prevClass={classContent.prevClass}
    nextClass={classContent.nextClass}
  />

  <style>
    body {
      @apply bg-[#fdfaf6];
    }
    .reveal-mask {
       clip-path: circle(0% at 50% 50%);
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { waitForLoading } from "../../../utils/loadingState";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", async () => {
      const ctx = gsap.context(() => {
        // --- INITIAL STATE / FOUC PREVENTION ---
        gsap.set(".students-heading-label, .students-heading-title, .students-heading-count", { opacity: 0, y: 30 });
        gsap.set(".students-heading-line", { opacity: 0, width: 0 });
        gsap.set(".student-card-wrapper", { opacity: 0, y: 50 });
      });

      await waitForLoading();

      ctx.add(() => {
        // --- ANATOMY ANIMATIONS ---
        const sections = gsap.utils.toArray<HTMLElement>(".anatomy-section");
        sections.forEach((section) => {
          const mask = section.querySelector(".reveal-mask");
          const label = section.querySelector(".anatomy-label");
          const text = section.querySelector(".anatomy-text");
          const bg = section.querySelector(".anatomy-bg");
          const img = section.querySelector("img");
          const isReverse = section.querySelector('.md\\:flex-row-reverse') !== null;
          const frameWrapper = section.querySelector(".specimen-frame-svg-wrapper");
          const frameSvg = frameWrapper?.querySelector("svg");

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: section,
              start: "top 60%",
              once: true
            }
          });

          tl.to(mask, {
            clipPath: "circle(50% at 50% 50%)",
            duration: 1.2,
            ease: "expo.out"
          })
          .to(img, {
            scale: 1,
            duration: 1.5,
            ease: "power2.out"
          }, 0)
          .from(bg, {
            opacity: 0,
            scale: 0.8,
            duration: 1.5,
            ease: "power1.out"
          }, 0)
          .from(label, {
            opacity: 0,
            x: isReverse ? 20 : -20,
            rotation: isReverse ? 5 : -5,
            duration: 0.8
          }, "-=0.6")
          .from(text, {
            opacity: 0,
            x: isReverse ? -30 : 30,
            duration: 1,
            ease: "power3.out"
          }, "-=0.8");

          // --- IDLE ORGANIC FLOAT ---
          if (frameSvg) {
            gsap.set(frameSvg, { rotation: gsap.utils.random(-3, 3) });
            gsap.to(frameSvg, {
              rotation: "+=6",
              duration: gsap.utils.random(12, 18),
              ease: "sine.inOut",
              repeat: -1,
              yoyo: true,
              force3D: true
            });
          }
        });

        // --- STUDENTS HEADING ---
        gsap.to(".students-heading-label, .students-heading-title, .students-heading-count", {
          opacity: 1,
          y: 0,
          duration: 1.2,
          stagger: 0.2,
          scrollTrigger: {
            trigger: ".students-section",
            start: "top 80%",
            once: true
          }
        });
        gsap.to(".students-heading-line", {
           opacity: 1,
           width: 64,
           duration: 1,
           scrollTrigger: {
             trigger: ".students-section",
             start: "top 80%",
             once: true
           }
        });

        // --- STUDENT CARDS (Batch Optimized) ---
        ScrollTrigger.batch(".student-card-wrapper", {
          onEnter: (batch) => {
            gsap.to(batch, {
              opacity: 1,
              y: 0,
              duration: 1,
              stagger: 0.1,
              ease: "power2.out",
              force3D: true
            });
          },
          start: "top 95%",
          once: true
        });
      });

      // Cleanup
      document.addEventListener("astro:before-swap", () => {
        ctx.revert();
      }, { once: true });
    });
  </script>
</div>
