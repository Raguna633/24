---
import { getEntry, getCollection } from "astro:content";
import { mapStudentCollection } from "../../../utils/student";
import { Image } from "astro:assets";
import ClassHeroSection from "../ClassHeroSection.astro";
import StudentCard from "../../StudentCard.astro";
import NextClassesCTA from "../NextClassesCTA.astro";
import FadeOverlay from "../../FadeOverlay.astro";
import StoryTextReveal from "../../sections/StoryTextReveal.astro";

// Import Assets
import constellationSvg from "../../../assets/constellation-line.svg?raw";
import starParticles from "../../../assets/star-particles.svg?raw";

// Import Photos
import group1 from "../../../assets/ipa4-group1.jpg";
import group2 from "../../../assets/ipa4-group2.jpg";
import group3 from "../../../assets/ipa4-group3.jpg";

const classData = await getEntry("classes", "ipa4");
if (!classData) {
  throw new Error("Data kelas ipa4 tidak ditemukan di collection");
}
const classContent = classData.data;

const heroBg1 =
  typeof classContent.heroPhoto?.[0] === "string"
    ? classContent.heroPhoto[0]
    : (classContent.heroPhoto?.[0] as any)?.src || "";
const heroBg2 =
  typeof classContent.heroPhoto?.[1] === "string"
    ? classContent.heroPhoto[1]
    : (classContent.heroPhoto?.[1] as any)?.src || "";
const heroBg3 =
  typeof classContent.heroPhoto?.[2] === "string"
    ? classContent.heroPhoto[2]
    : (classContent.heroPhoto?.[2] as any)?.src || "";
const walasPic =
  typeof classContent.walasPhoto === "string"
    ? classContent.walasPhoto
    : (classContent.walasPhoto as any)?.src || "";

// Eternal Galaxy Stories
const galaxyStories = [
  {
    image: group1,
    title: "FOUNDATION",
    text: "Kita berkumpul dari berbagai penjuru, ditarik oleh gravitasi mimpi yang sama.",
    color: "#facc15" // Gold
  },
  {
    image: group2,
    title: "EXPANSION",
    text: "Setiap hari adalah ledakan kreativitas yang memperluas batas horizon kita.",
    color: "#a855f7" // Purple
  },
  {
    image: group3,
    title: "ETERNITY",
    text: "Di akhir perjalanan ini, kita bukan lagi partikel yang terpisah, tapi satu keagungan abadi.",
    color: "#fbbf24" // Amber
  }
];

// Students data
const studentsRaw = await getCollection(
  "students",
  ({ data }) => data.kelas === "IPA IV",
);
const allStudents = mapStudentCollection(studentsRaw);
allStudents.sort((a, b) => a.name.localeCompare(b.name));
---

<div class="overflow-x-hidden bg-[#0b0d17]">
  <ClassHeroSection className={classContent.className} heroImageSrc={heroBg1} />

  <FadeOverlay connectorHeight="200" zIndex={10} translateY="-100%" />

  <StoryTextReveal
    walasImage={walasPic}
    walasName={classContent.walasName}
    walasTitle={`Wali Kelas XII ${classContent.className}`}
    topTexts={classContent.walasGreeting.topText}
    bottomTexts={classContent.walasGreeting.bottomText}
    bgImage={heroBg2}
    textColor="text-black"
  />

  <FadeOverlay connectorHeight="40" />

  <!-- Galaxy Storytelling Section -->
  <div class="galaxy-wrap relative overflow-hidden h-dvh">
    {/* Dynamic Star Field Backdrop */}
    <div class="absolute inset-0 z-0 opacity-30 pointer-events-none" set:html={starParticles} />
    
    {/* Constellation Draw Layer (Rule 05: Inline SVG for Animation) */}
    <div 
        class="constellation-container absolute inset-0 w-full h-full -z-10 pointer-events-none opacity-40 will-animate constellation-bg-gold"
        set:html={constellationSvg.replace("<svg ", '<svg preserveAspectRatio="xMidYMid slice" ')}
    />

    {
      galaxyStories.map((story, index) => (
        <section class="min-h-dvh flex items-center justify-center p-6 md:p-12 relative z-20 galaxy-section border-b border-white/5">
          <div class="max-w-6xl w-full grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            
            {/* Visual Side */}
            <div class={`relative group ${index % 2 === 0 ? 'order-2 lg:order-1' : 'order-2'}`}>
                <div class="absolute -inset-4 bg-yellow-500/10 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
                <div class="relative border border-yellow-500/20 bg-black/80 shadow-2xl shadow-yellow-500/5 will-animate galaxy-card overflow-hidden">
                  <div class="overflow-hidden">
                    <Image 
                      src={story.image} 
                      alt={story.title} 
                      class="w-full aspect-4/3 object-cover grayscale-40 group-hover:grayscale-0 transition-all duration-1000 galaxy-photo opacity-0 scale-105"
                    />
                  </div>
                  {/* Decorative HUD Elements */}
                  <div class="absolute top-0 right-0 p-4 font-mono text-[9px] text-yellow-500/40 tracking-[0.2em] uppercase">
                     Sector_V#{index+1} // ETERNAL_LINK
                  </div>
               </div>
            </div>

            {/* Content Side */}
            <div class={`space-y-6 ${index % 2 === 0 ? 'order-1 lg:order-2' : 'order-1'}`}>
               <div class="inline-block px-3 py-1 border border-yellow-500/30 bg-yellow-500/5">
                  <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-yellow-500">Epoch_{index + 1}</span>
               </div>
               <h2 class="text-4xl md:text-6xl font-bold tracking-tighter text-white will-animate galaxy-title" style="font-family: 'Orbitron', sans-serif;">
                 {story.title}
               </h2>
               <p class="text-lg text-white/70 leading-relaxed max-w-md font-light italic will-animate galaxy-desc">
                 "{story.text}"
               </p>
               <div class="h-0.5 w-12 bg-yellow-500/50 will-animate galaxy-line"></div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <FadeOverlay />

  <!-- Students Grid -->
  <section
    class="students-section py-32 px-6 bg-[#f5f0ea]"
    aria-label={`Daftar siswa kelas ${classContent.className}`}
  >
    <div class="max-w-7xl mx-auto">
      <div class="students-heading mb-24 text-center">
        <p class="text-[#2A358F]/50 text-xs tracking-[0.6em] uppercase mb-4 opacity-0 students-heading-label will-animate">
          Celestial Archive
        </p>
        <h2 class="text-6xl md:text-8xl font-bold text-[#2A358F] opacity-0 students-heading-title will-animate" style="font-family: 'Orbitron', sans-serif;">
          {classContent.className}
        </h2>
        <p class="text-sm text-gray-400 mt-6 opacity-0 students-heading-count will-animate tracking-[0.3em]">
          DATA ENTRIES FOUND: {allStudents.length}
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {
          allStudents.map((student) => (
            <div class="student-card-wrapper opacity-0 will-animate">
              <StudentCard
                name={student.name}
                slug={student.slug}
                photo={student.photo}
                quote={student.quote}
                class={student.class}
                classSlug="xii-ipa-4"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <NextClassesCTA
    prevClass={classContent.prevClass}
    nextClass={classContent.nextClass}
  />

  <style>
    body {
      @apply bg-[#0b0d17];
    }
    /* Customize Constellation Color for Gold Theme */
    .constellation-bg-gold :global(path), 
    .constellation-bg-gold :global(line) {
        stroke: #facc15 !important;
        stroke-width: 1px;
    }
    .constellation-bg-gold :global(circle) {
        fill: #facc15 !important;
    }
    .constellation-bg-gold svg {
        width: 100%;
        height: 100%;
        display: block;
        object-fit: cover;
    }
    .galaxy-wrap {
        will-change: transform;
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { waitForLoading } from "../../../utils/loadingState";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", async () => {
      const ctx = gsap.context(() => {});
      document.addEventListener("astro:before-swap", () => {
        ctx.revert();
        ScrollTrigger.getAll().forEach(t => t.kill());
      }, { once: true });

      await waitForLoading();

       ctx.add(() => {
         const galaxyWrap = document.querySelector(".galaxy-wrap") as HTMLElement;
         const storySections = gsap.utils.toArray<HTMLElement>(".galaxy-section");
         const starPaths = gsap.utils.toArray<SVGElement>(".constellation-container svg path, .constellation-container svg line");
 
         if (galaxyWrap && storySections.length > 0) {
           // --- STORY TIMELINE (IPA 1 Standard) ---
           const storiesTl = gsap.timeline({
             scrollTrigger: {
               trigger: galaxyWrap,
               start: "top top",
               end: "+=300%", 
               pin: true,
               scrub: 1,
               anticipatePin: 1,
             }
           });
 
           storySections.forEach((section, index) => {
             const card = section.querySelector(".galaxy-card");
             const title = section.querySelector(".galaxy-title");
             const desc = section.querySelector(".galaxy-desc");
             const line = section.querySelector(".galaxy-line");
             const photo = section.querySelector(".galaxy-photo");
 
             if (index > 0) {
               gsap.set(section, { position: "absolute", top: 0, left: 0, width: "100%", height: "100%", opacity: 0 });
             }
 
             const tl = gsap.timeline();
             
             if (index > 0) {
               tl.to(section, { opacity: 1, duration: 1 }, 0);
             }
 
             if (card) tl.from(card, { opacity: 0, scale: 0.95, duration: 1.5, ease: "expo.out" }, 0.2);
             if (photo) {
               tl.to(photo, { 
                 opacity: 1, 
                 scale: 1, 
                 filter: "grayscale(30%)", 
                 duration: 2, 
                 ease: "power2.out" 
               }, 0.3);
             }
             if (title) tl.from(title, { opacity: 0, x: -30, duration: 1, ease: "power4.out" }, "-=0.8");
             if (desc) tl.from(desc, { opacity: 0, y: 20, duration: 1, ease: "power4.out" }, "-=0.8");
             if (line) tl.from(line, { scaleX: 0, transformOrigin: "left", duration: 0.8 }, "-=0.6");
 
             storiesTl.add(tl, index === 0 ? 0 : "-=0.5");
 
             if (index < storySections.length - 1) {
               storiesTl.to(section, { opacity: 0, duration: 0.8 }, ">0.3");
             }
           });
 
           // --- BACKGROUND DRAWING ---
           if (starPaths.length > 0) {
             const totalTimelineDur = storiesTl.duration();
             
             starPaths.forEach((path) => {
               const p = path as unknown as SVGGeometryElement;
               const length = p instanceof SVGPathElement ? p.getTotalLength() : 1000;
               const originalFill = p.style.fill || window.getComputedStyle(p).fill;
 
               gsap.set(p, {
                 strokeDasharray: length + 2,
                 strokeDashoffset: length + 2,
                 fill: "none",
                 stroke: "#facc15",
                 strokeWidth: 1,
                 opacity: 0
               });
 
               storiesTl.to(p, { 
                   strokeDashoffset: 0, 
                   opacity: 1,
                   duration: totalTimelineDur, 
                   ease: "none" 
               }, 0);
 
               storiesTl.to(p, { 
                   fill: originalFill, 
                   duration: 0.5, 
                   ease: "power2.inOut" 
               }, ">-0.5");
             });
           }
         }
 
         // --- STUDENTS HEADING ---
         gsap.to(".students-heading-label, .students-heading-title, .students-heading-count", {
            opacity: 1,
            y: 0,
            duration: 1.2,
            stagger: 0.3,
            scrollTrigger: {
              trigger: ".students-section",
              start: "top 80%",
              once: true
            }
         });
 
         // --- STUDENT CARDS ---
         const cards = gsap.utils.toArray<HTMLElement>(".student-card-wrapper");
         cards.forEach((card, i) => {
           gsap.to(card, {
             opacity: 1,
             y: 0,
             duration: 1,
             delay: (i % 4) * 0.15,
             ease: "power2.out",
             scrollTrigger: {
               trigger: card,
               start: "top 95%",
               once: true
             }
           });
         });
       });
    });
  </script>
</div>
