---
import { getEntry, getCollection } from "astro:content";
import { mapStudentCollection } from "../../../utils/student";
import { Image } from "astro:assets";
import CloudinaryImage from "../../ui/CloudinaryImage.astro";
import ClassHeroSection from "../ClassHeroSection.astro";
import StudentCard from "../../StudentCard.astro";
import NextClassesCTA from "../NextClassesCTA.astro";
import FadeOverlay from "../../FadeOverlay.astro";
import StoryTextReveal from "../../sections/StoryTextReveal.astro";

// Import Assets
const paperTexture = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599459/paper-texture.jpg";
import stamp1 from "../../../assets/mplb-stamp1.svg?raw";
import paperclip from "../../../assets/paperclip.svg?raw";

// Photos (Using string constants for external URLs)
const group1 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599548/mplb-d-group1.webp";
const group2 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599551/mplb-d-group2.webp";
const group3 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599552/mplb-d-group3.webp";
const group4 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599550/mplb-d-group4.webp";
const group5 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599551/mplb-d-group5.webp";
const group6 = "https://res.cloudinary.com/dhbps9kvp/image/upload/v1778599560/mplb-d-group6.webp";

const classData = await getEntry("classes", "d-mplb");
if (!classData) {
  throw new Error("Data kelas d-mplb tidak ditemukan di collection");
}
const classContent = classData.data;

const heroBg1 =
  typeof classContent.heroPhoto?.[0] === "string"
    ? classContent.heroPhoto[0]
    : (classContent.heroPhoto?.[0] as any)?.src || "";
const heroBg2 =
  typeof classContent.heroPhoto?.[1] === "string"
    ? classContent.heroPhoto[1]
    : (classContent.heroPhoto?.[1] as any)?.src || "";
const walasPic =
  typeof classContent.walasPhoto === "string"
    ? classContent.walasPhoto
    : (classContent.walasPhoto as any)?.src || "";

// Story Data
const stories = [
  {
    image: group1,
    text: "Kita memulai kisah ini sebagai orang asing, dan kini menutup babnya sebagai sebuah keluarga.",
    id: "STORY #01",
    stamp: stamp1,
  },
  {
    image: group2,
    text: "Jutaan detik telah terlewati, ribuan tawa telah terbagi. Ini bukan akhir, melainkan awal dari sebuah rindu.",
    id: "STORY #02",
    stamp: stamp1,
  },
  {
    image: group3,
    text: "Bukan nilai di atas kertas yang paling kita ingat, melainkan proses dan perjuangan yang kita lalui bersama.",
    id: "STORY #03",
    stamp: stamp1,
  },
  {
    image: group4,
    text: "Mungkin besok kita akan berjalan di jalur yang berbeda, namun kompas ingatan ini akan selalu menunjuk pada titik yang sama.",
    id: "STORY #04",
    stamp: stamp1,
  },
  {
    image: group5,
    text: "Tiga tahun lalu kita datang membawa sejuta harapan, hari ini kita melangkah pergi membawa cerita tak terlupakan.",
    id: "STORY #05",
    stamp: stamp1,
  },
  {
    image: group6,
    text: "Simpan lembaran kenangan ini dengan baik. Suatu hari nanti, kita akan membukanya lagi sambil tersenyum bangga.",
    id: "STORY #06",
    stamp: stamp1,
  },
];

// Ambil semua siswa kelas D MPLB dari collection
const studentsRaw = await getCollection(
  "students",
  ({ data }) => data.kelas === "D MPLB",
);
const allStudents = mapStudentCollection(studentsRaw);
allStudents.sort((a, b) => a.name.localeCompare(b.name));
---

<div class="overflow-x-hidden">
  <!-- Import Font via Google Fonts -->
  <style is:global>
    @import url("https://fonts.googleapis.com/css2?family=Special+Elite&display=swap");
    .font-special-elite {
      font-family: "Special Elite", cursive;
    }
  </style>

  <ClassHeroSection className={classContent.className} heroImageSrc={heroBg1} />

  <!-- <FadeOverlay connectorHeight="200" zIndex={10} translateY="-100%" /> -->

  <StoryTextReveal
    walasImage={walasPic}
    walasName={classContent.walasName}
    walasTitle={`Wali Kelas XII ${classContent.className}`}
    topTexts={classContent.walasGreeting.topText}
    bottomTexts={classContent.walasGreeting.bottomText}
    bgImage={heroBg2}
    textColor="#2A358F"
  />

  <FadeOverlay connectorHeight="80" />

  <!-- Story Sections (Vintage Office) -->
  <div class="stories-container bg-[#f5f0ea]">
    <div
      class="absolute inset-0 opacity-[0.2] bg-cover bg-no-repeat pointer-events-none mix-blend-multiply"
      style={`background-image: url(${paperTexture});`}
    ></div>
    {
      stories.map((story, index) => (
        <section class="min-h-screen flex items-center justify-center p-8 overflow-hidden relative border-b border-black/5 story-section">
          {/* Background Pattern placeholder */}

          <div 
            class={`relative bg-white p-4 md:p-8 shadow-[10px_10px_30px_rgba(0,0,0,0.08)] max-w-7xl w-full border border-gray-100 will-animate story-card ${
              index % 2 === 0 ? 'rotate-[-0.5deg]' : 'rotate-[0.5deg]'
            }`}
          >
            {/* Decorative Items */}
            <div
              class={`absolute -top-6 ${index % 2 === 0 ? 'left-12' : 'right-12'} w-12 h-12 text-[#2a358f]/20 rotate-15 hidden md:block`}
              set:html={paperclip}
            />

            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
              {/* Photo Area */}
              <div class={`md:col-span-7 relative group overflow-hidden bg-gray-50 aspect-4/3 border border-gray-200 ${index % 2 !== 0 ? 'md:order-2' : ''}`}>
                <CloudinaryImage
                  src={story.image}
                  alt={story.id}
                  widths={[800, 1200]}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  class="w-full h-full object-cover grayscale-20 group-hover:grayscale-0 transition-all duration-700 will-animate opacity-0 story-photo"
                />
                {/* Stamp Animation Layer */}
                <div
                  class={`absolute ${index % 2 === 0 ? 'bottom-4 right-4' : 'top-4 left-4'} w-48 h-48 opacity-0 scale-[2] pointer-events-none stamp-element`}
                  set:html={story.stamp}
                />
              </div>

              {/* Text Area (Office Note) */}
              <div class={`md:col-span-5 relative ${index % 2 !== 0 ? 'md:order-1' : ''}`}>
                <div 
                  class={`p-6 md:p-10 shadow-lg border-t-2 relative ${
                    index % 2 === 0 
                      ? 'bg-[#fff9c4] rotate-[1.5deg] border-[#fcd34d]' 
                      : 'bg-[#f0f9ff] rotate-[-1.5deg] border-[#7dd3fc]'
                  }`}
                >
                  <div class="absolute top-2 right-2 opacity-10 text-4xl font-bold">"</div>
                  <p class="font-special-elite text-base md:text-lg text-gray-800 leading-relaxed indent-4">
                    {story.text}
                  </p>
                  <div class="mt-8 pt-4 border-t border-black/10 flex justify-between items-center">
                    <span class="font-mono text-[10px] tracking-widest text-[#2A358F]/50 uppercase">Internal Memo</span>
                    <span class="font-special-elite text-xs font-bold text-[#2A358F]">
                      {story.id}
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- <FadeOverlay /> -->

  <!-- Students Grid -->
  <section
    class="students-section py-32 px-6 bg-[#f5f0ea]"
    aria-label={`Daftar siswa kelas ${classContent.className}`}
  >
    <div class="max-w-7xl mx-auto">
      <div class="students-heading mb-20 text-center">
        <p class="text-[#2A358F]/50 text-sm tracking-[0.4em] uppercase mb-4 opacity-0 students-heading-label will-animate font-special-elite">
          Arsip Personel
        </p>
        <h2 class="text-6xl md:text-8xl font-bold text-[#2A358F] opacity-0 students-heading-title will-animate">
          {classContent.className}
        </h2>
        <div class="w-24 h-1 bg-[#2A358F]/20 mx-auto mt-8 opacity-0 students-heading-line will-animate" />
        <p class="text-base text-gray-400 mt-6 opacity-0 students-heading-count will-animate font-special-elite">
          Total {allStudents.length} Entitas yang Terekam
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 md:gap-8">
        {
          allStudents.map((student) => (
            <div class="student-card-wrapper opacity-0 will-animate">
              <StudentCard
                name={student.name}
                slug={student.slug}
                photo={student.photo}
                quote={student.quote}
                class={student.class}
                classSlug="xii-d-mplb"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <FadeOverlay />

  <NextClassesCTA
    prevClass={classContent.prevClass}
    nextClass={classContent.nextClass}
  />

  <style>
    body {
      @apply bg-[#f5f0eaff];
    }
    /* Mencegah overflow pada pola pattern SVG */
    svg {
      max-width: 100%;
      height: auto;
    }
    .stories-container {
      position: relative;
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { waitForLoading } from "../../../utils/loadingState";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("astro:page-load", async () => {
      const ctx = gsap.context(() => {
        // --- INITIAL STATE / FOUC PREVENTION ---
        gsap.set(".students-heading-label, .students-heading-title, .students-heading-count", { opacity: 0, y: 30 });
        gsap.set(".students-heading-line", { opacity: 0, scaleX: 0 });
        gsap.set(".student-card-wrapper", { opacity: 0, y: 50 });
      });

      await waitForLoading();

      ctx.add(() => {
        // --- STORY ANIMATION (PINNED) ---
        const storyContainer = document.querySelector(".stories-container");
        const storySections = gsap.utils.toArray<HTMLElement>(".story-section");
        
        if (storyContainer && storySections.length > 0) {
          const masterTl = gsap.timeline({
            scrollTrigger: {
              trigger: storyContainer,
              start: "top top",
              end: `+=${storySections.length * 100}%`,
              pin: true,
              scrub: 1,
              anticipatePin: 1,
            }
          });

          storySections.forEach((section, index) => {
            const card = section.querySelector(".story-card");
            const photo = section.querySelector(".story-photo");
            const stamp = section.querySelector(".stamp-element");
            const note = section.querySelector(".bg-\\[\\#fff9c4\\], .bg-\\[\\#f0f9ff\\]");

            if (index > 0) {
              gsap.set(section, { position: "absolute", top: 0, left: 0, width: "100%", opacity: 0 });
            }

            const tl = gsap.timeline();

            if (index > 0) {
              tl.to(section, { opacity: 1, duration: 1 });
            }

            tl.from(card, {
              y: 100,
              opacity: 0,
              duration: 1.2,
              ease: "expo.out",
            })
            .to(photo, {
              opacity: 1,
              duration: 1.5,
              ease: "power2.out",
            }, "-=0.8")
            .from(note, {
              x: 50,
              opacity: 0,
              rotation: 10,
              duration: 1,
              ease: "power3.out",
            }, "-=0.8")
            .to(stamp, {
              opacity: 0.8,
              scale: 1,
              duration: 0.4,
              ease: "back.out(2)",
            }, "-=0.2");

            masterTl.add(tl, index === 0 ? 0 : `+=${0.5}`);
            
            if (index < storySections.length - 1) {
              masterTl.to(section, { opacity: 0, duration: 0.5 }, `+=${0.5}`);
            }
          });
        }

        // --- STUDENTS SECTION ANIMATION ---
        gsap.to(".students-heading-label, .students-heading-title, .students-heading-count", {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.2,
          ease: "power2.out",
          scrollTrigger: {
            trigger: ".students-section",
            start: "top 70%",
            once: true,
          }
        });

        gsap.to(".students-heading-line", {
          opacity: 1,
          scaleX: 1,
          duration: 1,
          ease: "expo.inOut",
          scrollTrigger: {
            trigger: ".students-section",
            start: "top 70%",
            once: true,
          }
        });

        // --- STUDENT CARDS (Batch Optimized) ---
        ScrollTrigger.batch(".student-card-wrapper", {
          onEnter: (batch) => {
            gsap.to(batch, {
              opacity: 1,
              y: 0,
              duration: 0.8,
              stagger: 0.1,
              ease: "power3.out",
              force3D: true,
            });
          },
          start: "top 95%",
          once: true,
        });
      });

      // Cleanup
      document.addEventListener("astro:before-swap", () => {
        ctx.revert();
      }, { once: true });
    });
  </script>
</div>
