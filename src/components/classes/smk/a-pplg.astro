---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import TerminalCard from "../TerminalCard.astro";
import WalasName from "../WalasName.astro";
import WalasGreeting from "../WalasGreeting.astro";
import FadeOverlay from "../../FadeOverlay.astro";
import LineDecor from "../../LineDecor.astro";
import TefatieText from "./TefatieText.astro";
import TextCustom from "../../TextCustom.astro";

import heroBg from "../../../../public/assets/class/a_pplg/bg1.jpg";
import walasImage from "../../../../public/assets/class/a_pplg/dummy_kepsek.webp";
import tefaGroup from "../../../../public/assets/class/a_pplg/group_tefa.webp";
---

<div class="">
  <div
    class="hero-title absolute inset-x-0 top-0 z-50
         h-auto
         xl:h-full
         max-h-48
         bg-[#f5f0eaff]
         rounded-b-[1rem]
         sm:rounded-b-[2rem]
         md:rounded-bl-[2.5rem] md:rounded-br-none
         shadow-xl
         flex items-center justify-center
         px-4 sm:px-8
         py-4 sm:py-6
         max-w-none md:max-w-[70%] lg:max-w-[60%]
         ml-auto"
  >
    <h1
      class="text-black
         text-[clamp(1.5rem,6vw,4rem)]
         tracking-widest
         text-center
         text-shadow-[8px_8px_12px_rgb(0_0_0_/_0.3)]"
    >
      XII A PPLG
    </h1>
  </div>
  <div class="hero h-full relative inset-0 z-10">
    <div
      class="hero-image relative mx-0 sm:mx-[clamp(1rem,5vw,6rem)] mt-16 inset-0 overflow-hidden sm:rounded-4xl drop-shadow-black z-10"
    >
      <Image
        src={heroBg as ImageMetadata}
        alt="Hero Background"
        class="object-cover w-full h-full border-3 border-[#b1b2b5FF] z-0"
        sizes="100vw"
      />
    </div>
  </div>
  <div class="walas-wrapper h-0 z-20">
    <div
      class="walas-image z-20 left-0 relative overflow-hidden mx-0 sm:mx-[clamp(1rem,5vw,6rem)] rounded-bl-lg sm:rounded-bl-xl sm:rounded-tr-xl md:rounded-bl-2xl md:rounded-tr-2xl rounded-tr-lg lg:rounded-bl-4xl lg:rounded-tr-4xl shadow-black border-3 bg-white border-[#b1b2b5FF] aspect-3/4 w-[20vw] max-w-80"
    >
      <!-- <Image
        src={walasImage as ImageMetadata}
        alt="Foto Wali Kelas"
        class="w-full h-full object-cover"
        sizes="192px"
      /> -->
    </div>
  </div>
  <FadeOverlay zIndex={10} />
  <WalasName
    name="Nurhadi Lubis"
    title="Wali Kelas XII A PPLG"
    className="z-10"
  />
  <section class="greeting h-full w-full justify-center relative z-0 mb-24">
    <div class="line-decor absolute inset-0 -z-10">
      <LineDecor
        left="-10%"
        width="120%"
        height="2vw"
        color="#b1b2b5"
        top="15%"
      />
      <LineDecor
        right="-72%"
        width="160%"
        height="2vw"
        color="#b1b2b5"
        top="20%"
        rotate="70deg"
        zIndex={-1}
      />
    </div>
    <div
      class="content relative grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 pt-54 w-full items-center"
    >
      {/* Kolom 1: Text Sambutan */}
      <div class="greeting-text z-10 w-full pl-4 sm:pl-8 lg:pl-22">
        <WalasGreeting
          className=""
          paragraphs={[
            "Assalamu'alaikum Wr. Wb.",
            "Tiada kata yang pantas diucapkan, kecuali kalimat syukur yang sangat dalam kepada Dzat Yang Maha Ghafur yaitu Allah SWT. Teriring Sholawat dan Salam kita sanjungkan kepada baginda alam Nabi Muhammad SAW. ",
            "Ya Abnaaiy wa banaaty….",
            "Bertemanlah dengan orang yang suka membela kebenaran. Dialah hiasan dikala kita senang dan perisai di waktu kita susah. Namun kita tidak akan pernah memiliki seorang teman, jika kita mengharapkan seseorang tanpa kesalahan. Karena semua manusia itu baik kalau kita bisa melihat kebaikannya dan menyenangkan kalau kita bisa melihat keunikannya tapi semua manusia itu akan buruk dan membosankan kalau kita tidak bisa melihat keduanya. Jadilah orang yang baik dan bermanfaat bagi orang lain.",
            "خري الناس أنفعهم للناس",
            `Camkan kata-kata ini :
`,
            `•	"Ilmu tentang suatu kehidupan hanya akan bisa didapat dengan menjalaninya"
`,
            `•	"Tidak seorang pun akan dapat membuatmu kecewa kecuali kamu sendiri yang mengizinkannya"
`,
            `•	"Hidup itu ibarat permainan sepak bola, Harus selalu bergerak dan menyerang serta bertahan agar kita bisa menang"
`,
            "Wassalamu'alaikum Wr. Wb.",
          ]}
        />
      </div>

      {/* Kolom 2: SVG Dekorasi */}
      <div
        class="decoration-svg
    relative
    order-2
    lg:order-none
    w-full
    flex
    items-center
    justify-center
    pr-0
    lg:pr-22
    py-10
    lg:py-22
    -z-0
    lg:z-0
    pointer-events-none"
