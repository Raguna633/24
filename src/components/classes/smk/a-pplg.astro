---
import { getEntry, getCollection } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import ClassHeroSection from "../ClassHeroSection.astro";
import StudentCard from "../../StudentCard.astro";
import NextClassesCTA from "../NextClassesCTA.astro";
import FadeOverlay from "../../FadeOverlay.astro";
import LineDecor from "../../LineDecor.astro";
import TefatieText from "./TefatieText.astro";
import TextCustom from "../../TextCustom.astro";
import StoryTextReveal from "../../sections/StoryTextReveal.astro";
import TextReveal from "../../animations/TextReveal.astro"
import tefaGroup from "../../../assets/pplg-group-tefa.webp";
import cppIcon from "../../../assets/cpp.svg";
import csharpIcon from "../../../assets/csharp.svg";
import jsIcon from "../../../assets/js.svg";
import unityIcon from "../../../assets/unity.svg";

import xpLogo from "../../../assets/windows-xp.svg";
import laptop from "../../../assets/35202481_laptop_cartoon_2.svg";
import grup from "../../../assets/pplg-group1.webp";

// Group 2 Assets
import logoMl from "../../../assets/logo-ml.svg";
import pplgGroup2 from "../../../assets/pplg-group2.jpg";
import jenggotFf from "../../../assets/jenggot-ff.svg";
import pramuka from "../../../assets/pramuka.svg";

import aPplgPattern from "../../../assets/a-pplg-pattern.svg?raw";

const classData = await getEntry('classes', 'a-pplg');
if (!classData) {
  throw new Error("Data kelas a-pplg tidak ditemukan di collection");
}
const classContent = classData.data;

const heroBg1 = typeof classContent.heroPhoto?.[0] === 'string' ? classContent.heroPhoto[0] : (classContent.heroPhoto?.[0] as any)?.src || '';
const heroBg2 = typeof classContent.heroPhoto?.[1] === 'string' ? classContent.heroPhoto[1] : (classContent.heroPhoto?.[1] as any)?.src || '';
const walasPic = typeof classContent.walasPhoto === 'string' ? classContent.walasPhoto : (classContent.walasPhoto as any)?.src || '';

// Ambil semua siswa kelas A PPLG dari collection
const allStudents = await getCollection('students', ({ data }) => data.kelas === 'A PPLG');
// Urutkan berdasarkan nama
allStudents.sort((a, b) => a.data.name.localeCompare(b.data.name));
---

<div class="overflow-x-hidden">
  <ClassHeroSection className={classContent.className} heroImageSrc={heroBg1} />

  <FadeOverlay connectorHeight="200" zIndex={10} translateY="-100%" />

  <StoryTextReveal
    walasImage={walasPic}
    walasName={classContent.walasName}
    walasTitle={`Wali Kelas XII ${classContent.className}`}
    topTexts={classContent.walasGreeting.topText}
    bottomTexts={classContent.walasGreeting.bottomText}
    bgImage={heroBg2}
    textColor="#2A358F"
  />

  <FadeOverlay />

  <section
    id="tefa-group-a-pplg"
    class="tefa-group relative z-0 flex w-screen h-screen min-h-screen overflow-hidden justify-center items-center"
  >
    <div
      class="tefa-group-container -z-10 flex flex-col justify-end items-center relative w-screen h-full max-h-216"
    >
      <div class="bg-[#3b507d] bg-cover absolute w-full h-full -z-10"></div>
      <div
        class="bg-[url(/assets/4854834.svg)] bg-cover absolute w-full h-[110%] bottom-0 opacity-20 -z-10"
      >
      </div>

      <!-- Floating Parallax Icons -->
      <div
        class="floating-icons absolute inset-0 z-20 pointer-events-none hidden sm:block"
      >
        <div
          class="parallax-wrap absolute top-[30%] lg:top-[35%] left-[10%] xl:left-[22%]"
          data-speed="-50"
        >
          <div class="animate-float-1">
            <img
              src={cppIcon.src}
              alt="C++"
              class="w-12 h-12 lg:w-16 lg:h-16 will-animate drop-shadow-[0_8px_8px_rgba(0,0,0,0.3)]"
            />
          </div>
        </div>
        <div
          class="parallax-wrap absolute top-[15%] lg:top-[25%] right-[20%] xl:right-[32%]"
          data-speed="-80"
        >
          <div class="animate-float-2">
            <img
              src={csharpIcon.src}
              alt="C#"
              class="w-14 h-14 lg:w-20 lg:h-20 will-animate drop-shadow-[0_8px_8px_rgba(0,0,0,0.3)]"
            />
          </div>
        </div>
        <div
          class="parallax-wrap absolute bottom-[40%] lg:bottom-[45%] right-[8%] xl:right-[15%]"
          data-speed="-30"
        >
          <div class="animate-float-3">
            <img
              src={jsIcon.src}
              alt="JS"
              class="w-16 h-16 lg:w-24 lg:h-24 will-animate drop-shadow-[0_8px_8px_rgba(0,0,0,0.3)]"
            />
          </div>
        </div>
        <div
          class="parallax-wrap absolute bottom-[15%] lg:bottom-[20%] right-[3%] xl:right-[10%]"
          data-speed="-110"
        >
          <div class="animate-float-4">
            <img
              src={unityIcon.src}
              alt="Unity"
              class="w-20 h-20 lg:w-28 lg:h-28 will-animate drop-shadow-[0_8px_8px_rgba(0,0,0,0.3)] opacity-70"
            />
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 w-screen h-fit absolute z-10">
        <div class="relative w-full h-full hidden lg:block quote-reveal will-animate z-10">
          <TextCustom
            maxWidth="clamp(18rem, 25vw, 38rem)"
            font="poppins"
            lineHeight="2.4"
            className="tracking-[1px] absolute top-[40%] justify-self-center -translate-x-[8%] font-bold text-shadow-lg/50"
            color="white"
            mode="text"
            align="left"
            paragraphs={[
              `“Learning to write programs stretches your mind, and helps you think better, creates a way of thinking about things that I think is helpful in all domains.”`,
              "– Bill Gates –",
            ]}
          />
          <TextCustom
            mode="code"
            className="opacity-30 code-ani-target will-animate"
            text={`
void main() async {
  WidgetsFlutterBinding.ensureInitialized();
  await initializeDateFormatting('id_ID', null);
  runApp(MyApp());
}

class splash_page extends StatefulWidget {
  const splash_page({super.key});

  @override
  State<splash_page> createState() => _splash_pageState();
}

class _splash_pageState extends State<splash_page> {
  @override
  void initState() {
    super.initState();
    Timer(Duration(seconds: 5), () {
      Navigator.pushReplacementNamed(context, '/home');
    });
}
          `}
          />
        </div>
        <div
          class="anchor relative flex justify-center tefa-group-content will-animate z-20 col-span-1 w-full mx-auto"
        >
          <TefatieText
            width="150%"
            className="absolute flex h-fit top-[6%]"
          />
        </div>
        <div class="w-full h-full hidden lg:block will-animate z-10">
          <TextCustom
            mode="code"
            className="opacity-30 code-ani-target will-animate"
            text={`
import MainLayout from "../../../layouts/MainLayout.astro";
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro";

export async function getStaticPaths() {
  return [
    { params: { jenjang: "smk", kelas: "xii-a-pplg" } },
    { params: { jenjang: "smk", kelas: "xii-b-apl" } },
    { params: { jenjang: "smk", kelas: "xii-c-apl" } },
    { params: { jenjang: "smk", kelas: "xii-d-mplb" } },
    { params: { jenjang: "sma", kelas: "xii-ipa-1" } },
    { params: { jenjang: "sma", kelas: "xii-ipa-2" } },
    { params: { jenjang: "sma", kelas: "xii-ipa-3" } },
    { params: { jenjang: "sma", kelas: "xii-ipa-4" } },
    { params: { jenjang: "sma", kelas: "xii-ips-1" } },
    { params: { jenjang: "sma", kelas: "xii-ips-2" } },
    { params: { jenjang: "sma", kelas: "xii-ips-3" } },
  ];
}

const { kelas } = Astro.params;
          `}
          />
        </div>
      </div>
      <div
        class="image-wrapper relative aspect-[4/3] w-full max-w-182 bottom-0 z-20 tefa-group-img will-animate overflow-hidden"
      >
        <Image
          src={tefaGroup as ImageMetadata}
          alt={"Tim Tefa Pertama :v"}
          sizes="(max-width: 768px) 100vw, 80vw"
          loading="lazy"
          decoding="async"
          quality={80}
          format="webp"
          class:list={"-bottom-10 relative object-cover w-full h-full drop-shadow-[4px_4px_4px_rgba(0,0,0,0.5)]"}
        />
      </div>
      <LineDecor
        width="120%"
        zIndex={1}
        height="4.5vw"
        color="#000"
        bottom="8%"
        className="opacity-50 absolute"
      />
    </div>
  </section>

  <FadeOverlay/>

  <div id="group-wrapper-a-pplg" class="group-wrapper w-screen h-screen overflow-hidden relative" style="clip-path: inset(0);">
    <div
      class="draw-svg-container absolute top-0 left-0 w-full h-[250vh] -z-10 pointer-events-none opacity-40 will-animate"
      set:html={aPplgPattern.replace("<svg ", "<svg preserveAspectRatio=\"xMidYMid slice\" ")}
    >
    </div>
    <section
      class="first-group absolute inset-0 flex flex-row gap-6 items-center justify-center w-screen h-screen p-8 mt-8 will-animate"
    >
      <div class="laptop-wrapper relative w-3/5">
        <img src={laptop.src} alt="Laptop" class="laptop-svg" />

        <div class="screen-area">
          <div class="screen-layer" id="boot-screen">
            <img src={xpLogo.src} alt="Windows XP" class="xp-logo" />
            <div class="loading-container">
              <div class="loading-bar"></div>
            </div>
          </div>

          <div class="screen-layer" id="welcome-screen">
            <div class="w-full h-[18%] bg-blue-800 absolute top-0"></div>
            <div class="welcome-text relative translate-x-1/2">welcome</div>
            <div class="w-full h-[18%] bg-blue-800 absolute bottom-0"></div>
          </div>

          <div class="screen-layer" id="desktop-screen">
            <div class="taskbar z-10">
              <div class="start-btn">
                <i
                  ><img
                    src={xpLogo.src}
                    alt="Start"
                    style="height:12px; margin-right:5px;"
                  /></i
                > start
              </div>
              <div class="system-tray">10:54 PM</div>
            </div>
            <div id="grup-anomali" class="z-0 w-full h-full overflow-hidden">
              <Image
                src={grup}
                width={480}
                height={480}
                alt="Bliss"
                class="w-full h-full object-contain"
              />
            </div>

            <div id="xp-notification" class="xp-notification">
              <div class="xp-notification-header">
                <span class="xp-notification-title">Seriusan?</span>
                <span class="xp-notification-close">×</span>
              </div>
              <div class="xp-notification-body">Anjay jadi wallpaper :v</div>
              <div class="xp-notification-pointer"></div>
            </div>
          </div>
        </div>
      </div>
      <div
        class="first-quote-wrapper quote-wrapper w-full lg:w-2/5 flex flex-col items-center gap-2 text-sm md:text-base lg:text-lg font-bold text-black tracking-wider md:tracking-widest pr-0 lg:pr-8"
      >
        <h2
          class="first-quote-reveal text-xl md:text-2xl lg:text-3xl text-shadow-lg font-medium leading-[1.6] tracking-wide text-black text-right pr-0 lg:pr-12 md:pr-8"
        >
          <TextReveal manualControl={true}>
            “We came with our own stories, brought together in one space, and
            shaped by the same time. Now our paths no longer run parallel, but
            every footprint we left behind will always be part of our life's
            journey.”
          </TextReveal>
        </h2>
      </div>
    </section>

    <section
      class="second-group absolute top-[150vh] left-0 flex items-center justify-center w-screen h-screen will-animate"
    >
      <div
        class="relative flex items-center justify-center w-[90%] md:w-[70%] max-w-4xl z-10 p-8"
      >
        <div
          class="group-photo-wrapper bg-white p-4 pb-12 md:p-6 md:pb-22 shadow-2xl relative w-full shrink-0 will-animate"
        >
          <Image
            src={pplgGroup2}
            alt="Group 2"
            class="w-full h-auto object-cover select-none border border-gray-100"
          />

          <img
            src={logoMl.src}
            alt="ML Logo"
            class="second-icon absolute -top-[12%] -left-[16%] w-[45%] md:w-[40%] -rotate-12 pointer-events-none drop-shadow-xl z-20 will-animate"
          />

          <img
            src={pramuka.src}
            alt="Pramuka"
            class="second-icon absolute -top-[5%] -right-[12%] w-[18%] md:w-[15%] rotate-12 pointer-events-none drop-shadow-xl z-20 text-[#3B4D7B] will-animate"
          />

          <img
            src={jenggotFf.src}
            alt="Jenggot FF"
            class="second-icon absolute top-[11%] left-[37%] w-[12%] pointer-events-none drop-shadow-md z-20 will-animate"
          />
        </div>
      </div>

      <div
        class="second-quote absolute bottom-[10%] left-[-5%] w-[110%] py-4 md:py-6 bg-[#3B4D7B] -rotate-3 z-30 flex items-center justify-center shadow-2xl border-y-2 border-[#2A358F] will-animate text-white font-medium text-xs sm:text-sm md:text-lg xl:text-xl tracking-wider px-10 text-center uppercase"
      >
        <p class="second-quote-reveal">
          "Always follow your heart. But don't forget to bring your brain along
          too."
        </p>
      </div>
    </section>
  </div>

  <FadeOverlay />

  <!-- ============================================================
    SECTION 6: Grid Siswa — Kenali satu per satu dari mereka
  ============================================================ -->
  <section
    class="students-section py-24 px-6 bg-[#f5f0ea]"
    aria-label={`Daftar siswa kelas ${classContent.className}`}
  >
    <div class="max-w-7xl mx-auto">

      <!-- Heading -->
      <div class="students-heading mb-16 text-center">
        <p class="text-[#2A358F]/50 text-sm tracking-[0.3em] uppercase mb-4 opacity-0 students-heading-label">
          Keluarga
        </p>
        <h2 class="text-5xl md:text-7xl font-bold text-[#2A358F] opacity-0 students-heading-title">
          {classContent.className}
        </h2>
        <p class="text-base text-gray-400 mt-4 opacity-0 students-heading-count">
          {allStudents.length} orang yang membentuk cerita ini
        </p>
      </div>

      <!-- Grid siswa: 2 kolom mobile, 3 tablet, 4 desktop -->
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
        {allStudents.map((student) => (
          <div class="student-card-wrapper opacity-0">
            <StudentCard
              name={student.data.name}
              slug={student.slug}
              photo={student.data.photo}
              quote={student.data.quote}
              class={student.data.kelas ?? ''}
            />
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ============================================================
    SECTION 7: NextClassesCTA — Masih ada cerita lain yang menunggu
  ============================================================ -->
  <NextClassesCTA
    prevClass={classContent.prevClass}
    nextClass={classContent.nextClass}
  />

  <style>
    body,
    html {
      overflow-x: hidden; /* Prevent horizontal scroll */
      max-width: 100vw;
    }
    body {
      @apply bg-[#f5f0eaff];
    }

    @keyframes float {
      0%,
      100% {
        transform: translateY(0);
      }
      50% {
        transform: translateY(-15px);
      }
    }

    .animate-float-1 {
      animation: float 4s ease-in-out infinite;
    }
    .animate-float-2 {
      animation: float 4.5s ease-in-out infinite 0.5s;
    }
    .animate-float-3 {
      animation: float 5s ease-in-out infinite 1s;
    }
    .animate-float-4 {
      animation: float 5.5s ease-in-out infinite 1.5s;
    }

    

    

    .greeting-text p {
      font-family: "Poppins", sans-serif;
      font-size: 1.125rem;
      line-height: 1.75rem;
      color: #000000dd;
      margin: auto;
      text-align: justify;
    }
    .decoration-svg svg {
      filter: drop-shadow(4px 4px 4px rgba(0, 0, 0, 0.2));
    }

    .fade {
      grid-row: 1 / 3;
      display: flex;
      flex-direction: column;
      align-items: center; /* VERTIKAL DI TENGAH PERPOTONGAN */
      justify-content: flex-start;
      pointer-events: none;
    }

    .fade-top {
      background: linear-gradient(
        to bottom,
        rgba(245, 240, 234, 0) 0%,
        rgba(245, 240, 234, 1) 70%
      );
    }

    .fade-bottom {
      background: linear-gradient(
        to top,
        rgba(245, 240, 234, 0) 0%,
        rgba(245, 240, 234, 1) 70%
      );
    }

    .fade-bottom,
    .fade-top {
      transform: translateY(-100%);
    }

    .logo-svg {
      position: absolute;
      left: 905px;
      top: 1008px;
      width: 351px;
      height: 371px;
    }

    .logo-container {
      width: 280px;
      margin: auto;
    }

    /* .logo-svg {
  width: 100px;
  height: auto;
} */

    .logo-path {
      fill-opacity: 0;
      stroke: currentColor;
      stroke-width: 8;
    }


    /* Kunci presisi ada di sini */
    .laptop-wrapper {
      position: relative;
      width: 90vw;
      max-width: 800px;
      aspect-ratio: 1 / 1; /* Menyelaraskan rasio dengan viewBox 600x600 */
      transform: translateX(-100%);
    }

    .laptop-svg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }

    /* Koordinat matematika dari viewBox SVG */
    .screen-area {
      position: absolute;
      left: 11.833%;
      top: 21.648%;
      width: 76.333%;
      height: 43.166%;
      z-index: 2; /* Memastikan layar HTML berada di atas SVG */
      background-color: #000;
      overflow: hidden;
    }

    /* --- Styling Internal Layar --- */
    .screen-layer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      opacity: 0;
      visibility: hidden; /* Disembunyikan dulu */
    }

    #boot-screen {
      background-color: #000;
      visibility: visible; /* Aktif pertama */
      opacity: 0;
    }

    .xp-logo {
      width: 120px;
      margin-bottom: 20px;
    }

    .loading-container {
      width: 100px;
      height: 8px;
      border: 1px solid #7b7b7b;
      border-radius: 3px;
      position: relative;
      overflow: hidden;
      background-color: #000;
    }

    .loading-bar {
      width: 20px;
      height: 100%;
      background-color: #2a22d3;
      position: absolute;
      left: -20px;
    }

    #welcome-screen {
      background-color: #5d7fb9;
      color: white;
    }

    .welcome-text {
      font-size: 24px;
      font-weight: bold;
      font-style: italic;
      margin-bottom: 5px;
    }

    .welcome-subtext {
      font-size: 16px;
    }

    #desktop-screen {
      /* Ganti dengan URL background Bliss XP */
      background-image: url("https://res.cloudinary.com/dhbps9kvp/image/upload/v1775903985/Bliss.png");
      background-size: cover;
      background-position: center;
      will-change: opacity;
    }

    .taskbar {
      position: absolute;
      bottom: 0;
      width: 100%;
      height: 25px;
      background: linear-gradient(
        to bottom,
        #245edb 0%,
        #3f8cf3 9%,
        #245edb 18%,
        #245edb 92%,
        #333 100%
      );
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .start-btn {
      background: linear-gradient(
        to bottom,
        #309923 0%,
        #3aab2f 10%,
        #309923 100%
      );
      color: white;
      font-weight: bold;
      font-style: italic;
      padding: 0 10px;
      height: 100%;
      display: flex;
      align-items: center;
      border-top-right-radius: 8px;
      border-bottom-right-radius: 8px;
      font-size: 12px;
      box-shadow: 2px 0 3px rgba(0, 0, 0, 0.3);
    }

    .system-tray {
      background-color: #0f8ddd;
      height: 100%;
      display: flex;
      align-items: center;
      padding: 0 10px;
      color: white;
      font-size: 10px;
      border-left: 1px solid #1178b6;
    }

    .grup-anomali img {
      position: relative;
      transform: translateY(100%);
      will-change: transform;
    }

    /* --- Windows XP Notification Billboard --- */
    .xp-notification {
      position: absolute;
      bottom: 30px; /* Di atas taskbar (25px) */
      right: 5px;
      width: 150px;
      background-color: #ffffe1;
      border: 1px solid #000;
      border-radius: 5px;
      padding: 6px 8px;
      font-family: "Tahoma", sans-serif;
      color: #000;
      box-shadow: 2px 2px 0 rgba(0, 0, 0, 0.2);
      z-index: 20;
      opacity: 0;
      visibility: hidden;
      transform: scale(0.8) translateY(10px);
      transform-origin: bottom right;
    }

    .xp-notification-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2px;
    }

    .xp-notification-title {
      font-weight: bold;
      font-size: 10px;
    }

    .xp-notification-close {
      font-size: 14px;
      color: #888;
      cursor: pointer;
      line-height: 1;
      font-weight: bold;
    }

    .xp-notification-close:hover {
      color: #ff0000;
    }

    .xp-notification-body {
      font-size: 10px;
      line-height: 1.2;
    }

    .xp-notification-pointer {
      position: absolute;
      bottom: -10px;
      right: 15px;
      width: 0;
      height: 0;
      border-left: 8px solid transparent;
      border-right: 8px solid transparent;
      border-top: 10px solid #000;
    }

    .xp-notification-pointer::after {
      content: "";
      position: absolute;
      top: -11px;
      left: -7px;
      width: 0;
      height: 0;
      border-left: 7px solid transparent;
      border-right: 7px solid transparent;
      border-top: 9px solid #ffffe1;
    }

    .group-wrapper {
      display: block; /* Change flex to block for stable pinning */
      position: relative;
      width: 100%;
    }

    .draw-svg-container :global(svg) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      object-repeat: no-repeat;
    }

    /* Padding between groups since we removed flex gap */
    .first-group,
    .second-group {
      margin-bottom: 200px;
    }

    /* Utility for scroll locking */
    :global(body.story-lock) {
      overflow: hidden !important;
      touch-action: none;
    }
  </style>

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";
    import { CSSPlugin } from "gsap/CSSPlugin";
    import { waitForLoading } from "../../../utils/loadingState";

    gsap.registerPlugin(ScrollTrigger, SplitText, CSSPlugin);

    document.addEventListener("astro:page-load", async () => {
      await waitForLoading();

      const tefaContainer = document.getElementById("tefa-group-a-pplg");
      const laptopContainer = document.getElementById("group-wrapper-a-pplg");
      
      if (!tefaContainer || !laptopContainer) return;

      let ctx = gsap.context(() => {
        const qTefa = gsap.utils.selector(tefaContainer);
        const qLaptop = gsap.utils.selector(laptopContainer);

        // Timeline for .tefa-group (Pinned)
        const tefaTl = gsap.timeline({
          scrollTrigger: {
            trigger: tefaContainer,
            start: "top top",
            end: "+=150%",
            pin: true,
            scrub: 1,
            anticipatePin: 1,
          }
        });

        tefaTl.from(qTefa(".tefa-group-img"), {
          opacity: 0, y: 150, duration: 1.5, ease: "power2.out"
        });

        tefaTl.from(qTefa(".tefa-group-content"), {
          opacity: 0, y: 50, duration: 1, stagger: 0.15, ease: "power3.out"
        }, "-=0.5");

        const quoteSplit = new SplitText(qTefa(".quote-reveal"), { type: "words" });
        tefaTl.from(quoteSplit.words, {
          opacity: 0, y: 20, duration: 0.8, stagger: 0.05, ease: "power2.out"
        }, "-=0.5");

        const parallaxWraps = gsap.utils.toArray<HTMLElement>(qTefa(".parallax-wrap"));
        const iconImages = parallaxWraps.map(wrap => wrap.querySelector("img")).filter(img => img);
        tefaTl.from(iconImages, {
          opacity: 0, scale: 0.2, rotation: () => gsap.utils.random(-45, 45), duration: 1.2, stagger: 0.15, ease: "back.out(1.5)"
        }, "-=0.5");

        const codeTargets = gsap.utils.toArray<HTMLElement>(qTefa(".code-ani-target"));
        codeTargets.forEach((target) => {
          const lines = target.querySelectorAll(".code-line");
          if (lines.length > 0) {
            tefaTl.from(lines, {
              opacity: 0, y: 10, stagger: 0.2, duration: 0.5, ease: "power2.out"
            }, "-=1.0");
          }
        });

        const totalDur = tefaTl.duration() || 4;
        parallaxWraps.forEach((wrap) => {
          const speed = parseFloat(wrap.dataset.speed || "-50");
          tefaTl.to(wrap, { y: speed, ease: "none", duration: totalDur }, 0);
        });

        gsap.set(qLaptop(".screen-layer"), { visibility: "visible" });
        gsap.set(qLaptop("#welcome-screen, #desktop-screen, #xp-notification"), { autoAlpha: 0 });
        gsap.set(qLaptop(".xp-notification"), { scale: 0.8, y: 10 });
        gsap.set(qLaptop("#grup-anomali img"), { y: "100%", autoAlpha: 0 });

        const storyTl = gsap.timeline({
          scrollTrigger: {
            trigger: laptopContainer,
            start: "top top",
            end: "+=150%",
            pin: true,
            scrub: 1,
            anticipatePin: 1,
          }
        });

        storyTl
          .to(qLaptop(".laptop-wrapper"), { transform: "translateX(0)", duration: 1.5, ease: "power2.out" })
          .to(qLaptop("#boot-screen"), { autoAlpha: 1, duration: 0.8 })
          .to(qLaptop(".loading-bar"), { x: 120, duration: 1, ease: "linear" })
          .to(qLaptop("#boot-screen"), { autoAlpha: 0, duration: 0.4, display: "none" })
          .to(qLaptop("#welcome-screen"), { autoAlpha: 1, duration: 0.4 }, "<")
          .to(qLaptop("#welcome-screen"), { autoAlpha: 1, duration: 1.0 })
          .to(qLaptop("#welcome-screen"), { autoAlpha: 0, duration: 0.4, display: "none" })
          .to(qLaptop("#desktop-screen"), { autoAlpha: 1, duration: 0.4 });

        storyTl.to(qLaptop("#grup-anomali img"), { y: 0, autoAlpha: 1, duration: 1.2, ease: "power2.out" });
        storyTl.from(qLaptop(".first-quote-wrapper"), { y: 30, opacity: 0, duration: 1, ease: "power2.out" });

        const firstQuoteLines = qLaptop(".first-quote-reveal .split-line-inner");
        if (firstQuoteLines.length > 0) {
          storyTl.to(firstQuoteLines, {
            y: "0%", autoAlpha: 1, duration: 1.2, stagger: 0.15, ease: "power4.out"
          }, "-=0.6");
        }

        const firstTextDuration = firstQuoteLines.length > 0 ? (1.2 + (Math.max(0, firstQuoteLines.length - 1) * 0.15)) : 1;
        storyTl.to(qLaptop("#xp-notification"), { autoAlpha: 1, scale: 1, y: 0, duration: 0.8, ease: "back.out(1.7)" }, "-=" + (firstTextDuration * 0.5));

        storyTl.to(qLaptop(".draw-svg-container, .first-group, .second-group"), {
          y: "-=150vh", duration: 2.5, ease: "power2.inOut",
        }, "+=0.3");

        storyTl.from(qLaptop(".second-group .group-photo-wrapper"), { opacity: 0, y: 100, rotation: -5, duration: 1.5, ease: "power2.out" });

        const secondIcons = qLaptop(".second-group .second-icon");
        if (secondIcons.length > 0) {
          storyTl.from(secondIcons, {
            opacity: 0, scale: 0.2, rotation: () => gsap.utils.random(-45, 45), duration: 1.2, stagger: 0.2, ease: "back.out(1.5)"
          }, "-=0.5");
        }

        storyTl.from(qLaptop(".second-quote"), { opacity: 0, y: 80, duration: 1, ease: "power3.out" });

        const secondQuoteSplit = new SplitText(qLaptop(".second-quote-reveal"), { type: "words" });
        if (secondQuoteSplit.words.length > 0) {
          storyTl.from(secondQuoteSplit.words, { opacity: 0, y: 20, duration: 0.8, stagger: 0.05, ease: "power2.out" }, "-=0.5");
        }

        const bgPaths = qLaptop(".draw-svg-container svg path, .draw-svg-container svg rect");
        bgPaths.forEach((path) => {
          const p = path as unknown as SVGGeometryElement;
          const length = (p instanceof SVGPathElement) ? p.getTotalLength() : 1000;
          const originalFill = p.style.fill || window.getComputedStyle(p).fill || "#BE9E84";

          gsap.set(p, {
            strokeDasharray: length + 2, strokeDashoffset: length + 2, fill: "none", stroke: originalFill, strokeWidth: 5,
          });

          const tl = gsap.timeline({
            scrollTrigger: {
              trigger: laptopContainer, start: "top 70%", end: "bottom 30%", scrub: 1,
            }
          });

          tl.to(p, { strokeDashoffset: 0, duration: 2, ease: "none" })
            .to(p, { fill: originalFill, duration: 1, ease: "power2.out" });
        });

        // SECTION 6: Animasi Grid Siswa
        const studentsSection = document.querySelector('.students-section');
        if (studentsSection) {
          const sq = gsap.utils.selector(studentsSection);
          gsap.set(sq('.students-heading-label, .students-heading-title, .students-heading-count'), { y: 30 });
          gsap.to(sq('.students-heading-label'), {
            opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
            scrollTrigger: { trigger: '.students-section', start: 'top 75%', once: true },
          });
          gsap.to(sq('.students-heading-title'), {
            opacity: 1, y: 0, duration: 1.2, ease: 'power4.out', force3D: true,
            scrollTrigger: { trigger: '.students-section', start: 'top 75%', once: true },
            delay: 0.15,
          });
          gsap.to(sq('.students-heading-count'), {
            opacity: 1, y: 0, duration: 0.8, ease: 'power2.out',
            scrollTrigger: { trigger: '.students-section', start: 'top 75%', once: true },
            delay: 0.3,
          });

          const studentCards = sq('.student-card-wrapper');
          gsap.set(studentCards, { y: 50 });
          studentCards.forEach((card, i) => {
            gsap.to(card, {
              opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', force3D: true,
              delay: (i % 4) * 0.08,
              scrollTrigger: { trigger: card, start: 'top 90%', once: true },
            });
          });
        }
      }, laptopContainer); // Parent set to the main container

      document.addEventListener("astro:before-swap", () => {
        ctx.revert();
      }, { once: true });

      setTimeout(() => ScrollTrigger.refresh(), 500);
    });
  </script>
</div>
