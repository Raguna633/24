---
// src/components/ui/MemoryCard.astro
import { Image } from "astro:assets";
import CloudinaryImage from "./ui/CloudinaryImage.astro";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  date: Date;
  excerpt: string;
  thumbnail: ImageMetadata | string;
  category: string;
  slug: string;
  featured?: boolean;
}

const {
  title,
  date,
  excerpt,
  thumbnail,
  category,
  slug,
  featured = false,
} = Astro.props;

// Format date ke bahasa Indonesia
const formattedDate = new Intl.DateTimeFormat("id-ID", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(date);

// Category colors
const categoryColors: Record<string, string> = {
  orientation: "bg-blue-100 text-blue-800",
  "study-tour": "bg-green-100 text-green-800",
  sports: "bg-red-100 text-red-800",
  cultural: "bg-purple-100 text-purple-800",
  academic: "bg-yellow-100 text-yellow-800",
  graduation: "bg-pink-100 text-pink-800",
  other: "bg-gray-100 text-gray-800",
};

const categoryColor = categoryColors[category] || categoryColors.other;
---

<article
  class={`
    card group cursor-pointer 
    ${featured ? "md:col-span-2 md:row-span-2" : ""}
  `}
>
  <a href={`/memories/${slug}`} class="block h-full">
    <div class="flex flex-col h-full">
      <!-- Image -->
      <div
        class={`
        relative overflow-hidden bg-gray-200
        ${featured ? "aspect-landscape" : "aspect-[4/3]"}
      `}
      >
        {
          typeof thumbnail === "string" && thumbnail.includes("res.cloudinary.com") ? (
            <CloudinaryImage
              src={thumbnail}
              alt={title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[400, 800, 1200]}
              loading="lazy"
            />
          ) : (
            <Image
              src={thumbnail as any}
              alt={title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              widths={[400, 800, 1200]}
              sizes={featured
                ? "(max-width: 768px) 100vw, 66vw"
                : "(max-width: 768px) 100vw, 33vw"}
              format="webp"
              quality={85}
              loading="lazy"
            />
          )
        }

        <!-- Category badge -->
        <div class="absolute top-4 left-4">
          <span
            class={`
            badge ${categoryColor} 
            shadow-md backdrop-blur-sm
          `}
          >
            {
              category
                .split("-")
                .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                .join(" ")
            }
          </span>
        </div>

        <!-- Featured badge -->
        {
          featured && (
            <div class="absolute top-4 right-4">
              <span class="badge bg-accent-500 text-white shadow-md">
                ⭐ Featured
              </span>
            </div>
          )
        }

        <!-- Gradient overlay -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/70
                    via-black/20 to-transparent opacity-60
                    group-hover:opacity-80 transition-opacity duration-300"
        >
        </div>

        <!-- Date badge (bottom) -->
        <div class="absolute bottom-4 left-4">
          <div class="flex items-center gap-2 text-white">
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
            <span class="text-sm font-medium">
              {formattedDate}
            </span>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class={`p-4 flex-1 flex flex-col ${featured ? "md:p-6" : ""}`}>
        <h3
          class={`
          font-heading font-bold text-gray-900 mb-2
          group-hover:text-primary-600 transition-colors
          ${featured ? "text-xl md:text-2xl" : "text-lg"}
        `}
        >
          {title}
        </h3>

        <p
          class={`
          text-gray-600 line-clamp-3 flex-1
          ${featured ? "text-base" : "text-sm"}
        `}
        >
          {excerpt}
        </p>

        <!-- Read more link -->
        <div
          class="mt-4 flex items-center gap-2 text-primary-600
                    font-medium text-sm group-hover:gap-3
                    transition-all duration-200"
        >
          <span>Read More</span>
          <svg
            class="w-4 h-4 transform group-hover:translate-x-1
                   transition-transform"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </div>
      </div>
    </div>
  </a>
</article>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
