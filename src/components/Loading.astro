---
// Loading.astro
---

<script is:inline>
  /**
   * INSTANT INITIALIZATION
   * Blokir scroll dan paksa overlay muncul secepat mungkin 
   * sebelum script module (GSAP) selesai di-load.
   */
  (function() {
    const isNavigation = window.performance.getEntriesByType('navigation')[0].type === 'navigate';
    const isReload = window.performance.getEntriesByType('navigation')[0].type === 'reload';
    const overlay = document.getElementById('loading-overlay');
    
    // Hanya tampilkan overlay secara paksa jika ini adalah hard load pertama (bukan VT)
    // Untuk VT, kita biarkan logic di module script yang menanganinya via GSAP.
    if (overlay && (isNavigation || isReload) && !window.astroVTActive) {
      overlay.style.display = 'flex';
      overlay.style.opacity = '1';
      document.body.style.overflow = 'hidden';
    }
  })();
</script>

