<script>
  import gsap from "gsap";

  // =================================================================
  // KONFIGURASI: Halaman mana yang menggunakan Loading overlay
  //
  // Ubah daftar ini sesuai kebutuhan proyekmu.
  //
  // Dua strategi tersedia, aktifkan salah satu:
  //
  //   WHITELIST → Loading HANYA muncul saat navigasi KE halaman ini.
  //               Gunakan jika loading hanya cocok untuk beberapa halaman.
  //
  //   BLACKLIST → Loading TIDAK muncul saat navigasi KE halaman ini.
  //               Gunakan jika sebagian besar halaman pakai loading.
  //
  // Untuk matching:
  //   - String biasa  → exact match.      "/about" hanya cocok untuk /about
  //   - String dengan trailing slash "/"  → prefix match.
  //     "/classes/" cocok untuk /classes, /classes/sma, /classes/sma/xi-ipa-1
  // =================================================================

  const LOADING_CONFIG = {
    // Pilih strategi: "whitelist" atau "blacklist"
    strategy: "blacklist",

    // Daftar pathname yang menjadi acuan strategi di atas
    pages: [
      "/classes/smk/",
      "/classes/sma/",
      "/students/",
    ],
  };

  // =================================================================
  // FUNGSI HELPER: Cek apakah pathname cocok dengan daftar config
  //
  // Logika matching:
  //   - Jika entry diakhiri "/" → cek apakah pathname DIMULAI DENGAN entry itu
  //     Contoh: "/classes/" cocok dengan "/classes/sma" dan "/classes/sma/xi-ipa"
  //   - Jika tidak → exact match
  //     Contoh: "/teachers" hanya cocok dengan "/teachers" saja
  // =================================================================
  function isPageInList(pathname: string, pages: string[]): boolean {
    return pages.some((entry) => {
      if (entry.endsWith("/")) {
        // Prefix match: cocokkan semua sub-path di bawah entry ini
        return pathname === entry.slice(0, -1) || pathname.startsWith(entry);
        //     ↑ tangani juga "/classes" (tanpa trailing slash) agar tidak miss
      }
      // Exact match
      return pathname === entry;
    });
  }

  // =================================================================
  // FUNGSI UTAMA: Tentukan apakah Loading harus ditampilkan
  // berdasarkan pathname tujuan dan strategi yang dipilih
  // =================================================================
  function shouldShowLoading(destinationPathname: string): boolean {
    const isInList = isPageInList(destinationPathname, LOADING_CONFIG.pages);

    if (LOADING_CONFIG.strategy === "whitelist") {
      // Whitelist: tampilkan loading HANYA jika ada di daftar
      return isInList;
    } else {
      // Blacklist: tampilkan loading KECUALI jika ada di daftar
      return !isInList;
    }
  }

  // =================================================================
  // ANIMASI — sama seperti sebelumnya
  // =================================================================

  function resetSvgState() {
    gsap.set(".svg-path", { opacity: 0, y: 30, scale: 0.92, transformOrigin: "center bottom" });
    gsap.set("#svg-wrapper", { opacity: 0, scale: 0.85, transformOrigin: "center center" });
    gsap.set("#loading-logo-name", { y: 20, opacity: 0, letterSpacing: "4px" });
  }

  function playIntroAnimation(): Promise<void> {
    return new Promise((resolve) => {
      gsap.set("#loading-overlay", { display: "flex", opacity: 1 });

      const tl = gsap.timeline({ onComplete: resolve });
      tl
        .to("#svg-wrapper", { opacity: 1, scale: 1, duration: 0.6, ease: "back.out(1.4)" })
        .to(".svg-path", {
          opacity: 1, y: 0, scale: 1, duration: 0.5, ease: "power3.out",
          stagger: { each: 0.06, from: "start" },
        }, "<0.1")
        .to("#loading-logo-name", { y: 0, opacity: 1, letterSpacing: "12px", duration: 0.8, ease: "power2.out" }, "-=0.2")
        .to("#svg-wrapper", { scale: 1.05, duration: 0.8, ease: "power1.inOut", yoyo: true, repeat: 1 }, "+=0.3")
        .to("#loading-overlay", {
          opacity: 0, duration: 0.8, ease: "power2.inOut",
          onComplete: () => gsap.set("#loading-overlay", { display: "none" }),
        }, "+=0.5");
    });
  }

  function showLoadingOverlay(): Promise<void> {
    resetSvgState();
    return new Promise((resolve) => {
      gsap.set("#loading-overlay", { display: "flex", opacity: 0 });
      gsap.set("#svg-wrapper", { opacity: 1, scale: 1, transformOrigin: "center center" });
      gsap.set(".svg-path", { opacity: 1, y: 0, scale: 1 });
      gsap.set("#loading-logo-name", { opacity: 1, y: 0, letterSpacing: "12px" });

      const tl = gsap.timeline({ onComplete: resolve });
      tl
        .to("#loading-overlay", { opacity: 1, duration: 0.85, ease: "power2.inOut" })
        .fromTo("#svg-wrapper", { scale: 0.9 }, { scale: 1, duration: 0.85, ease: "back.out(1.2)" }, "<");
    });
  }

  function hideLoadingOverlay(): Promise<void> {
    return new Promise((resolve) => {
      const tl = gsap.timeline({
        onComplete: () => {
          gsap.set("#loading-overlay", { display: "none" });
          // Reset children ke initial state untuk animasi berikutnya
          resetSvgState();
          resolve();
        },
      });
      tl
        .to("#svg-wrapper", { scale: 0.9, opacity: 0.5, duration: 0.25, ease: "power2.in" })
        .to("#loading-overlay", { opacity: 0, duration: 0.4, ease: "power2.inOut" }, "-=0.1");
    });
  }

  // =================================================================
  // LIFECYCLE EVENTS
  // =================================================================

  let isFirstLoad = true;

  // First load: selalu jalankan intro (homepage selalu pakai loading)
  document.addEventListener("astro:page-load", async () => {
    if (isFirstLoad) {
      isFirstLoad = false;
      await playIntroAnimation();
    }
  });

  // =================================================================
  // Sebelum navigasi: cek dulu apakah halaman tujuan perlu loading.
  //
  // event.to → URL object halaman TUJUAN navigasi.
  // event.to.pathname → path-nya saja, misal "/classes/sma/xi-ipa-1"
  //
  // Kita simpan hasil pengecekan di flag `loadingTriggered` agar
  // astro:page-load tahu apakah perlu menjalankan hideLoadingOverlay
  // atau tidak — karena kedua event ini berjalan di callback terpisah.
  // =================================================================
  let loadingTriggered = false;

  document.addEventListener("astro:before-preparation", (event) => {
    const destination = (event as any).to as URL;
    const destinationPathname = destination.pathname;

    // Putuskan apakah perlu loading berdasarkan halaman tujuan
    loadingTriggered = shouldShowLoading(destinationPathname);

    if (!loadingTriggered) {
      // Tidak perlu loading — biarkan Astro View Transitions
      // menjalankan animasi fade bawaannya secara normal
      return;
    }

    // Perlu loading — override loader agar overlay tampil dulu
    const originalLoader = (event as any).loader;
    (event as any).loader = async () => {
      await Promise.all([showLoadingOverlay(), originalLoader()]);
    };
  });

  document.addEventListener("astro:page-load", async () => {
    if (isFirstLoad) return; // sudah ditangani oleh listener pertama

    if (loadingTriggered) {
      // Loading ditampilkan sebelumnya, sekarang sembunyikan
      await hideLoadingOverlay();
      loadingTriggered = false; // reset untuk navigasi berikutnya
    }
    // Jika loadingTriggered === false, tidak ada yang perlu dilakukan —
    // Astro sudah menyelesaikan fade transition-nya sendiri
  });
</script>

<style>

  #loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(135deg, #bfdbfe 0%, #3b507d 50%, #2A358F 100%);
    display: flex;
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    justify-content: center;
    font-family: "Michroma", sans-serif;
  }

  #svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 24px rgba(99, 211, 242, 0.4))
            drop-shadow(0 0 8px rgba(61, 179, 122, 0.25));
    opacity: 0;
    transform: scale(0.85);
    transform-origin: center center;
  }

  #loading-svg {
    height: 160px;
    width: 160px;
  }

  /*
    ✅ FIX FOUC: Semua path SVG dimulai invisible via CSS.
    GSAP hanya perlu menganimasikan dari state ini ke state akhir,
    tidak perlu lagi "mendahului browser" dengan gsap.set().
  */
  .svg-path {
    opacity: 0;
    transform-origin: center bottom;
  }

  .name-container {
    height: 34px;
    overflow: hidden;
  }

  /*
    ✅ FIX FOUC: Teks juga dimulai invisible + sedikit di bawah via CSS.
  */
  #loading-logo-name {
    color: #fff;
    font-size: 20px;
    text-transform: uppercase;
    margin-left: 20px;
    font-weight: bold;
    opacity: 0;
    transform: translateY(20px);
    letter-spacing: 4px;
  }
</style>

<style is:global>
  /* ============================================================
     GLOBAL STYLES — untuk View Transitions API pseudo-elements

     Kenapa harus is:global?
     ::view-transition-* adalah pseudo-elements yang dibuat oleh
     browser di luar DOM tree. Scoped CSS tidak bisa menjangkaunya.
     is:global memastikan rules ini masuk ke global stylesheet.

     Root cause flash:
     Browser's View Transitions API merender transisi di "top layer" —
     sebuah lapisan khusus yang posisinya DI ATAS semua z-index normal,
     termasuk z-index: 9999. Akibatnya:

     ::view-transition (top layer)
       ├── ::view-transition-group(root)        ← konten halaman
       └── ::view-transition-group(loading-overlay) ← overlay kita

     Secara default, browser menganimasikan SEMUA group ini dengan
     crossfade. Saat overlay di-crossfade, ia menjadi semi-transparan
     dan konten di bawahnya terlihat sebentar → inilah sumber flash.

     Fix: nonaktifkan animasi browser pada group overlay kita,
     dan pastikan ia selalu berada di atas group konten halaman.
     ============================================================ */

  /* 
    Suppress animasi browser pada overlay group.
    Tanpa ini, browser akan crossfade overlay saat navigasi,
    membuatnya semi-transparan dan menyebabkan flash.
  */
  ::view-transition-old(loading-overlay),
  ::view-transition-new(loading-overlay) {
    animation: none;
    mix-blend-mode: normal;
  }

  /*
    Pastikan overlay group selalu di atas group root (konten halaman).
    Di dalam konteks ::view-transition, z-index normal tidak berlaku —
    z-index harus di-set langsung pada ::view-transition-group.
  */
  ::view-transition-group(loading-overlay) {
    z-index: 9999;
  }
</style>