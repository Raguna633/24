<script>
  import gsap from "gsap";
  import { prepareLoading, completeLoading } from "../utils/loadingState";

  const LOADING_CONFIG = {
    strategy: "blacklist" as "whitelist" | "blacklist",
    pages: [],
  };

  // Diagnostic logger
  const log = (msg: string) => {
    console.log(`[Loading] ${new Date().toISOString().split('T')[1].split('.')[0]} - ${msg}`);
  };

  function isPageInList(pathname: string, pages: string[]): boolean {
    return pages.some((entry) => {
      if (entry.endsWith("/")) {
        return pathname === entry.slice(0, -1) || pathname.startsWith(entry);
      }
      return pathname === entry;
    });
  }

  function shouldShowLoading(destinationPathname: string): boolean {
    const isInList = isPageInList(destinationPathname, LOADING_CONFIG.pages);
    return LOADING_CONFIG.strategy === "whitelist" ? isInList : !isInList;
  }

  const MESSAGES: Record<string, string[]> = {
    "/": ["Mempersiapkan beranda...", "Menyusun kenangan...", "Sesaat lagi..."],
    "/classes": ["Menghubungi ruang kelas...", "Mengambil data siswa...", "Mempersiapkan absensi..."],
    "/gallery": ["Membuka album foto...", "Menata galeri seni...", "Memuat momen berharga..."],
    "default": ["Sedang memproses...", "Tunggu sebentar...", "Hampir siap..."]
  };

  function getMessageForPath(pathname: string): string {
    const key = Object.keys(MESSAGES).find(p => pathname.startsWith(p) && p !== "/") || (pathname === "/" ? "/" : "default");
    const options = MESSAGES[key] || MESSAGES["default"];
    return options[Math.floor(Math.random() * options.length)];
  }

  /**
   * REALTIME PROGRESS ENGINE
   * Membaca stream dari Response untuk menghitung progres
   */
  async function readResponseWithProgress(response: Response, onProgress: (p: number) => void): Promise<string> {
    const reader = response.body?.getReader();
    const contentLength = +(response.headers.get("Content-Length") ?? 0);

    if (!reader) return response.text();

    let receivedLength = 0;
    const chunks = [];
    
    // Inisialisasi simulasi jika Content-Length tidak ada (chunked encoding)
    let simulatedProgress = 0;
    const interval = !contentLength ? setInterval(() => {
      simulatedProgress += (95 - simulatedProgress) * 0.1;
      onProgress(simulatedProgress);
    }, 150) : null;

    try {
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        chunks.push(value);
        receivedLength += value.length;
        if (contentLength) {
          onProgress((receivedLength / contentLength) * 100);
        }
      }
    } finally {
      if (interval) clearInterval(interval);
    }

    const allChunks = new Uint8Array(receivedLength);
    let position = 0;
    for (const chunk of chunks) {
      allChunks.set(chunk, position);
      position += chunk.length;
    }
    return new TextDecoder("utf-8").decode(allChunks);
  }

  /**
   * ASSET TRACKING ENGINE
   * Mencari gambar di HTML baru dan memantau pemuatannya
   */
  async function trackAssets(html: string, baseUrl: string, onProgress: (p: number) => void) {
    const parser = new DOMParser();
    const doc = parser.parseFromString(html, "text/html");
    
    // Cari semua gambar dan resolusi URL relatifnya
    const images = Array.from(doc.querySelectorAll("img")).map(img => {
      const src = img.getAttribute("src");
      if (!src || src.startsWith("data:")) return null;
      try {
        return new URL(src, baseUrl).href;
      } catch {
        return src;
      }
    }).filter(Boolean) as string[];
    
    if (images.length === 0) {
      onProgress(100);
      return;
    }

    let loadedCount = 0;
    const uniqueImages = [...new Set(images)];
    log(`Tracking ${uniqueImages.length} assets for ${baseUrl}`);

    const promises = uniqueImages.map(src => {
      return new Promise((resolve) => {
        const img = new Image();
        img.onload = img.onerror = () => {
          loadedCount++;
          onProgress((loadedCount / uniqueImages.length) * 100);
          resolve(null);
        };
        img.src = src;
      });
    });

    // Timeout safety: Tunggu maksimal 10 detik untuk aset (lebih toleran terhadap koneksi lambat)
    await Promise.race([
      Promise.all(promises),
      new Promise(resolve => setTimeout(() => {
        log("Asset tracking timed out after 10s");
        resolve(null);
      }, 10000))
    ]);
  }

  function updateProgressBar(percent: number, duration: number = 0.4) {
    gsap.to("#loading-progress-bar", {
      scaleX: percent / 100,
      duration: duration,
      ease: "power1.out",
      overwrite: true
    });
  }

  function resetSvgState() {
    gsap.set(".loading", {
      opacity: 0,
      y: 30,
      scale: 0.5,
      rotation: () => Math.random() * 20 - 10,
      transformOrigin: "center center",
    });
    gsap.set("#svg-wrapper", {
      opacity: 0,
      scale: 0.85,
      transformOrigin: "center center",
    });
    gsap.set("#loading-status-text", { y: 20, opacity: 0, letterSpacing: "4px" });
    gsap.set("#loading-progress-bar", { scaleX: 0, transformOrigin: "left center" });
  }

  function playIntroAnimation(): Promise<void> {
    return new Promise((resolve) => {
      log("Playing intro animation");
      document.body.style.overflow = "hidden";
      if (window.lenis) window.lenis.stop();

      const statusText = document.getElementById("loading-status-text");
      if (statusText) statusText.innerText = "MEMULAI PENGALAMAN";

      gsap.set("#loading-overlay", { opacity: 1, display: "flex" });
      const tl = gsap.timeline({ onComplete: resolve });
      tl.to("#svg-wrapper", {
        opacity: 1,
        scale: 1,
        duration: 0.6,
        ease: "back.out(1.4)",
      })
        .to(
          ".loading",
          {
            opacity: 1,
            y: 0,
            scale: 1,
            rotation: 0,
            duration: 0.7,
            ease: "back.out(1.7)",
            stagger: { each: 0.08, from: "center" },
          },
          "<0.1",
        )
        .to(
          "#loading-status-text",
          {
            y: 0,
            opacity: 1,
            letterSpacing: "8px",
            duration: 0.8,
            ease: "power2.out",
          },
          "-=0.2",
        )
        .to("#loading-progress-bar", {
          scaleX: 1,
          duration: 1.2,
          ease: "power2.inOut"
        }, "-=0.4")
        .to(
          "#loading-overlay",
          {
            opacity: 0,
            duration: 0.8,
            ease: "power2.inOut",
            onComplete: () => {
              gsap.set("#loading-overlay", { display: "none" });
              document.body.style.overflow = "";
              if (window.lenis) window.lenis.start();
            },
          },
          "+=0.2",
        );
    });
  }

  function showLoadingOverlay(pathname: string = "/"): Promise<void> {
    log(`Showing overlay for ${pathname}`);
    resetSvgState();
    return new Promise((resolve) => {
      document.body.style.overflow = "hidden";
      if (window.lenis) window.lenis.stop();

      const statusText = document.getElementById("loading-status-text");
      if (statusText) statusText.innerText = getMessageForPath(pathname).toUpperCase();

      gsap.set("#loading-overlay", { display: "flex", opacity: 0 });
      gsap.set("#svg-wrapper", {
        opacity: 1,
        scale: 1,
        transformOrigin: "center center",
      });
      gsap.set(".loading", { opacity: 1, y: 0, scale: 1, rotation: 0 });
      gsap.set("#loading-status-text", {
        opacity: 1,
        y: 0,
        letterSpacing: "8px",
      });

      const tl = gsap.timeline({ onComplete: resolve });
      tl.to("#loading-overlay", {
        opacity: 1,
        duration: 0.4,
        ease: "power2.inOut",
      })
      .fromTo(
        "#svg-wrapper",
        { scale: 0.9 },
        { scale: 1, duration: 0.6, ease: "back.out(1.2)" },
        "<",
      );
    });
  }

  function hideLoadingOverlay(): Promise<void> {
    log("Hiding overlay");
    return new Promise((resolve) => {
      const tl = gsap.timeline({
        onComplete: () => {
          gsap.set("#loading-overlay", { display: "none" });
          document.body.style.overflow = "";
          if (window.lenis) window.lenis.start();
          resetSvgState();
          resolve();
        },
      });
      tl.to("#loading-progress-bar", {
        scaleX: 1,
        duration: 0.3,
        ease: "power2.out"
      })
      .to("#svg-wrapper", {
        scale: 0.9,
        opacity: 0,
        duration: 0.25,
        ease: "power2.in",
      }, "-=0.1")
      .to(
        "#loading-overlay",
        { opacity: 0, duration: 0.4, ease: "power2.inOut" },
        "-=0.1",
      );
    });
  }

  let isFirstLoad = true;
  let loadingTriggered = false;

  // Track if a View Transition is active globally
  (window as any).astroVTActive = false;

  prepareLoading();

  document.addEventListener("astro:page-load", async () => {
    if (isFirstLoad) {
      isFirstLoad = false;
      await playIntroAnimation();
      completeLoading();
    }
  });

  document.addEventListener("astro:before-preparation", (event) => {
    const destination = (event as any).to as URL;
    loadingTriggered = shouldShowLoading(destination.pathname);
    (window as any).astroVTActive = true;

    log(`before-preparation to ${destination.pathname}, loadingTriggered=${loadingTriggered}`);
    prepareLoading();

    if (!loadingTriggered) {
      const resolveAfterFade = () => {
        requestAnimationFrame(() => completeLoading());
      };
      document.addEventListener("astro:after-swap", resolveAfterFade, {
        once: true,
      });
      return;
    }

    const originalLoader = (event as any).loader;
    (event as any).loader = async () => {
      try {
        log("Executing custom loader...");
        const overlayPromise = showLoadingOverlay(destination.pathname);
        
        // DELEGATE TO ORIGINAL LOADER
        // Ini paling aman karena Astro mengelola headers/auth internal
        const response = await originalLoader();
        
        if (response instanceof Response) {
          log(`Response received: status=${response.status}, type=${response.type}`);
          
          // Clone response untuk dibaca progresnya
          const progressResponse = response.clone();

          // Phase 1: Download HTML (30%)
          const html = await readResponseWithProgress(progressResponse, (p) => {
            updateProgressBar(p * 0.3);
          });
          log(`HTML read complete (${html.length} bytes)`);

          // Phase 2: Track Assets (70%)
          await trackAssets(html, destination.href, (p) => {
            updateProgressBar(30 + (p * 0.7));
          });

          await overlayPromise;
          
          log("Returning response to Astro for swap");
          
          /**
           * CRITICAL: Kita kembalikan response BARU dari string HTML yang sudah dibaca.
           * Kita harus membersihkan headers 'content-encoding' karena body sekarang sudah didecode.
           * Jika headers lama dipertahankan, browser mungkin mencoba mendecode ulang (misal gzip)
           * terhadap string yang sudah plaintext, menyebabkan FOUC/Broken page.
           */
          const newHeaders = new Headers(response.headers);
          newHeaders.delete("content-encoding");
          newHeaders.delete("content-length"); // Biar browser hitung sendiri dari string
          
          return new Response(html, {
            status: response.status,
            statusText: response.statusText,
            headers: newHeaders
          });
        }
        
        log("Loader returned non-Response object, returning as is");
        return response;
      } catch (error) {
        log(`Custom loader error: ${error}`);
        return originalLoader();
      }
    };
  });

  document.addEventListener("astro:before-swap", () => {
    log("before-swap triggered");
  });

  document.addEventListener("astro:after-swap", () => {
    log(`after-swap triggered, current title: ${document.title}`);
  });

  document.addEventListener("astro:page-load", async () => {
    if (isFirstLoad) return;
    log(`page-load triggered, loadingTriggered=${loadingTriggered}`);

    if (loadingTriggered) {
      await hideLoadingOverlay();
      loadingTriggered = false;
      completeLoading();
    }
    (window as any).astroVTActive = false;
  });
</script>

<style>
  #loading-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(135deg, #bfdbfe 0%, #3b507d 50%, #2a358f 100%);
    display: flex; /* Changed from none to flex to prevent FOUC */
    flex-direction: column;
    gap: 2rem;
    align-items: center;
    justify-content: center;
    font-family: "Cinzel", serif;
  }

  #svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 0 24px rgba(99, 211, 242, 0.4))
      drop-shadow(0 0 8px rgba(61, 179, 122, 0.25));
    opacity: 0;
    transform: scale(0.85);
    transform-origin: center center;
  }

  #loading-svg {
    height: 180px;
    width: auto;
  }

  .loading {
    opacity: 0;
    transform-origin: center center;
  }

  .loading-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .name-container {
    height: 34px;
    overflow: hidden;
    display: flex;
    justify-content: center;
  }

  #loading-status-text {
    color: #fff;
    font-size: 16px;
    text-transform: uppercase;
    font-weight: 600;
    opacity: 0;
    transform: translateY(20px);
    letter-spacing: 4px;
    text-align: center;
    white-space: nowrap;
  }

  #loading-progress-container {
    width: 240px;
    height: 2px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  #loading-progress-bar {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #9D7434, #DBB363, #9D7434);
    transform: scaleX(0);
    transform-origin: left center;
  }
</style>

<style is:global>
  ::view-transition-old(loading-overlay),
  ::view-transition-new(loading-overlay) {
    animation: none;
    mix-blend-mode: normal;
  }

  ::view-transition-group(loading-overlay) {
    z-index: 9999;
  }
</style>
