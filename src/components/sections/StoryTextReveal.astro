---
import WalasName from "../classes/WalasName.astro";
import CloudinaryImage from "../ui/CloudinaryImage.astro";

/**
 * StoryTextReveal.astro
 * A premium storytelling component with a pinned background image,
 * radial/linear gradient overlay, and a ping-pong text reveal animation.
 */

interface Props {
  bgImage: string;
  gradientFrom?: string; // e.g. "rgba(245, 240, 234, 0.9)" (Vintage Beige)
  gradientTo?: string; // e.g. "rgba(245, 240, 234, 0.9)"
  gradientMiddle?: string; // e.g. "rgba(245, 240, 234, 0.9)"
  textColor?: string; // Tailwind class: text-black, text-accent, etc.
  textAlign?: string; // text-center, text-left, text-right
  topTexts: string[]; // Array of strings for top slot
  bottomTexts: string[]; // Array of strings for bottom slot
  walasImage?: string;
  walasName?: string;
  walasTitle?: string;
}

const {
  bgImage,
  gradientFrom = "rgba(245, 240, 234, 1)",
  gradientTo = "rgba(245, 240, 234, 1)",
  gradientMiddle = "rgba(245, 240, 234, 0.5)",
  textColor = "text-black",
  textAlign = "text-center",
  topTexts = [],
  bottomTexts = [],
  walasImage,
  walasName,
  walasTitle,
} = Astro.props;

---

<section class="story-reveal-section relative" data-story-reveal>
  <div
    class="sticky-inner sticky top-0 h-dvh w-full overflow-hidden flex flex-col items-center justify-between py-16 md:py-24"
  >
    <!-- Layer -1: Foundation Background -->
    <div class="absolute inset-0 -z-10 bg-[#f5f0ea]"></div>

    <!-- Layers 0 & 1: Background & Gradient Wrap -->
    <div class="bg-layer-wrap absolute inset-0 z-0">
      <div
        class="bg-image-inner absolute inset-0 z-0 bg-[#f5f0ea] will-animate image-container shimmer"
        style="transform-origin: right center;"
      >
        <CloudinaryImage
          src={bgImage}
          alt="Story Background"
          widths={[400, 800, 1200, 1920]}
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-full w-full object-cover opacity-80"
          onload="this.parentElement.classList.add('loaded')"
        />
        <div
          class="absolute inset-0 z-10 pointer-events-none"
          style={`background: linear-gradient(to bottom, ${gradientFrom} 0%, ${gradientMiddle} 50%, ${gradientTo} 100%)`}
        >
        </div>
      </div>
    </div>

    <!-- Layer 1.5: Walas Card -->
    {
      walasImage && walasName && walasTitle && (
        <div
          class="walas-card-wrapper absolute top-0 left-0 h-full flex flex-col justify-center bg-[#f5f0ea] z-10 will-animate shadow-[10px_0_20px_rgba(0,0,0,0.1)] pl-[clamp(1.5rem,3vw,4rem)] pr-[clamp(1.5rem,3vw,3rem)] pb-[clamp(1.5rem,3vw,4rem)] rounded-br-[clamp(2rem,6vw,8rem)] border-2 border-[#b1b2b5FF]"
          style="width: clamp(280px, 32vw, 450px);"
        >
          <div class="walas-photo rounded-lg w-full aspect-square overflow-hidden mb-6 relative z-10 image-container shimmer">
            <CloudinaryImage
              src={walasImage}
              alt={walasName}
              widths={[400, 800]}
              fetchpriority="high"
              loading="eager"
              decoding="async"
              class="top-0 w-full h-full object-cover aspect-square"
              onload="this.parentElement.classList.add('loaded')"
            />
          </div>
          <div class="walas-name-wrapper flex justify-center w-full z-10">
            <WalasName
              name={walasName}
              title={walasTitle}
              className="!relative !left-auto"
            />
          </div>
        </div>
      )
    }

    <!-- Layer 2: Content (Text Slots) -->
    <div
      class={`content-container absolute right-0 top-0 z-20 flex flex-col justify-around h-full px-8 ${textAlign} ${textColor}`}
      style="width: 65%;"
    >
      <!-- Top Slot -->
      <div
        class="top-text-container relative h-20 md:h-32 flex items-center justify-center"
      >
        {
          topTexts.map((text, i) => (
            <div
              class="top-text-item absolute inset-0 flex items-center justify-self-center opacity-0 invisible inline-block w-fit"
              data-top-item={i}
            >
              <h2 class="text-3xl tracking-tight leading-none px-4 drop-shadow-[0px_5px_10px_rgba(245,240,234,1)]">
                {text}
              </h2>
            </div>
          ))
        }
      </div>

      <!-- Bottom Slot -->
      <div
        class="bottom-text-container relative h-20 md:h-32 flex items-center justify-center"
      >
        {
          bottomTexts.map((text, i) => (
            <div
              class="bottom-text-item absolute inset-0 flex items-center justify-self-center opacity-0 invisible inline-block w-fit"
              data-bottom-item={i}
            >
              <h2 class="text-3xl tracking-tight leading-none px-4 drop-shadow-[0px_5px_10px_rgba(245,240,234,1)]">
                {text}
              </h2>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Ensuring the container stays sharp and the masks work */
  .story-reveal-section {
    will-change: transform;
  }

  .top-text-item,
  .bottom-text-item {
    will-change: transform, opacity;
  }

  .bg-image-inner,
  .walas-card-wrapper {
    will-change: transform, clip-path, opacity;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  /* Shimmer Preload Animation */
  .image-container {
    position: relative;
    background-color: #e5e7eb;
    overflow: hidden;
  }

  .image-container.shimmer::after {
    content: "";
    position: absolute;
    inset: 0;
    transform: translateX(-100%);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    animation: shimmer 1.5s infinite;
    z-index: 1;
  }

  .image-container.loaded::after {
    display: none;
  }

  .image-container img {
    opacity: 0;
    transition: opacity 0.8s ease-in-out;
  }

  .image-container.loaded img {
    opacity: 1;
  }

  @keyframes shimmer {
    100% {
      transform: translateX(100%);
    }
  }

  /* ============================================================
     📱 MOBILE RESPONSIVE — Hanya terpicu di viewport < 768px
     (Desktop Mode Android = 1440px → TIDAK terpengaruh)
     
     Strategi: Ubah layout dua-panel (card kiri + teks kanan)
     menjadi layout stacked vertikal:
       - Content text: full-width, posisi atas
       - Walas card: strip horizontal di bawah (foto kiri, nama kanan)
     
     CATATAN: GSAP xPercent animation TIDAK diubah.
     Card tetap bergerak masuk dari kiri (xPercent: -120 → 0),
     hanya ukuran & posisinya yang berubah via CSS.
  ============================================================ */
  @media (max-width: 768px) {
    /* === WALAS CARD: Panel kiri → Strip bawah horizontal === */
    .walas-card-wrapper {
      /* Override absolute: dari top-0 ke bottom-0 */
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      
      /* Full-width strip, tinggi auto */
      width: 100% !important;
      height: auto !important;
      
      /* Horizontal layout: foto kiri, info kanan */
      flex-direction: row !important;
      align-items: center !important;
      gap: 0.875rem;
      
      /* Visual: rounded hanya di atas, border bottom hilang */
      border-radius: 1rem 1rem 0 0 !important;
      border-bottom-right-radius: 0 !important;
      
      /* Padding lebih kompak untuk strip */
      padding: 0.75rem 1.25rem !important;
      padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px)) !important;
      
      /* Shadow ke atas */
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08) !important;
    }

    /* Foto walas: kotak kecil di kiri strip */
    .walas-photo {
      width: 64px !important;
      height: 64px !important;
      aspect-ratio: 1 / 1 !important;
      flex-shrink: 0 !important;
      margin-bottom: 0 !important;
      border-radius: 0.5rem !important;
    }

    /* Nama walas: rata kiri, truncate jika terlalu panjang */
    .walas-name-wrapper {
      justify-content: flex-start !important;
      flex: 1;
      min-width: 0;
      overflow: hidden;
    }

    /* === CONTENT CONTAINER: Full-width, beri ruang card di bawah === */
    .content-container {
      width: 100% !important;
      right: 0 !important;
      left: 0 !important;
      padding-left: 1.5rem !important;
      padding-right: 1.5rem !important;
      /* Ruang untuk walas strip: ~100px */
      padding-bottom: 100px !important;
      /* Override justify-around agar konten terpusat */
      justify-content: center !important;
      gap: 2rem;
    }

    /* Text item: font size lebih kecil di mobile */
    .top-text-item h2,
    .bottom-text-item h2 {
      font-size: clamp(1.2rem, 5vw, 2rem) !important;
      line-height: 1.3;
    }

    /* Text container: tinggi yang lebih kecil dan fleksibel */
    .top-text-container,
    .bottom-text-container {
      height: auto !important;
      min-height: 4rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { waitForLoading } from "../../utils/loadingState";

  const initStoryReveal = async () => {
    gsap.registerPlugin(ScrollTrigger, SplitText);

    const sections = document.querySelectorAll(
      "[data-story-reveal]:not(.is-initialized)",
    );
    if (sections.length === 0) return;

    // Workflow 03: Wait for Loader
    await waitForLoading();

    sections.forEach((section) => {
      section.classList.add("is-initialized");

      const topItems = section.querySelectorAll(".top-text-item");
      const bottomItems = section.querySelectorAll(".bottom-text-item");

      // Pre-split the text into words for smoother animation
      const topSplits = Array.from(topItems).map((item) => {
        const h2 = item.querySelector("h2");
        return h2
          ? new SplitText(h2, { type: "words", wordsClass: "split-word" })
          : null;
      });

      const bottomSplits = Array.from(bottomItems).map((item) => {
        const h2 = item.querySelector("h2");
        return h2
          ? new SplitText(h2, { type: "words", wordsClass: "split-word" })
          : null;
      });

      // Workflow 03: Ensure parents are visible so children's autoAlpha can work
      // Words will be hidden by the timeline's initial fromTo state
      gsap.set([topItems, bottomItems], { autoAlpha: 1 });

      const walasCard = section.querySelector(".walas-card-wrapper");
      const bgImageInner = section.querySelector(".bg-image-inner");

      if (walasCard) {
        gsap.set(walasCard, { xPercent: -120 });
      }

      const maxCount = Math.max(topItems.length, bottomItems.length);
      // Setiap elemen porsi kalimat ditambah proporsi scroll (misal: 40vh per pasang text + 100vh untuk background)
      const dynamicScroll = maxCount * 160 + 100;

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: "top top",
          end: "+=" + dynamicScroll + "dvh", // GSAP mengkalkulasi panjang scroll berdasarkan BANYAKNYA TULISAN secara dinamis!
          scrub: 2, // Smooth scrubbing
          pin: true, // GSAP menahan parent dan otomatis menambah pinSpacing (bantalan padding ideal)
          anticipatePin: 1,
        },
      });

      // Group: Intro Card & Background Reveal
      if (walasCard && bgImageInner) {
        tl.to(
          walasCard,
          {
            xPercent: 0,
            duration: 4,
            ease: "power2.out",
            force3D: true,
          },
          "intro",
        );

        tl.to(
          bgImageInner,
          {
            scale: 0.7, // Mengecilkan div secara proporsional dari kanan-tengah
            duration: 5,
            ease: "power2.out",
            force3D: true,
          },
          "intro",
        );
      }

      // Animation parameters
      const entryY = 40; // Further reduced for cleaner word-level look
      const exitY = -40;
      const entrySkew = 2;
      const exitSkew = -2;
      const duration = 1.2;
      const stagger = 0.05;
      const overlap = "-=0.6"; // Increased overlap for tighter word transitions

      // GROUPED PAIR SEQUENCE
      for (let i = 0; i < maxCount; i++) {
        const topWords = topSplits[i]?.words;
        const bottomWords = bottomSplits[i]?.words;

        // 1. EXIT PREVIOUS PAIR
        if (i > 0) {
          const prevTopWords = topSplits[i - 1]?.words;
          const prevBottomWords = bottomSplits[i - 1]?.words;
          const exitTargets = [];
          if (prevTopWords) exitTargets.push(prevTopWords);
          if (prevBottomWords) exitTargets.push(prevBottomWords);

          if (exitTargets.length > 0) {
            tl.to(
              exitTargets,
              {
                y: exitY,
                opacity: 0,
                skewY: exitSkew,
                autoAlpha: 0,
                duration: duration * 0.8,
                stagger: stagger * 0.5,
                ease: "power2.in",
              },
              "+=0.8",
            );
          }
        }

        // 2. ENTER CURRENT PAIR
        // Top enters first
        if (topWords) {
          tl.fromTo(
            topWords,
            { y: entryY, opacity: 0, skewY: entrySkew, autoAlpha: 0 },
            {
              y: 0,
              opacity: 1,
              skewY: 0,
              autoAlpha: 1,
              duration,
              stagger,
              ease: "power2.out",
            },
            i === 0 ? "+=0.2" : overlap,
          );
        }

        // Bottom follows shortly after
        if (bottomWords) {
          tl.fromTo(
            bottomWords,
            { y: entryY, opacity: 0, skewY: entrySkew, autoAlpha: 0 },
            {
              y: 0,
              opacity: 1,
              skewY: 0,
              autoAlpha: 1,
              duration,
              stagger,
              ease: "power2.out",
            },
            topWords ? "-=0.8" : i === 0 ? "+=0.2" : overlap,
          );
        }
      }

      tl.to({}, { duration: 1 });
    });
  };

  document.addEventListener("astro:page-load", initStoryReveal);
</script>
