---
import { Image } from "astro:assets";

const aboutBg =
  "https://res.cloudinary.com/dhbps9kvp/image/upload/l-banyakan.webp";
import CloudinaryImage from "../ui/CloudinaryImage.astro";
---

<section
  id="about-section"
  class="relative min-h-dvh h-full
          overflow-hidden"
>
  <!-- Background Image & Overlay -->
  {
    typeof aboutBg === "string" && aboutBg.includes("res.cloudinary.com") ? (
      <CloudinaryImage
        src={aboutBg}
        alt="About section background"
        class="absolute inset-0 w-full h-full object-cover z-0"
        widths={[1920, 2560]}
        loading="eager"
      />
    ) : (
      <Image
        src={aboutBg as any}
        alt="About Section Background"
        class="absolute inset-0 w-full h-full object-cover z-0 opacity-20"
        loading="eager"
        width={1920}
        height={1080}
        format="webp"
      />
    )
  }
  <div class="absolute inset-0 z-[2] bg-black/40 backdrop-blur-[2px]"></div>

  <!-- Decorative background elements -->
  <div class="absolute top-0 left-0 w-full h-full z-5">
    <div
      class="absolute top-10 left-10 w-32 h-32 bg-(--var-primary) rounded-full opacity-20 animate-pulse"
    >
    </div>
    <div
      class="absolute bottom-20 right-20 w-24 h-24 bg-accent-100 rounded-full opacity-30 animate-pulse"
      style="animation-delay: 1s;"
    >
    </div>
    <div
      class="absolute top-1/2 left-1/4 w-16 h-16 bg-secondary-200 rounded-full opacity-25 animate-pulse"
      style="animation-delay: 2s;"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 container-custom px-4 sm:px-6 lg:px-8 h-full flex items-center justify-center"
  >
    <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
      <!-- Who Us? Heading -->
      <h2
        class="font-heading font-bold text-white mb-0
               leading-tight"
        style="font-size: clamp(1rem, 4vw, 4rem);"
        data-about-animate
      >
        Who Us?
      </h2>

      <!-- Decorative line -->
      <div
        class="flex items-center justify-center gap-4 mb-6 sm:mb-10"
        data-about-animate
      >
        <div class="w-16 sm:w-24 h-px bg-[rgb(var(--color-primary))]"></div>
        <div class="w-3 h-3 bg-[rgb(var(--color-primary))] rounded-full"></div>
        <div class="w-16 sm:w-24 h-px bg-[rgb(var(--color-primary))]"></div>
      </div>

      <!-- About Paragraph -->
      <div class="space-y-4 sm:space-y-8 w-full max-w-4xl px-2">
        <p
          class="text-white leading-relaxed font-light mx-auto"
          style="font-size: clamp(0.8rem, 2vw, 1.8rem);"
          data-about-animate
        >
          Kami adalah Angkatan AZZARQO, generasi yang penuh semangat dan
          kreativitas. Dalam tiga tahun perjalanan bersama di bangku sekolah,
          kami telah menorehkan berbagai kenangan indah yang tak terlupakan.
        </p>

        <p
          class="text-white leading-relaxed mx-auto"
          style="font-size: clamp(0.7rem, 1.5vw, 1.5rem);"
          data-about-animate
        >
          Dari momen orientasi yang penuh kegembiraan, hingga acara pelepasan
          yang membanggakan, setiap langkah kami diisi dengan persahabatan
          sejati dan pengalaman berharga yang membentuk karakter kami menjadi
          lebih kuat dan bijak.
        </p>

        <p
          class="text-white italic leading-relaxed mx-auto"
          style="font-size: clamp(0.7rem, 1.5vw, 1.25rem);"
          data-about-animate
        >
          Yearbook ini adalah bentuk apresiasi kami terhadap masa-masa berharga
          ini, dan sebagai wadah untuk selalu terhubung meskipun waktu terus
          berjalan.
        </p>
      </div>

      <!-- Call to action hint -->
      <div class="mt-8 sm:mt-16" data-about-animate>
        <p
          class="text-[rgb(var(--color-primary))] font-medium text-xs sm:text-base"
        >
          Scroll ke bawah untuk melihat pesan dari guru-guru dan panitia kami
        </p>
        <div class="mt-4 animate-bounce">
          <svg
            class="w-6 h-6 mx-auto text-[rgb(var(--color-primary))]"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-about-animate] {
    opacity: 0;
    will-change: transform, opacity, filter;
  }
</style>

<script>
  import gsap from "gsap";
  import { waitForLoading } from "../../utils/loadingState";
  import { fadeUp } from "../../utils/gsap-animations";

  async function initAboutAnimations() {
    const section = document.getElementById("about-section");
    if (!section) return;

    await waitForLoading();

    // Helper: Split text into lines with BATHTED measurements to avoid layout thrashing
    const splitIntoLines = (container: HTMLElement) => {
      if (container.getAttribute("data-split") === "true") {
        return Array.from(container.querySelectorAll(".gsap-line-inner"));
      }
      container.setAttribute("data-split", "true");

      const text = container.innerText.trim();
      if (!text) return [];

      const words = text.split(/\s+/);
      container.innerHTML = "";

      // 1. Create all word spans first (DOM Phase)
      const wordSpans = words.map((word) => {
        const span = document.createElement("span");
        span.style.display = "inline-block";
        span.innerHTML = word + "&nbsp;";
        container.appendChild(span);
        return span;
      });

      // 2. Measure all offsetTops (Read Phase - this is the ONLY layout trigger)
      const measurements = wordSpans.map((span) => span.offsetTop);

      // 3. Batch words into lines (Logic Phase)
      let lines: HTMLSpanElement[][] = [];
      let currentLine: HTMLSpanElement[] = [];
      let currentTop: number | null = null;

      wordSpans.forEach((span, i) => {
        const top = measurements[i];
        if (currentTop === null || top > currentTop + 5) {
          currentTop = top;
          if (currentLine.length > 0) lines.push(currentLine);
          currentLine = [];
        }
        currentLine.push(span);
      });
      if (currentLine.length > 0) lines.push(currentLine);

      // 4. Wrap lines (Mutation Phase)
      container.innerHTML = "";
      const lineElements: HTMLElement[] = [];

      lines.forEach((line) => {
        const wrapper = document.createElement("div");
        wrapper.style.overflow = "hidden";
        wrapper.style.display = "block";

        const inner = document.createElement("div");
        inner.className = "gsap-line-inner";
        inner.style.display = "block";
        inner.style.willChange = "transform, opacity";

        line.forEach((span) => inner.appendChild(span));
        wrapper.appendChild(inner);
        container.appendChild(wrapper);
        lineElements.push(inner);
      });

      return lineElements;
    };

    // Detect if we are inside a Pinned Parallax Stack
    const parentStack = section.closest("[data-parallax-stack]");
    const isPinned = !!parentStack;

    // 1. Gather ALL elements and handle initial visibility
    const animateRoots = section.querySelectorAll("[data-about-animate]");
    let allElements: HTMLElement[] = [];

    animateRoots.forEach((el) => {
      // Make elements ready for GSAP but keep them invisible via lines
      gsap.set(el, { autoAlpha: 1 });

      if (el.tagName.toLowerCase() === "p") {
        const lines = splitIntoLines(el as HTMLElement);
        allElements.push(...(lines as HTMLElement[]));
      } else {
        allElements.push(el as HTMLElement);
      }
    });

    const sectionBg = section.querySelector("img") as HTMLElement;

    // 2. Initial state configuration
    if (allElements.length > 0) {
      // Ensure elements are at their "from" state immediately to avoid jumps
      gsap.set(allElements, {
        y: 40,
        opacity: 0,
        rotationX: 10,
        filter: "blur(8px)",
      });
    }

    return { allElements, sectionBg };
  }

  // Use page-load with proper lifecycle
  document.addEventListener("astro:page-load", () => {
    (window as any).aboutSectionPromise = initAboutAnimations();
  });
</script>
