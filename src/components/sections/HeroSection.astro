<style>
  /* Custom animations untuk hero */

  .animate-fade-in {
    animation: fade-in 1s ease-out;
  }

  .animate-slide-up {
    animation: slide-up 1s ease-out;
    animation-fill-mode: both;
  }

  #hero-section {
    font-family: "Cinzel", serif;
  }
  #logo-wrapper {
    opacity: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    border-radius: 100%;
    -webkit-tap-highlight-color: transparent;
  }

  /* supaya transform 3D bekerja halus */
  #logo {
    width: clamp(110px, 13vw, 280px);
    max-height: 460px;
    height: auto;
    transform-origin: 50% 50%;
    will-change: transform, opacity, filter;
    transition: transform 0.25s ease-out;
    perspective: 1200px; /* untuk parallax 3D */
    filter: drop-shadow(0 18px 3px rgba(5, 10, 20, 0.52));
    backface-visibility: hidden;
  }

  /* garis hasil clone (overlay) */
  #logo .gsap-outline {
    fill: none !important;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    mix-blend-mode: screen;
  }

  /* shimmer overlay */
  #logo .logo-shimmer {
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }

  /* reduced motion */
  @media (prefers-reduced-motion: reduce) {
    #logo {
      transition: none;
      filter: none;
    }
    /* disable gsap animations via attribute in JS as well */
  }

  #nama-angkatan {
    opacity: 0;
    pointer-events: none;
    text-shadow: 3px 6px 2px rgba(0, 0, 0, 0.5);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { waitForLoading } from "../../utils/loadingState";

  // Persistent controller for event listeners
  let heroCleanupController: AbortController | null = null;

  async function initHeroSection() {
    const section = document.querySelector("#hero-section") as HTMLElement;
    const svg = document.querySelector("#logo") as SVGElement;
    const wrapper = document.querySelector("#logo-wrapper") as HTMLElement;
    const txtAngkatan = document.querySelector("#nama-angkatan") as HTMLElement;

    if (!section || !svg || !wrapper) return;

    // Cleanup previous listeners if any
    if (heroCleanupController) heroCleanupController.abort();
    heroCleanupController = new AbortController();
    const { signal } = heroCleanupController;

    const contentElements = Array.from(section.querySelectorAll('[data-hero-animate]'));

    // const reduceMotion = window.matchMedia(
    //   "(prefers-reduced-motion: reduce)",
    // ).matches;

    const targets = Array.from(svg.querySelectorAll(".svg-path"));

    function makeOutline(el: Element) {
      const clone = el.cloneNode(true) as Element;
      clone.setAttribute(
        "class",
        (clone.getAttribute("class") || "") + " gsap-outline",
      );
      clone.removeAttribute("style");
      clone.setAttribute("fill", "none");

      const fill =
        el.getAttribute("fill") ||
        window.getComputedStyle(el).fill ||
        "#ffffff";
      let strokeColor = "#ffffff";
      try {
        if (fill && fill !== "none" && fill.startsWith("#")) {
          const c = fill.replace("#", "");
          if (c.length >= 6) {
            const r = parseInt(c.substring(0, 2), 16);
            const g = parseInt(c.substring(2, 4), 16);
            const b = parseInt(c.substring(4, 6), 16);
            const lum = 0.2126 * r + 0.7152 * g + 0.0722 * b;
            strokeColor = lum > 160 ? "#0a2130" : "#ffffff";
          }
        }
      } catch (e) {}
      clone.setAttribute("stroke", strokeColor);
      return clone as SVGGeometryElement;
    }

    // Process outlines BEFORE waiting for loading screen
    // This uses the "idle" time while loading to do heavy DOM work
    const outlines = targets.map((t) => {
      const el = t as SVGGeometryElement;
      el.style.opacity = "0";
      const out = makeOutline(el);
      let len = 0;
      try {
        len = out.getTotalLength();
      } catch (e) {
        len = 1200;
      }
      out.style.strokeDasharray = `${len} ${len}`;
      out.style.strokeDashoffset = len.toString();
      out.style.opacity = "1";
      svg.appendChild(out); 
      return { el, outline: out, len };
    });

    // NOW wait for the loading screen to finish
    await waitForLoading();

    gsap.set(wrapper, { opacity: 1 });

    const tl = gsap.timeline({
      defaults: { ease: "power2.out", force3D: true },
    });

    // if (reduceMotion) {
    //   outlines.forEach((o) => {
    //     gsap.set(o.outline, { opacity: 0 });
    //     gsap.set(o.el, { opacity: 1 });
    //   });
    //   gsap.set(txtAngkatan, { opacity: 1 });
    //   return;
    // }

    // Entry Animations
    tl.fromTo(
      svg,
      { scale: 0.86, rotation: -2, autoAlpha: 0 },
      {
        scale: 1,
        rotation: 0,
        autoAlpha: 1,
        duration: 0.9,
        ease: "back.out(1.4)",
      },
      0,
    );

    // Liquid Draw Animation (Point 1): Sort by length
    const sorted = outlines.slice().sort((a, b) => b.len - a.len);
    const drawStagger = 0.06;
    sorted.forEach((o, i) => {
      tl.to(
        o.outline.style,
        { strokeDashoffset: 0, duration: Math.min(0.9 + o.len / 2500, 1.8) },
        i * drawStagger + 0.12,
      );
      tl.to(o.el, { opacity: 1, duration: 0.45 }, i * drawStagger + 0.35);
      tl.to(
        o.outline,
        { opacity: 0, duration: 0.6, ease: "power2.inOut" },
        i * drawStagger + Math.min(0.7 + o.len / 3000, 1.2),
      );
    });

    tl.to(svg, { y: -6, duration: 0.25, ease: "power1.out" }, "-=0.2").to(svg, {
      y: 0,
      duration: 0.6,
      ease: "elastic.out(1, 0.6)",
    });

    if (txtAngkatan) {
      const text = txtAngkatan.textContent?.trim();
      txtAngkatan.innerHTML = ""; // Use innerHTML to clear

      const fragment = document.createDocumentFragment();
      const chars = text.split("").map((char) => {
        const span = document.createElement("span");
        span.textContent = char === " " ? "\u00A0" : char;
        span.style.opacity = "0";
        span.style.filter = "blur(12px)";
        span.style.display = "inline-block";
        span.style.willChange = "transform, opacity, filter";
        fragment.appendChild(span);
        return span;
      });
      txtAngkatan.appendChild(fragment);
      gsap.set(txtAngkatan, { opacity: 1, filter: "none" });

      tl.to(
        chars,
        {
          opacity: 1,
          filter: "blur(0px)",
          duration: 1.2,
          ease: "power2.out",
          stagger: 0.15,
        },
        1,
      );
    }

    // --- Infinite Animations Context ---
    let ambientTl = gsap.timeline();
    const ambientCtx = gsap.context(() => {
        // Individual repeats for different durations
        ambientTl.to(svg, {
          y: 8,
          x: 4,
          rotationZ: 2,
          duration: 4,
          repeat: -1,
          yoyo: true,
          ease: "sine.inOut",
          delay: 0.6,
          force3D: true,
        }, 0);

        // Dynamic Gradient Shimmer
        // Robust Hardware Detection (Independent of forced desktop resolution)
        const isMobileHardware = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || 
                                 (navigator.maxTouchPoints > 0) ||
                                 window.matchMedia("(pointer: coarse)").matches;
        const isMobile = isMobileHardware;
        
        const gradients = svg.querySelectorAll("linearGradient");
        gradients.forEach((grad, i) => {
            if (isMobile && i % 3 !== 0) return; 

            ambientTl.to(grad, {
                attr: { x1: "+=10", x2: "+=10" },
                duration: 3 + Math.random() * 2,
                repeat: -1,
                yoyo: true,
                ease: "sine.inOut"
            }, 0);
        });
    }, wrapper);

    // Mouse parallax
    if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      wrapper.style.transformStyle = "preserve-3d";
      wrapper.addEventListener(
        "pointermove",
        (e) => {
          const rect = wrapper.getBoundingClientRect();
          const dx = (e.clientX - (rect.left + rect.width / 2)) / rect.width;
          const dy = (e.clientY - (rect.top + rect.height / 2)) / rect.height;
          gsap.to(svg, {
            rotationX: -dy * 6,
            rotationY: dx * 6,
            x: dx * 8,
            y: dy * 8,
            transformPerspective: 1200,
            duration: 0.6,
            ease: "power3.out",
          });
        },
        { signal },
      );

      wrapper.addEventListener(
        "pointerleave",
        () => {
          gsap.to(svg, {
            rotationX: 0,
            rotationY: 0,
            x: 0,
            y: 0,
            duration: 0.8,
            ease: "power3.out",
          });
        },
        { signal },
      );
    }

    // Intersection Observer to pause when not visible
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                // console.log("Hero Visible: Resuming Ambient");
                ambientTl.resume();
            } else {
                // console.log("Hero Hidden: Pausing Ambient");
                ambientTl.pause();
            }
        });
    }, { threshold: 0.05 });
    observer.observe(wrapper);
    
    const cleanup = () => {
        observer.disconnect();
        ambientCtx.revert();
        ambientTl.kill();
    };
    signal.addEventListener('abort', cleanup);

    // console.log("HeroSection Init: Ambient Timeline Created");
  

    return { 
        svg, 
        txtAngkatan,
        contentElements,
        pauseAmbient: () => {
            // console.log("Manual Pause Called");
            ambientTl.pause();
        },
        resumeAmbient: () => {
            // console.log("Manual Resume Called");
            ambientTl.resume();
        }
    };
  }

  document.addEventListener("astro:page-load", () => {
    // console.log("Astro Page Load: Initializing Hero");
    (window as any).heroSectionPromise = initHeroSection();
  });
  document.addEventListener("astro:before-swap", () => {
    if (heroCleanupController) heroCleanupController.abort();
  });
</script>
