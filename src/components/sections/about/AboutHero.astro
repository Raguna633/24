---
import CloudinaryImage from "../../ui/CloudinaryImage.astro";

interface Props {
  title: string;
  imageBackgroundSrc: string;
  visi: string;
  misi: string;
}

const { title, imageBackgroundSrc, visi, misi } = Astro.props;
---

<section
  class="about-hero-section w-full h-dvh relative overflow-hidden bg-[#f5f0eaff] box-border"
>
  <div class="relative w-full h-full">
    <!-- Teks Raksasa Tengah (Temporer) -->
    <div
      class="about-hero-center-text absolute inset-0 z-40 flex flex-col items-center justify-center pointer-events-none opacity-0 will-animate px-4 sm:px-12"
    >
      <h2
        class="text-[#2A358F] font-bold text-[clamp(2.5rem,6vw,6rem)] leading-none tracking-widest text-center"
        style="font-family: 'qontra', sans-serif;"
      >
        ~ PONDOKKU ~
      </h2>
    </div>
    
    <!-- Visi Misi Container (Muncul setelah transisi) -->
    <div
    class="about-hero-content absolute bottom-0 left-0 w-full z-30 flex flex-col items-center justify-end pb-24 px-6 md:px-24 opacity-0 will-animate translate-y-10"
    >
    <div class="max-w-4xl text-center space-y-6 drop-shadow-lg">
        <h2
          class="text-[#f5f0ea] font-bold text-[clamp(2rem,6vw,4rem)] leading-none tracking-widest text-center"
          style="font-family: 'qontra', sans-serif;"
        >
          {title}
        </h2>
        <div class="bg-[#2A358F]/80 backdrop-blur-sm px-6 py-4 rounded-xl border border-white/20">
          <h3 class="text-[#f5f0ea] text-xl md:text-2xl font-bold tracking-widest mb-2 font-qontra">VISI</h3>
          <p class="text-[#f5f0ea]/90 text-sm md:text-lg italic">"{visi}"</p>
        </div>
        <div class="bg-[#2A358F]/80 backdrop-blur-sm px-6 py-4 rounded-xl border border-white/20">
          <h3 class="text-[#f5f0ea] text-xl md:text-2xl font-bold tracking-widest mb-2 font-qontra">MISI</h3>
          <p class="text-[#f5f0ea]/90 text-sm md:text-lg italic">"{misi}"</p>
        </div>
      </div>
    </div>

    <!-- Background Image -->
    <div class="hero absolute inset-0 z-10 w-full h-full">
      <div
        class="about-hero-image-wrapper relative w-full h-full overflow-hidden z-10 opacity-0 will-animate"
      >
        <CloudinaryImage
          src={imageBackgroundSrc}
          alt={`Background ${title}`}
          class="object-cover w-full h-full z-0 filter brightness-75"
          sizes="100vw"
          loading="eager"
        />
        <!-- Gradient Overlay untuk Visi Misi -->
        <div
          class="bg-gradient-to-t from-[#000000]/80 via-[#000000]/40 to-transparent h-2/3 absolute bottom-0 inset-x-0 w-full z-20 pointer-events-none"
        >
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { waitForLoading } from "../../../utils/loadingState";

  gsap.registerPlugin(SplitText);

  document.addEventListener("astro:page-load", async () => {
    const section = document.querySelector(".about-hero-section");
    const centerText = document.querySelector(".about-hero-center-text");
    const centerTextH2 = document.querySelector(".about-hero-center-text h2");
    const heroImageWrapper = document.querySelector(".about-hero-image-wrapper");
    const heroContent = document.querySelector(".about-hero-content");

    if (!section || !centerText || !centerTextH2 || !heroImageWrapper || !heroContent) return;

    // Cek preferensi animasi
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set([centerText, heroImageWrapper, heroContent], { opacity: 1, y: 0, scale: 1 });
      return;
    }

    // Split text untuk animasi kemunculan kata per kata atau karakter per karakter
    const splitCenterText = new SplitText(centerTextH2, {
      type: "chars, words",
    });

    // Setup Awal GSAP
    gsap.set(centerText, { opacity: 0 });
    gsap.set(splitCenterText.chars, { opacity: 0, y: 80, rotateX: -90 });
    // Mulai dari scale 1.05 untuk effect zoom out pada background
    gsap.set(heroImageWrapper, { opacity: 0, scale: 1.05 });
    // Visi Misi tersembunyi di bawah
    gsap.set(heroContent, { opacity: 0, y: 40 });

    // Tunggu overlay loading layar diturunkan
    await waitForLoading();

    // Mulai penganimasian
    const tl = gsap.timeline();

    // Skenario 1: Text reveal raksasa
    tl.to(centerText, { opacity: 1, duration: 0.1 });

    tl.to(splitCenterText.chars, {
      opacity: 1,
      y: 0,
      rotateX: 0,
      stagger: 0.03,
      duration: 1.2,
      ease: "back.out(1.5)",
      force3D: true,
    });

    // Jeda sejenak sebelum menghilang (The Hook)
    tl.to(
      splitCenterText.chars,
      {
        opacity: 0,
        scale: 1.3,
        y: -40,
        stagger: 0.02,
        duration: 0.6,
        ease: "power3.in",
        force3D: true,
      },
      "+=0.8",
    );

    // Skenario 2: Background Image Reveal
    tl.to(
      heroImageWrapper,
      {
        opacity: 1,
        scale: 1,
        duration: 1.8,
        ease: "power4.out",
        force3D: true,
        clearProps: "scale", // Bersihkan supaya saat diresize/normal tidak kacau
      },
      "-=0.2",
    );

    // Skenario 3: Visi Misi Muncul
    tl.to(
      heroContent,
      {
        opacity: 1,
        y: 0,
        duration: 1.2,
        ease: "power3.out",
        force3D: true,
      },
      "-=1.0"
    );
  });
</script>
