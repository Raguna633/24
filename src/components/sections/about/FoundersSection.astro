---
import CloudinaryImage from "../../ui/CloudinaryImage.astro";

interface Props {
  kepalaPimpinan: string;
  pimpinanPhoto: string;
  ibuPimpinan: string;
  ibuPimpinanPhoto: string;
}

const {
  kepalaPimpinan,
  pimpinanPhoto,
  ibuPimpinan,
  ibuPimpinanPhoto,
} = Astro.props;
---

<section class="founders-section w-full bg-[#f5f0eaff] py-24 md:py-32 relative overflow-hidden">
  <div class="max-w-[1920px] mx-auto px-6 md:px-12 lg:px-24">
    <!-- Judul Bagian -->
    <div class="text-center mb-20 will-animate opacity-0" data-animate-scroll>
      <h2 class="text-[#2A358F] font-bold text-3xl md:text-5xl tracking-wide mb-4 font-qontra">
        Pendiri Pondok Pesantren
      </h2>
      <div class="w-24 h-1 bg-[#2A358F] mx-auto rounded-full"></div>
    </div>

    <!-- Layout Desktop-First (Grid 2 Kolom) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      
      <!-- KH. Kamali Abdul Ghani -->
      <div class="founder-card flex flex-col items-center lg:items-end text-center lg:text-right will-animate opacity-0" data-animate-scroll>
        <div class="relative w-64 h-80 md:w-80 md:h-[26rem] mb-8 group overflow-hidden rounded-2xl md:rounded-[2.5rem] shadow-2xl">
          <CloudinaryImage
            src={pimpinanPhoto}
            alt={kepalaPimpinan}
            class="object-cover w-full h-full transition-transform duration-1000 group-hover:scale-105 filter sepia-[0.2]"
            sizes="(max-width: 768px) 100vw, 33vw"
          />
          <div class="absolute inset-0 bg-linear-to-t from-[#2A358F]/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
        </div>
        <h3 class="text-2xl md:text-4xl font-bold text-[#2A358F] mb-2 font-serif">{kepalaPimpinan}</h3>
        <p class="text-lg md:text-xl text-gray-700 italic font-light tracking-wider">Pimpinan Pondok Pesantren</p>
      </div>

      <!-- Ibu Hj. Ety Muflihah -->
      <div class="founder-card flex flex-col items-center lg:items-start text-center lg:text-left will-animate opacity-0" data-animate-scroll>
        <div class="relative w-64 h-80 md:w-80 md:h-[26rem] mb-8 group overflow-hidden rounded-2xl md:rounded-[2.5rem] shadow-2xl">
          <CloudinaryImage
            src={ibuPimpinanPhoto}
            alt={ibuPimpinan}
            class="object-cover w-full h-full transition-transform duration-1000 group-hover:scale-105 filter sepia-[0.2]"
            sizes="(max-width: 768px) 100vw, 33vw"
          />
          <div class="absolute inset-0 bg-linear-to-t from-[#2A358F]/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
        </div>
        <h3 class="text-2xl md:text-4xl font-bold text-[#2A358F] mb-2 font-serif">{ibuPimpinan}</h3>
        <p class="text-lg md:text-xl text-gray-700 italic font-light tracking-wider">Ibu Pimpinan Pondok Pesantren</p>
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { waitForLoading } from "../../../utils/loadingState";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", async () => {
    // Tunggu loading selesai agar animasi tidak mendahului
    await waitForLoading();

    // Cek preferensi animasi
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      gsap.set('[data-animate-scroll]', { opacity: 1, y: 0 });
      return;
    }

    // Ambil elemen
    const elements = document.querySelectorAll('.founders-section [data-animate-scroll]');
    
    // Set inisial
    gsap.set(elements, { opacity: 0, y: 50 });

    // Stagger animasi
    ScrollTrigger.batch(elements, {
      start: "top 85%",
      once: true,
      onEnter: (batch) => {
        gsap.to(batch, {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power3.out",
          stagger: 0.2,
          force3D: true,
        });
      }
    });
  });
</script>
