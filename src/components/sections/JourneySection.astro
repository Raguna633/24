---
import Image from "astro/components/Image.astro";
import CloudinaryImage from "../../components/ui/CloudinaryImage.astro";
---

<section
  class="relative py-20 sm:py-28 md:py-36 lg:py-44 overflow-hidden section-reveal"
>
  <div
    class="absolute inset-0 parallax-bg-wrapper bg-cover bg-center overflow-hidden h-full"
  >
    <CloudinaryImage
      src="https://res.cloudinary.com/dhbps9kvp/image/upload/v1775105102/ip3a.webp"
      widths={[1920, 2560]}
      alt="Background Image"
      class="parallax-bg-image w-full h-full object-cover scale-[1.3]"
      loading="lazy"
    />
  </div>
  <div
    class="absolute z-10 inset-0 bg-linear-to-b from-black/50 via-black/30 to-black/20"
  >
  </div>

  <!-- Animated background elements -->
  <div class="absolute inset-0">
    <!-- Floating geometric shapes -->
    <div
      class="gsap-journey-bg absolute top-20 left-10 w-32 h-32 bg-white/5 rounded-full opacity-0"
    >
    </div>
    <div
      class="gsap-journey-bg absolute bottom-32 right-16 w-24 h-24 bg-accent-300/20 rounded-full opacity-0"
    >
    </div>
    <div
      class="gsap-journey-bg absolute top-1/2 left-1/4 w-16 h-16 bg-white/10 rounded-full opacity-0"
    >
    </div>
    <div
      class="gsap-journey-bg absolute top-16 right-1/3 w-20 h-20 bg-primary-300/20 rounded-full opacity-0"
    >
    </div>

    <!-- Gradient mesh effect -->
    <div
      class="absolute inset-0 bg-linear-to-br from-accent-500/10 via-transparent to-primary-500/10"
    >
    </div>
  </div>

  <!-- Content Container -->
  <div
    class="relative z-10 container-custom px-4 sm:px-6 lg:px-8 text-center"
  >
    <!-- Main Heading -->
    <h2
      class="gsap-journey-text text-4xl sm:text-5xl md:text-6xl lg:text-7xl xl:text-8xl
             font-heading font-bold text-white mb-6 sm:mb-8 md:mb-10
             leading-tight"
    >
      Start Our
      <span class="block text-accent-200">Journey</span>
    </h2>

    <!-- Decorative elements -->
    <div
      class="gsap-journey-text flex items-center justify-center gap-6 mb-8 sm:mb-12"
    >
      <div class="w-20 sm:w-28 h-px bg-accent-300"></div>
      <div class="gsap-journey-pulse w-4 h-4 bg-accent-300 rounded-full"></div>
      <div class="w-20 sm:w-28 h-px bg-accent-300"></div>
    </div>

    <!-- Description -->
    <p
      class="gsap-journey-text text-lg sm:text-xl md:text-2xl lg:text-3xl text-white
             text-primary-100 max-w-3xl mx-auto mb-12 sm:mb-16
             leading-relaxed font-light"
    >
      Mari mulai perjalanan mengeksplorasi kenangan indah Angkatan Kita. Temukan
      profil teman-teman, galeri foto, dan timeline perjalanan kita bersama.
    </p>

    <!-- CTA Buttons -->
    <div
      class="flex flex-col sm:flex-row items-center justify-center
             gap-6 sm:gap-8"
    >
      <!-- Primary CTA -->
      <a
        href="/classes"
        class="gsap-journey-cta group relative inline-flex items-center gap-3
               px-8 sm:px-10 py-4 sm:py-5
               bg-white text-primary-700 font-bold text-lg sm:text-xl
               rounded-full shadow-2xl hover:shadow-3xl
               transform hover:-translate-y-1 transition-all duration-300
               overflow-hidden"
      >
        <!-- Button background effect -->
        <div
          class="absolute inset-0 bg-linear-to-r from-accent-400 to-accent-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300"
        >
        </div>

        <!-- Button content -->
        <span class="relative z-10">Explore Classes</span>
        <svg
          class="relative z-10 w-6 h-6 sm:w-7 sm:h-7 transform group-hover:translate-x-1 transition-transform duration-300"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
        </svg>
      </a>

      <!-- Secondary CTA -->
      <a
        href="/gallery"
        class="gsap-journey-cta group inline-flex items-center gap-3
               px-6 sm:px-8 py-3 sm:py-4
               border-3 border-white text-white font-semibold text-base sm:text-lg
               rounded-full hover:bg-white/10
               transform hover:scale-105 transition-all duration-300"
      >
        <svg
          class="w-5 h-5 sm:w-6 sm:h-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        View Gallery
      </a>
    </div>

    <!-- Quick Navigation -->
    <div class="mt-16 sm:mt-20 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
      <!-- Students -->
      <a
        href="/students"
        class="gsap-journey-card group p-6 bg-white/5 backdrop-blur-sm rounded-2xl
               border border-white/10 hover:bg-white/10
               transform hover:scale-105 transition-all duration-300"
      >
        <div
          class="w-12 h-12 sm:w-16 sm:h-16 mx-auto mb-4 bg-white/10 rounded-full flex items-center justify-center"
        >
          <svg
            class="w-6 h-6 sm:w-8 sm:h-8 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            ></path>
          </svg>
        </div>
        <h3 class="text-white font-semibold text-lg mb-2">Students</h3>
        <p class="text-white/70 text-sm">
          Kenali profil lengkap teman-teman angkatan
        </p>
      </a>

      <!-- Memories -->
      <a
        href="/memories"
        class="gsap-journey-card group p-6 bg-white/5 backdrop-blur-sm rounded-2xl
               border border-white/10 hover:bg-white/10
               transform hover:scale-105 transition-all duration-300"
      >
        <div
          class="w-12 h-12 sm:w-16 sm:h-16 mx-auto mb-4 bg-white/10 rounded-full flex items-center justify-center"
        >
          <svg
            class="w-6 h-6 sm:w-8 sm:h-8 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="text-white font-semibold text-lg mb-2">Memories</h3>
        <p class="text-white/70 text-sm">Timeline perjalanan 3 tahun kita</p>
      </a>

      <!-- Gallery -->
      <a
        href="/gallery"
        class="gsap-journey-card group p-6 bg-white/5 backdrop-blur-sm rounded-2xl
               border border-white/10 hover:bg-white/10
               transform hover:scale-105 transition-all duration-300"
      >
        <div
          class="w-12 h-12 sm:w-16 sm:h-16 mx-auto mb-4 bg-white/10 rounded-full flex items-center justify-center"
        >
          <svg
            class="w-6 h-6 sm:w-8 sm:h-8 text-white"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
        </div>
        <h3 class="text-white font-semibold text-lg mb-2">Gallery</h3>
        <p class="text-white/70 text-sm">
          Koleksi foto kegiatan dan momen berharga
        </p>
      </a>
    </div>

    <!-- Bottom decorative element -->
    <div class="gsap-journey-text mt-16 sm:mt-20">
      <div class="w-24 h-1 bg-accent-300 rounded-full mx-auto opacity-50"></div>
    </div>
  </div>
</section>

<style>
  /* Base styles replaced by GSAP */
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { waitForLoading } from "../../utils/loadingState";

  document.addEventListener("astro:page-load", async () => {
    await waitForLoading();
    
    const controller = new AbortController();
    const journeySection = document.querySelector(".section-reveal:has(.gsap-journey-text)") as HTMLElement;
    if (!journeySection) return;

    // Element selections
    const texts = journeySection.querySelectorAll(".gsap-journey-text");
    const pulseDot = journeySection.querySelector(".gsap-journey-pulse");
    const ctas = journeySection.querySelectorAll(".gsap-journey-cta");
    const cards = journeySection.querySelectorAll(".gsap-journey-card");
    const bgs = journeySection.querySelectorAll(".gsap-journey-bg");

    // Init state
    gsap.set(texts, { opacity: 0, y: 40 });
    gsap.set(ctas, { opacity: 0, scale: 0.9, y: 20 });
    gsap.set(cards, { opacity: 0, y: 50, rotationX: 10 });

    // 1. Entrance Timeline
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: journeySection,
        start: "top 80%",
        toggleActions: "play none none reverse",
        id: "journey-entrance"
      },
    });

    if (texts.length) {
      tl.to(texts, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        stagger: 0.15,
        ease: "power3.out",
        force3D: true
      });
    }

    // 2. Continuous pulse for the dot
    let pulseAnim: gsap.core.Tween | null = null;
    if (pulseDot) {
      pulseAnim = gsap.to(pulseDot, {
        scale: 1.4,
        opacity: 0.6,
        duration: 1.5,
        repeat: -1,
        yoyo: true,
        ease: "power1.inOut",
        paused: true,
        force3D: true
      });
    }

    // 3. Pop in buttons
    if (ctas.length) {
      tl.to(ctas, {
        opacity: 1,
        y: 0,
        scale: 1,
        stagger: 0.1,
        duration: 0.6,
        ease: "back.out(1.5)",
        force3D: true
      }, "-=0.4");
    }

    // 4. Stagger 3D-ish cards
    if (cards.length) {
      tl.to(cards, {
        opacity: 1,
        y: 0,
        rotationX: 0,
        transformPerspective: 800,
        duration: 0.8,
        stagger: 0.15,
        ease: "power2.out",
        force3D: true
      }, "-=0.3");
    }

    // 5. Ambient floating blobs
    let floatAnim: gsap.core.Tween | null = null;
    if (bgs.length) {
      tl.to(bgs, {
        opacity: 1,
        duration: 1.5,
        ease: "power2.inOut",
        force3D: true
      }, 0);

      floatAnim = gsap.to(bgs, {
        y: "random(-30, 30)",
        x: "random(-30, 30)",
        rotation: "random(-15, 15)",
        scale: "random(0.8, 1.2)",
        duration: 4,
        ease: "sine.inOut",
        yoyo: true,
        repeat: -1,
        stagger: { amount: 2, from: "random" },
        paused: true,
        force3D: true
      });
    }

    // ✅ CONSOLIDATED AMBIENT OPTIMIZATION
    // Use a single ScrollTrigger to control multiple looped animations
    ScrollTrigger.create({
      trigger: journeySection,
      start: "top bottom",
      end: "bottom top",
      id: "journey-ambient-controller",
      onEnter: () => {
        pulseAnim?.play();
        floatAnim?.play();
      },
      onLeave: () => {
        pulseAnim?.pause();
        floatAnim?.pause();
      },
      onEnterBack: () => {
        pulseAnim?.play();
        floatAnim?.play();
      },
      onLeaveBack: () => {
        pulseAnim?.pause();
        floatAnim?.pause();
      }
    });

    // Lifecycle cleanup
    document.addEventListener("astro:before-swap", () => {
      controller.abort();
      pulseAnim?.kill();
      floatAnim?.kill();
      ScrollTrigger.getById("journey-entrance")?.kill();
      ScrollTrigger.getById("journey-ambient-controller")?.kill();
    }, { once: true });
  });
</script>
