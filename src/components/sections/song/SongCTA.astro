---
// src/components/sections/song/SongCTA.astro
---

<section class="song-cta-section w-full py-32 md:py-48 relative overflow-hidden flex items-center justify-center border-t border-[#2A358F]/10">
  <!-- Elemen Dekoratif -->
  <div class="absolute inset-0 z-0 opacity-10 pointer-events-none flex items-center justify-center">
    <div class="w-96 h-96 rounded-full border border-[#2A358F] scale-150"></div>
    <div class="w-64 h-64 rounded-full border border-[#2A358F] absolute"></div>
  </div>

  <div class="relative z-10 text-center px-6 max-w-4xl will-animate opacity-0" data-animate-cta>
    <span class="block text-[#2A358F] font-qontra tracking-[0.3em] text-sm md:text-base mb-6">
      THE VISIONARIES
    </span>
    
    <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold text-[#2A358F] mb-12 font-serif leading-tight">
      Di Balik Setiap Cerita, <br/> Ada Mereka yang Merangkainya.
    </h2>

    <a 
      href="/yearbook-committee" 
      class="cta-button group relative inline-flex items-center justify-center px-12 py-5 text-lg font-bold text-[#f5f0ea] bg-[#2A358F] rounded-full overflow-hidden transition-transform hover:scale-105 active:scale-95"
    >
      <span class="absolute inset-0 w-full h-full bg-[#1b225c] origin-left scale-x-0 transition-transform duration-300 ease-out group-hover:scale-x-100 z-0"></span>
      <span class="relative z-10 tracking-widest flex items-center gap-3">
        LIHAT PANITIA BUKU TAHUNAN
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-hover:translate-x-2">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </span>
    </a>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { waitForLoading } from "../../../utils/loadingState";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", async () => {
    await waitForLoading();

    const ctaElement = document.querySelector('.song-cta-section [data-animate-cta]');
    if (!ctaElement) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      gsap.set(ctaElement, { opacity: 1, y: 0 });
      return;
    }

    gsap.set(ctaElement, { opacity: 0, y: 50 });

    gsap.to(ctaElement, {
      scrollTrigger: {
        trigger: ctaElement,
        start: "top 85%",
        once: true,
      },
      opacity: 1,
      y: 0,
      duration: 1.2,
      ease: "power3.out",
      force3D: true,
    });
  });
</script>
