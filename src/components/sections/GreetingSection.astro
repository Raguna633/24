---
// GreetingSection.astro - Carousel-optimized with better mobile scroll

import Copy from "../Copy.jsx";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import CloudinaryImage from "../../components/ui/CloudinaryImage.astro";

interface Props {
  layout: "teacher" | "generation";
  name: string;
  title: string;
  greeting: string;
  photo: string;
  backgroundImage: string;
  schoolLogo: string;
  disableBackground?: boolean;
  excerptLength?: number;
}

const {
  layout,
  name,
  title,
  greeting,
  photo,
  backgroundImage,
  schoolLogo,
  disableBackground = false,
  excerptLength = 300,
} = Astro.props;

const sectionId = `greeting-${name.toLowerCase().replace(/\s+/g, "-")}`;

const isTeacherLayout = layout === "teacher";
const flexDirection = isTeacherLayout ? "lg:flex-row-reverse" : "lg:flex-row";
const textAlign = isTeacherLayout ? "text-right" : "text-left";

const fadeDirection = isTeacherLayout
  ? `background: linear-gradient(to right,
            transparent,
            rgb(var(--color-primary) / 40%),
            rgb(var(--color-primary))
          );`
  : `background: linear-gradient(to left,
            transparent,
            rgb(var(--color-primary) / 40%),
            rgb(var(--color-primary))
          );`;

const overlayDirection = isTeacherLayout
  ? "bg-gradient-to-r from-black/50 via-black/30 to-black/20"
  : "bg-gradient-to-l from-black/50 via-black/30 to-black/20";
---

<section
  class="relative h-screen w-screen
         flex items-center overflow-hidden section-reveal shrink-0"
  data-greeting
  data-bg-image={backgroundImage}
>
  <!-- Background Image -->
  {
    !disableBackground && (
      <div class="absolute inset-0 parallax-bg-wrapper bg-cover bg-center bg-no-repeat overflow-hidden h-full w-full z-0">
        <CloudinaryImage
          src={backgroundImage}
          widths={[1920, 2560]}
          alt="Background Image"
          class="parallax-bg-image w-full h-full object-cover scale-[1.3]"
          loading="eager"
          decoding="async"
        />
        <div class={"absolute z-10 inset-0 bg-black/50"} />
        <div class="absolute z-20 inset-0" style={fadeDirection} />

        {isTeacherLayout && schoolLogo && (
          <div
            class="absolute aspect-square right-12 top-8 md:top-16 
                   md:right-38 lg:right-8 xl:right-16 w-[clamp(12rem,20vw,20rem)] p-3 z-30 opacity-55"
          >
            <CloudinaryImage
              src={schoolLogo}
              widths={[1920, 2560]}
              alt="School Logo"
              class="w-full h-full object-contain opacity-75"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
      </div>
    )
  }

  <!-- Content Container -->
  <div
    class="relative z-15 container-custom p-4 sm:p-6 lg:p-8 pb-4 lg:pb-8 w-full h-full flex flex-col justify-center"
  >
    <div
      class={`max-w-screen h-full max-h-full mx-4 md:mx-16 text-white flex flex-col lg:flex ${flexDirection} lg:items-center lg:gap-12 xl:gap-16`}
    >
      <!-- Image Float -->
      <div
        class="greeting-image-float relative mb-8 lg:mb-0 mx-auto lg:mx-0 w-[clamp(12rem,30vw,24rem)] shrink-0"
        data-layout={layout}
      >
        <div class="relative">
          <div class="aspect-3/4 overflow-hidden z-10">
            <CloudinaryImage
              src={photo}
              widths={[1920, 2560]}
              alt={`Photo of ${name}`}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>

          <div
            class="gsap-greeting-deco absolute -top-4 -left-4 w-8 h-8 bg-accent-300
                      rounded-full opacity-0"
          >
          </div>
          <div
            class="gsap-greeting-deco absolute top-1/2 -right-6 w-4 h-4 bg-white
                      rounded-full opacity-0"
          >
          </div>
        </div>
      </div>

      <!-- Text Content -->
      <div class={`${textAlign} flex-1 min-h-0 flex flex-col lg:block`}>
        <!-- Header -->
        <div class="space-y-3 mb-6 gsap-greeting-text shrink-0">
          <Copy blockColor="#fff" client:visible>
            <p
              class="text-[clamp(0.8rem,2vw,1rem)] font-medium text-accent-300 uppercase tracking-wider inline-block"
            >
              Sambutan
            </p>
          </Copy>

          <Copy blockColor="#fff" client:visible>
            <h2
              class="text-[clamp(1.6rem,5vw,3.75rem)]
                     font-heading font-bold leading-tight inline-block"
            >
              {name}
            </h2>
          </Copy>

          <Copy blockColor="#fff" client:visible>
            <h3
              class="text-[clamp(1rem,2.5vw,1.25rem)] font-medium
                     text-white/80 uppercase tracking-wide inline-block"
            >
              {title}
            </h3>
          </Copy>

          <div class="flex items-center gap-4 pt-2">
            <div class="w-12 sm:w-16 h-px bg-accent-300"></div>
            <div class="w-2 h-2 bg-accent-300 rounded-full"></div>
            <div class="w-12 sm:w-16 h-px bg-accent-300"></div>
          </div>
        </div>

        <!-- ✅ Greeting Text with Custom Native Scroll -->
        <div
          class="greeting-text-wrapper gsap-greeting-content relative flex-1 min-h-0 flex flex-col lg:block"
        >
          <!-- ✅ Scroll Container -->
          <div
            class="greeting-text-content
                      flex-1 min-h-0 lg:h-[50vh] xl:h-[55vh]
                      overflow-y-auto lg:pr-4
                      scrollbar-custom"
          >
            <!-- Quote Icon -->
            <svg
              class="w-10 h-10 md:w-12 md:h-12 text-accent-200/40 mb-4
                     float-left mr-4 mt-2"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
              ></path>
            </svg>

            <!-- Full Text directly -->
            {
              greeting.split(/\r?\n/).map((line) =>
                line.trim() ? (
                  <Copy blockColor="#fff" client:visible>
                    <p class="text-[clamp(0.8rem,2.5vw,1.5rem)] leading-relaxed text-white/90 italic text-justify mb-5 last:mb-0">
                      {line}
                    </p>
                  </Copy>
                ) : null,
              )
            }

            <!-- Scroll Hint -->
            <div class="scroll-hint">
              <svg
                class="w-5 h-5 animate-bounce"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
              <span class="text-xs">Scroll untuk baca lebih lanjut</span>
            </div>
          </div>

          <!-- Signature -->
          <div class={`shrink-0 pt-4 sm:pt-6 ${textAlign}`}>
            <div
              class="text-accent-200 font-medium text-[clamp(0.8rem,2vw,1.125rem)] inline-block"
            >
              <Copy blockColor="#fff" client:visible>
                — {name}
              </Copy>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating decorative elements -->
  <div
    class="gsap-floating-bg absolute top-10 left-10 w-3 h-3 bg-accent-300 rounded-full
              opacity-40"
  >
  </div>
  <div
    class="gsap-floating-bg absolute bottom-20 right-20 w-2 h-2 bg-white rounded-full
              opacity-50"
  >
  </div>
  <div
    class="gsap-floating-bg absolute top-1/3 right-10 w-1 h-1 bg-accent-200 rounded-full
              opacity-30"
  >
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { waitForLoading } from "../../utils/loadingState";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", async () => {
    await waitForLoading();
    // The script for button toggling is removed. No longer using Expand/Collapse.

    // 2. Standalone Vertical Text Scroller (For Greetings not in a HorizontalCarousel)
    const standaloneSections = document.querySelectorAll("[data-greeting]");

    standaloneSections.forEach((sec) => {
      if (sec.closest(".horizontal-scroll-container")) return;

      const txt = sec.querySelector(".greeting-text-content");
      if (!txt) return;

      // ✨ BEST PRACTICE: Jadikan kalkulasi overflow sebagai fungsi
      // agar bisa dipanggil ulang secara dinamis oleh invalidateOnRefresh
      const getOverflow = () =>
        Math.max(0, txt.scrollHeight - txt.clientHeight);

      if (getOverflow() > 10) {
        txt.style.overflowY = "hidden";
        txt.scrollTop = 0;

        const hint = sec.querySelector(".scroll-hint");
        if (hint) {
          hint.style.display = "flex";
          hint.style.opacity = "1";
        }

        gsap.to(txt, {
          // ✨ Perbaikan 1: Gunakan function () => agar dinamis saat resize
          scrollTop: () => getOverflow(),
          ease: "none",
          scrollTrigger: {
            trigger: sec,
            start: "top top",
            // ✨ Perbaikan 2: Rasio 3:1. Jarak pin = 3x jarak teks yang disembunyikan.
            // Ini akan membuat kecepatan scroll seragam dengan Carousel Greeting (lebih lambat & nyaman).
            end: () => `+=${getOverflow() * 3}`,
            pin: true,
            scrub: 1, // ✨ Perbaikan 3: Ubah ke angka (1) untuk smooth interpolating, redam efek kaku roda gesek mouse Desktop
            anticipatePin: 1,
            fastScrollEnd: true, // Menjaga jika discroll secara agresif
            invalidateOnRefresh: true, // Akan memicu getOverflow() ulang saat resize
          },
        });

        if (hint) {
          gsap.to(hint, {
            opacity: 0,
            ease: "power1.inOut",
            scrollTrigger: {
              trigger: sec,
              start: "top top",
              // Sesuaikan fade out agar lebih awal dari akhir pinning teks (separuhnya dari *3)
              end: () => `+=${getOverflow() * 1.5}`,
              scrub: 1, // Samakan scrubnya dengan teks di atas
              fastScrollEnd: true,
              invalidateOnRefresh: true,
            },
          });
        }
      }
    });

    // 3. ✨ AWWWARDS STYLE GSAP ENTRANCE ANIMATIONS ✨
    const sections = document.querySelectorAll("[data-greeting]");

    sections.forEach((sec) => {
      // Find elements inside this section
      const imageFloat = sec.querySelector(".greeting-image-float");
      const decos = sec.querySelectorAll(".gsap-greeting-deco");
      const textHeader = sec.querySelector(".gsap-greeting-text");
      const textContent = sec.querySelector(".gsap-greeting-content");
      const floatingBgs = sec.querySelectorAll(".gsap-floating-bg");

      // Set initial states hidden/shifted
      gsap.set(imageFloat, {
        filter: "blur(16px)",
        scale: 0.65,
        opacity: 0,
        rotationY: 15,
      });
      // gsap.set(textHeader, { opacity: 0, x: 50 }); // Diserahkan ke Copy.jsx
      gsap.set(textContent, { opacity: 0, y: 40 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: sec,
          start: "top 80%", // Triggers when section top hits 80% of viewport
          toggleActions: "play none none reverse",
        },
      });

      // 1. Animate Hero Image (pop and unblur)
      if (imageFloat) {
        tl.to(imageFloat, {
          filter: "blur(0px)",
          scale: 1,
          opacity: 1,
          rotationY: 0,
          duration: 1.2,
          ease: "back.out(1.4)",
          delay: 0.2,
          force3D: true, // Optimasi GPU (penting utuk animasi blur di mobile)
        });
      }

      // 2. Animate small decorations around image
      if (decos.length) {
        tl.to(
          decos,
          {
            opacity: 0.8,
            scale: 1,
            stagger: 0.2,
            duration: 0.8,
            ease: "elastic.out(1, 0.5)",
          },
          "-=0.8",
        );
      }

      // 3. Stagger in text headers from the side
      if (textHeader) {
        tl.to(
          textHeader,
          {
            opacity: 1,
            x: 0,
            duration: 1,
            ease: "power3.out",
          },
          "-=1.0",
        );
      }

      // 4. Fade up the main reading content
      if (textContent) {
        tl.to(
          textContent,
          {
            opacity: 1,
            y: 0,
            duration: 1,
            ease: "power2.out",
          },
          "-=0.6",
        );
      }

      // 5. Ambient floating background pulses loop
      // 🔥 OPTIMIZATION: Di-pause jika sedang tidak ada di viewport (menghemat baterai & frame budget Android)
      if (floatingBgs.length) {
        const pulseAnim = gsap.to(floatingBgs, {
          y: "random(-20, 20)",
          x: "random(-20, 20)",
          scale: "random(0.8, 1.2)",
          duration: 3,
          ease: "sine.inOut",
          yoyo: true,
          repeat: -1,
          force3D: true,
          stagger: {
            amount: 2,
            from: "random",
          },
        });

        ScrollTrigger.create({
          trigger: sec,
          start: "top bottom",
          end: "bottom top",
          onEnter: () => pulseAnim.play(),
          onLeave: () => pulseAnim.pause(),
          onEnterBack: () => pulseAnim.play(),
          onLeaveBack: () => pulseAnim.pause(),
        });
      }
    });
  });
</script>

<style>
  /* ===== Text Content ===== */
  .greeting-text-content {
    text-align: justify;
    hyphens: auto;
    position: relative;
  }

  @media (max-width: 768px) {
    .greeting-text-content {
      hyphens: none;

      /* ✅ Better scrollbar styling */
      padding-right: 8px;
    }
  }

  /* ===== Custom Scrollbar ===== */
  .scrollbar-custom {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  .scrollbar-custom::-webkit-scrollbar {
    width: 6px;
  }

  .scrollbar-custom::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  /* ===== Scroll Hint ===== */
  .scroll-hint {
    position: sticky;
    bottom: 0;
    left: 0;
    right: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;

    padding: 12px;
    margin-top: 16px;

    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.5));

    color: rgba(255, 255, 255, 0.7);
    text-align: center;

    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .scroll-hint.hidden,
  .scroll-hint.opacity-0 {
    opacity: 0;
  }

  /* ===== Float & Transitions ===== */
  .clear-both {
    clear: both;
  }

  .toggle-icon {
    transition: transform 0.3s ease;
  }

  svg.float-left {
    shape-outside: circle(50%);
  }

  .whitespace-pre-line {
    white-space: pre-line;
  }
</style>
