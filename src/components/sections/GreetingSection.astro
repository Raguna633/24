---
// GreetingSection.astro - Carousel-optimized with better mobile scroll

import BlockReveal from "../BlockReveal.astro";
import CloudinaryImage from "../../components/ui/CloudinaryImage.astro";

interface Props {
  layout: "teacher" | "generation";
  name: string;
  title: string;
  greeting: string;
  photo: string;
  backgroundImage: string;
  schoolLogo: string;
  disableBackground?: boolean;
  excerptLength?: number;
}

const {
  layout,
  name,
  title,
  greeting,
  photo,
  backgroundImage,
  schoolLogo,
  disableBackground = false,
} = Astro.props;

const sectionId = `greeting-${name.toLowerCase().replace(/\s+/g, "-")}`;

const isTeacherLayout = layout === "teacher";
const flexDirection = isTeacherLayout ? "lg:flex-row-reverse" : "lg:flex-row";
const textAlign = isTeacherLayout ? "text-right" : "text-left";

const fadeDirection = isTeacherLayout
  ? `background: linear-gradient(to right,
            transparent,
            rgb(var(--color-primary) / 40%),
            rgb(var(--color-primary))
          );`
  : `background: linear-gradient(to left,
            transparent,
            rgb(var(--color-primary) / 40%),
            rgb(var(--color-primary))
          );`;

const overlayDirection = isTeacherLayout
  ? "bg-linear-to-r from-black/50 via-black/30 to-black/20"
  : "bg-linear-to-l from-black/50 via-black/30 to-black/20";
---

<section
  class="relative h-screen w-screen
         flex items-center section-reveal shrink-0"
  data-greeting
  data-bg-image={backgroundImage}
>
  <!-- Background Image -->
  {
    !disableBackground && (
      <div class="absolute inset-0 parallax-bg-wrapper bg-cover bg-center bg-no-repeat overflow-hidden h-full w-full z-0">
        <CloudinaryImage
          src={backgroundImage}
          widths={[720, 1280]}
          alt="Background Image"
          class="parallax-bg-image w-full h-full object-cover scale-[1.3]"
          loading="lazy"
          decoding="async"
        />
        <div class={"absolute z-10 inset-0 bg-black/50"} />
        <div class="absolute z-20 inset-0" style={fadeDirection} />

        {isTeacherLayout && schoolLogo && (
          <div
            class="absolute aspect-square right-12 top-8 md:top-16 
                   md:right-38 lg:right-8 xl:right-16 w-[clamp(12rem,20vw,20rem)] p-3 z-30 opacity-55"
          >
            <CloudinaryImage
              src={schoolLogo}
              widths={[200]}
              alt="School Logo"
              class="w-full h-full object-contain opacity-75"
              loading="eager"
              fetchpriority="high"
              decoding="auto"
            />
          </div>
        )}
      </div>
    )
  }

  <!-- Content Container -->
  <div
    class="relative z-15 container-custom p-4 sm:p-6 lg:p-8 pb-4 lg:pb-8 w-full h-screen max-h-screen flex flex-col justify-center"
  >
    <div
      class={`max-w-screen h-full max-h-full mx-4 md:mx-16 text-white flex flex-col lg:flex ${flexDirection} lg:items-center lg:gap-12 xl:gap-16`}
    >
      <!-- Image Float -->
      <div
        class="greeting-image-float relative mb-8 lg:mb-0 mx-auto lg:mx-0 w-[clamp(12rem,30vw,24rem)] shrink-0"
        data-layout={layout}
      >
        <div class="relative">
          <div class="aspect-3/4 overflow-hidden z-10">
            <CloudinaryImage
              src={photo}
              widths={[600, 900]}
              alt={`Photo of ${name}`}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="auto"
            />
          </div>

          <div
            class="gsap-greeting-deco absolute -top-4 -left-4 w-8 h-8 bg-white
                      rounded-full opacity-0"
          >
          </div>
          <div
            class="gsap-greeting-deco absolute top-1/2 -right-6 w-4 h-4 bg-white
                      rounded-full opacity-0"
          >
          </div>
        </div>
      </div>

      <!-- Text Content -->
      <div class={`${textAlign} flex-1 h-full flex flex-col lg:block overflow-hidden`}>
        <!-- Header -->
        <div class="space-y-1 mb-6 mt-2 gsap-greeting-text shrink-0">
          <BlockReveal
            blockColor="#fff"
            text="Sambutan"
            className="text-[clamp(0.8rem,2vw,1rem)] font-medium text-accent-300 uppercase tracking-wider block"
          />

          <BlockReveal
            blockColor="#fff"
            text={name}
            className="text-[clamp(1.6rem,5vw,3.75rem)] font-heading font-bold block leading-tight"
          />

          <BlockReveal
            blockColor="#fff"
            text={title}
            className="text-[clamp(1rem,2.5vw,1.25rem)] font-medium text-white/80 uppercase tracking-wide block"
          />

          <div class="flex items-center gap-4 pt-2">
            <div class="w-12 sm:w-16 h-px bg-white"></div>
            <div class="w-2 h-2 bg-white rounded-full"></div>
            <div class="w-12 sm:w-16 h-px bg-white"></div>
          </div>
        </div>

        <!-- ✅ Greeting Text with Custom Native Scroll -->
        <div
          class="greeting-text-wrapper gsap-greeting-content relative flex-1 min-h-0 flex flex-col lg:block"
        >
          <!-- ✅ Scroll Container -->
          <div
            class="greeting-text-content
                      flex-1 min-h-0 lg:h-[50vh] xl:h-[55vh]
                      overflow-y-auto lg:pr-4
                      scrollbar-custom"
          >
            <div class="greeting-scroll-wrapper will-animate">
              <!-- Quote Icon -->
              <svg
                class="w-10 h-10 md:w-12 md:h-12 text-accent-200/40 mb-4
                       float-left mr-4 mt-2"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
                ></path>
              </svg>
  
              <!-- Full Text directly -->
              <div class="greeting-body-text space-y-5">
                {
                  greeting
                    .split(/\r?\n/)
                    .map((line) =>
                      line.trim() ? (
                        <p class="text-[clamp(0.8rem,2.5vw,1.5rem)] leading-relaxed text-white/90 italic text-justify">
                          {line}
                        </p>
                      ) : null,
                    )
                }
              </div>
              <!-- Signature -->
            <div class={`shrink-0 absolute -bottom-14 ${textAlign}`}>
              <div
                class="text-accent-200 font-medium text-[clamp(0.8rem,2vw,1.125rem)] inline-block"
              >
                <BlockReveal blockColor="#fff" text={`— ${name}`} />
              </div>
            </div>
            </div>


            <!-- Scroll Hint -->
            <div class="scroll-hint">
              <svg
                class="w-5 h-5 animate-bounce"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
              </svg>
              <span class="text-xs">Scroll untuk baca lebih lanjut</span>
            </div>
          </div>

          
        </div>
      </div>
    </div>
  </div>

  <!-- Floating decorative elements -->
  <div
    class="gsap-floating-bg absolute top-10 left-10 w-3 h-3 bg-white rounded-full
              opacity-40"
  >
  </div>
  <div
    class="gsap-floating-bg absolute bottom-20 right-20 w-2 h-2 bg-white rounded-full
              opacity-50"
  >
  </div>
  <div
    class="gsap-floating-bg absolute top-1/3 right-10 w-1 h-1 bg-white rounded-full
              opacity-30"
  >
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { waitForLoading } from "../../utils/loadingState";
  import { fadeUp, prefersReducedMotion } from "../../utils/gsap-animations";

  document.addEventListener("astro:page-load", async () => {
    // 🛡️ Safety timeout for loading state
    const loadingPromise = waitForLoading();
    const timeoutPromise = new Promise(resolve => setTimeout(resolve, 2000));
    await Promise.race([loadingPromise, timeoutPromise]);

    if (prefersReducedMotion()) return;

    const sections = document.querySelectorAll("[data-greeting]");
    
    sections.forEach((sec) => {
      const txt = sec.querySelector(".greeting-text-content") as HTMLElement;
      const hint = sec.querySelector(".scroll-hint") as HTMLElement;
      const id = sec.id || `sec-${Math.random().toString(36).substr(2, 9)}`;
      
      // 1. Unified Text Scroller & Hint Timeline
      // 🔥 CRITICAL: ONLY Skip text scroll GSAP if managed by HorizontalCarousel
      const isInCarousel = !!sec.closest(".horizontal-scroll-container");
      
      if (txt && !isInCarousel) {
        const getOverflow = () => Math.max(0, txt.scrollHeight - txt.clientHeight);

        if (getOverflow() > 10) {
          txt.style.overflowY = "hidden";
          txt.scrollTop = 0;

          if (hint) {
            hint.style.display = "flex";
            hint.style.opacity = "1";
          }

          const isMobileHardware = /Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || 
                                   (navigator.maxTouchPoints > 0);

          const scrollerTl = gsap.timeline({
            scrollTrigger: {
              trigger: sec,
              start: "top top",
              end: () => `+=${getOverflow() * 1.5}`,
              pin: true, // 🚀 Restored pin for both desktop & mobile
              scrub: 0.1,
              anticipatePin: 1,
              fastScrollEnd: true,
              invalidateOnRefresh: true,
              id: `scroll-${id}`
            },
          });

          scrollerTl.to(sec.querySelector(".greeting-scroll-wrapper"), {
            y: () => -getOverflow(),
            ease: "none",
            force3D: true,
          });

          if (hint) {
            scrollerTl.to(hint, {
              opacity: 0,
              ease: "power1.inOut",
            }, 0);
          }
        }
      }

      // 2. ✨ AWWWARDS STYLE GSAP ENTRANCE ANIMATIONS ✨
      // This should run even inside a Carousel!
      const imageFloat = sec.querySelector(".greeting-image-float") as HTMLElement;
      const decos = sec.querySelectorAll(".gsap-greeting-deco");
      const textContent = sec.querySelector(".gsap-greeting-content") as HTMLElement;
      const floatingBgs = sec.querySelectorAll(".gsap-floating-bg");

      const entranceTl = gsap.timeline({
        scrollTrigger: {
          trigger: sec,
          // If in carousel, use the section itself as trigger, 
          // but carousel might hide it, so "top 85%" is usually safe.
          start: isInCarousel ? "top center" : "top 85%",
          toggleActions: "play none none reverse",
          once: true,
          id: `entrance-${id}`
        },
      });

      if (imageFloat) {
        entranceTl.from(imageFloat, {
          scale: 0.8, opacity: 0, rotationY: 15,
          duration: 1.2, ease: "power4.out", force3D: true,
        }, 0.2);
      }

      if (decos.length) {
        entranceTl.from(decos, {
          opacity: 0, scale: 0, stagger: 0.1,
          duration: 0.6, ease: "back.out(1.7)",
        }, "-=0.8");
      }

      if (textContent) {
        entranceTl.from(textContent, {
          opacity: 0, y: 30, duration: 0.8,
          ease: "power2.out", force3D: true,
        }, "-=0.6");
      }

      // 3. Ambient floating background pulses loop
      let pulseAnim: gsap.core.Tween | null = null;
      if (floatingBgs.length) {
        pulseAnim = gsap.to(floatingBgs, {
          y: "random(-15, 15)", x: "random(-15, 15)",
          duration: 4, ease: "sine.inOut", yoyo: true, repeat: -1,
          force3D: true, stagger: { amount: 2, from: "random" },
          paused: true
        });

        ScrollTrigger.create({
          trigger: sec,
          start: "top bottom",
          end: "bottom top",
          id: `ambient-${id}`,
          onEnter: () => pulseAnim?.play(),
          onLeave: () => pulseAnim?.pause(),
          onEnterBack: () => pulseAnim?.play(),
          onLeaveBack: () => pulseAnim?.pause(),
        });
      }

      // Lifecycle cleanup for this section
      document.addEventListener("astro:before-swap", () => {
        pulseAnim?.kill();
        ScrollTrigger.getById(`scroll-${id}`)?.kill();
        ScrollTrigger.getById(`entrance-${id}`)?.kill();
        ScrollTrigger.getById(`ambient-${id}`)?.kill();
      }, { once: true });
    });
  });
</script>

<style>
  /* ===== Text Content ===== */
  .greeting-text-content {
    text-align: justify;
    hyphens: auto;
    position: relative;
  }

  @media (max-width: 768px) {
    .greeting-text-content {
      hyphens: none;

      /* ✅ Better scrollbar styling */
      padding-right: 8px;
    }
  }

  /* ===== Custom Scrollbar ===== */
  .scrollbar-custom {
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
  }

  .scrollbar-custom::-webkit-scrollbar {
    width: 6px;
  }

  .scrollbar-custom::-webkit-scrollbar-track {
    background: transparent;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.3);
    border-radius: 3px;
  }

  .scrollbar-custom::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.5);
  }

  /* ===== Scroll Hint ===== */
  .scroll-hint {
    position: sticky;
    bottom: 0;
    left: 0;
    right: 0;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;

    padding: 12px;
    margin-top: 16px;

    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.5));

    color: rgba(255, 255, 255, 0.7);
    text-align: center;

    pointer-events: none;
    transition: opacity 300ms ease;
  }

  .scroll-hint.hidden,
  .scroll-hint.opacity-0 {
    opacity: 0;
  }

  /* ===== Float & Transitions ===== */
  .clear-both {
    clear: both;
  }

  .toggle-icon {
    transition: transform 0.3s ease;
  }

  svg.float-left {
    shape-outside: circle(50%);
  }

  .whitespace-pre-line {
    white-space: pre-line;
  }
</style>
