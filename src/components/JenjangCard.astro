---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import aPPLGPict from "../../src/assets/ip3a.webp";
import smkLogo from "../../src/assets/smk.webp";
import smaLogo from "../../src/assets/sma.webp";
---

<div
  class="image-container max-w-4xl items-center justify-around h-full mx-auto overflow-hidden px-8"
>
  <div class="jenjang-wrapper max-w-2xl">
    <a href="/classes/smk" class="jenjang-card">
      <Image
        src={smkLogo}
        alt="Logo SMK"
        width={480}
        height={480}
        class="jenjang-image"
      />
    </a>

    <a href="/classes/sma" class="jenjang-card">
      <Image
        src={smaLogo}
        alt="Logo SMA"
        width={480}
        height={480}
        class="jenjang-image"
      />
    </a>
  </div>
</div>

<style>
  /* Wrapper */
  .jenjang-wrapper {
    /* max-width: 64rem; ~max-w-4xl */
    margin-inline: auto;
    padding: 2rem;

    display: grid;
    gap: 2rem;
  }

  /* Mobile: 1 kolom */
  @media (max-width: 639px) {
    .jenjang-wrapper {
      grid-template-columns: 1fr;
    }
    .jenjang-card {
      aspect-ratio: 2 / 1.1;
    }
  }

  /* Tablet ke atas: 2 kolom */
  @media (min-width: 640px) {
    .jenjang-wrapper {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .jenjang-card {
      aspect-ratio: 1 / 1.1; /* fleksibel, tidak kaku */
    }
  }

  /* Card */
  .jenjang-card {
    border-radius: 1rem;
    background: #e5e7eb;

    display: flex;
    align-items: center;
    justify-content: center;

    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .jenjang-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
  }

  /* Image */
  .jenjang-image {
    width: 70%;
    height: 70%;
    object-fit: contain;
  }
</style>
