---
/**
 * FadeOverlay Component
 * ---------------------
 * Reusable fade gradient overlay (top & bottom)
 */

interface Props {
  /** Aktifkan fade top */
  showTop?: boolean;

  /** Aktifkan fade bottom */
  showBottom?: boolean;

  /** Warna fade (rgb / hex / rgba) */
  topColor?: string;
  bottomColor?: string;

  /** Tinggi fade (CSS length / clamp) */
  height?: string;

  connectorHeight?: string;

  /** Z-index wrapper */
  zIndex?: number;

  /** Grid row span (contoh: "1 / 3") */
  gridRow?: string;

  /** TranslateY value */
  translateY?: string;

  /** Full width atau container */
  fullWidth?: boolean;

  marginY?: string;
}

const {
  showTop = true,
  showBottom = true,
  topColor = "245, 240, 234",
  bottomColor = "245, 240, 234",
  height = "clamp(12vw, 12vw, 40vw)",
  connectorHeight,
  zIndex = 10,
  gridRow = "1 / 3",
  translateY = "-100%",
  fullWidth = true,
  marginY = "0px"
} = Astro.props;
---

<div
  class={`fade-overlay`}
  style={`
    grid-row: ${gridRow};
    z-index: ${zIndex};
    height: ${connectorHeight ? connectorHeight : '0px'};
  `}
>
  {showTop && (
    <div
      class="fade fade-top"
      style={`
        height: ${height};
        transform: translateY(${translateY});
        --fade-color: ${topColor};
        z-index: ${zIndex};
      `}
    />
  )}

  {showBottom && (
    <div
      class="fade fade-bottom"
      style={`
        height: ${height};
        transform: translateY(${translateY});
        --fade-color: ${bottomColor};
        z-index: ${zIndex};
      `}
    />
  )}
</div>

<style>
.fade-overlay {
  background-color: rgb(var(--color-primary));
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  pointer-events: none;
  width: 100%;
  height: 0px;
}

.fade {
  width: 100vw;
  aspect-ratio: 1 / 1;
  pointer-events: none;
}

.fade-top {
  background: linear-gradient(
    to bottom,
    rgba(var(--fade-color), 0) 0%,
    rgba(var(--fade-color), 1) 70%
  );
}

.fade-bottom {
  background: linear-gradient(
    to top,
    rgba(var(--fade-color), 0) 0%,
    rgba(var(--fade-color), 1) 70%
  );
}

</style>
