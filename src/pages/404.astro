---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="404 - Halaman Tidak Ditemukan"
  description="Halaman yang Anda cari tidak dapat ditemukan di Yearbook Nihayatu Zayn."
>
  <div class="min-h-dvh flex items-center justify-center relative overflow-hidden bg-[#f5f0ea]">
    <!-- Animated background blobs -->
    <div class="absolute inset-0 pointer-events-none">
      <div class="blob blob-1"></div>
      <div class="blob blob-2"></div>
      <div class="blob blob-3"></div>
    </div>

    <div class="relative z-10 text-center px-6 max-w-2xl mx-auto">
      <!-- Giant 404 -->
      <div class="relative inline-block mb-6">
        <span
          class="text-[10rem] md:text-[14rem] font-heading font-black leading-none select-none"
          style="
            background: linear-gradient(135deg, #3557A2 0%, #251E54 50%, #2A358F 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            filter: drop-shadow(0 8px 32px rgba(53,87,162,0.2));
          "
        >404</span>
        <!-- Floating book emoji -->
        <span class="absolute -top-4 -right-6 text-5xl float-book">📖</span>
      </div>

      <!-- Message -->
      <h1 class="text-2xl md:text-3xl font-heading font-bold text-[#251E54] mb-4">
        Halaman Ini Sudah Jadi Kenangan
      </h1>
      <p class="text-gray-500 text-base md:text-lg mb-10 leading-relaxed">
        Seperti masa SMA yang tak bisa diulang, halaman yang kamu cari tidak ada di sini.
        Mungkin URL-nya salah, atau halaman ini sudah berpindah tempat.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/"
          class="group px-8 py-3 bg-[#251E54] text-white font-semibold rounded-full
                 hover:bg-[#3557A2] transition-all duration-300 hover:shadow-lg hover:shadow-blue-900/20
                 hover:-translate-y-0.5 inline-flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
          </svg>
          Kembali ke Beranda
        </a>
      </div>

      <!-- Decorative line -->
      <div class="mt-12 flex items-center justify-center gap-3 text-gray-400 text-sm">
        <div class="h-px w-16 bg-gray-300"></div>
        <span>Yearbook Nihayatu Zayn · Angkatan 2025</span>
        <div class="h-px w-16 bg-gray-300"></div>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    animation: drift 12s ease-in-out infinite alternate;
  }
  .blob-1 {
    width: 500px; height: 500px;
    background: #3557A2;
    top: -15%; left: -10%;
    animation-delay: 0s;
  }
  .blob-2 {
    width: 400px; height: 400px;
    background: #251E54;
    bottom: -10%; right: -5%;
    animation-delay: -4s;
  }
  .blob-3 {
    width: 300px; height: 300px;
    background: #2A358F;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    animation-delay: -8s;
  }

  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to   { transform: translate(40px, -30px) scale(1.08); }
  }

  .float-book {
    animation: floatBook 3s ease-in-out infinite;
    display: inline-block;
  }

  @keyframes floatBook {
    0%, 100% { transform: translateY(0) rotate(-5deg); }
    50%       { transform: translateY(-12px) rotate(5deg); }
  }
</style>
