---

<MainLayout
  title="Nihayatu Zayn Annual Website"
  description="Kenangan indah pperjalanan kami selama 3 tahun bersama"
>
  <ParallaxStack>
    <div data-exit="fade">
      <HeroSection />
    </div>
    <div>
      <AboutSection />
    </div>
  </ParallaxStack>

  <GreetingSection
    layout={pimpinanGreeting.layout}
    name={pimpinanGreeting.name}
    title={pimpinanGreeting.title}
    excerptLength={pimpinanGreeting.excerptLength}
    greeting={pimpinanGreeting.greeting}
    photo={pimpinanGreeting.photo}
    backgroundImage={pimpinanGreeting.backgroundImage}
    schoolLogo={pimpinanGreeting.schoolLogo}
  />

  <HorizontalScrollCarousel id="kepsek-carousel">
    {
      kepsekGreetings.map((greeting) => (
        <GreetingSection
          layout={greeting.layout}
          name={greeting.name}
          title={greeting.title}
          excerptLength={greeting.excerptLength}
          greeting={greeting.greeting}
          photo={greeting.photo}
          backgroundImage={greeting.backgroundImage}
          schoolLogo={greeting.schoolLogo}
        />
      ))
    }
  </HorizontalScrollCarousel>

  <!-- Generation Council Greeting -->
  <HorizontalScrollCarousel id="angkatan-carousel">
    {
      angkatanGreetings.map((greeting) => (
        <GreetingSection
          layout={greeting.layout}
          name={greeting.name}
          title={greeting.title}
          excerptLength={greeting.excerptLength}
          greeting={greeting.greeting}
          photo={greeting.photo}
          backgroundImage={greeting.backgroundImage}
          schoolLogo={greeting.schoolLogo}
        />
      ))
    }
  </HorizontalScrollCarousel>

  <!-- Makna Logo Section -->
  <MaknaLogoSection maknaLogo={maknaLogo} />

  <!-- TODO: Change Journey Section to CTA section that redirect to altie-about page  -->
  <!-- Journey Section -->
  <JourneySection />
  <FadeOverlay showBottom={false} />
</MainLayout>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { waitForLoading } from "../utils/loadingState";
  import { prefersReducedMotion, fadeUp } from "../utils/gsap-animations";

  async function initIndexAnimations() {
    // 🛡️ Safety timeout for loading state to prevent deadlock
    const loadingPromise = waitForLoading();
    const timeoutPromise = new Promise((resolve) => setTimeout(resolve, 2500));
    await Promise.race([loadingPromise, timeoutPromise]);

    // 🚀 Critical: Register plugin to avoid race conditions
    gsap.registerPlugin(ScrollTrigger);

    if (prefersReducedMotion()) return;

    // 1. Subtle Parallax for Background Images
    const parallaxWrappers = document.querySelectorAll(".parallax-bg-wrapper");

    parallaxWrappers.forEach((wrapper, i) => {
      // 🔥 OPTIMIZATION: Skip parallax if inside Horizontal Carousel to prevent GPU overload
      if (wrapper.closest(".horizontal-scroll-container")) return;

      const img = wrapper.querySelector(".parallax-bg-image");
      if (!img) return;

      gsap.fromTo(
        img,
        { yPercent: -15 },
        {
          yPercent: 15,
          ease: "none",
          force3D: true,
          scrollTrigger: {
            id: `idx-parallax-${i}`,
            trigger: wrapper,
            start: "top bottom",
            end: "bottom top",
            scrub: true,
            invalidateOnRefresh: true,
          },
        },
      );
    });

    // 2. Section Entrance (Fade in only)
    const revealSections = document.querySelectorAll(".section-reveal");

    revealSections.forEach((section, i) => {
      // Ignore if inside Horizontal Carousel
      if (section.parentElement?.closest(".horizontal-scroll-container"))
        return;

      fadeUp(section as HTMLElement, {
        y: 0,
        duration: 1.5,
        start: "top 85%",
        // We don't pass ID here because fadeUp doesn't support it yet, 
        // but we'll kill all via ScrollTrigger.getAll()
      });
    });
  }

  // Handle initialization for Astro transitions
  document.addEventListener("astro:page-load", initIndexAnimations);

  // 🧹 Lifecycle cleanup to prevent memory leaks in Astro SPA mode
  document.addEventListener("astro:before-swap", () => {
    ScrollTrigger.getAll().forEach((st) => {
      if (st.vars.id?.startsWith("idx-")) {
        st.kill();
      }
    });
  }, { once: true });
</script>
