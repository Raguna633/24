---
import MainLayout from "../../layouts/MainLayout.astro";
import ImageCard from "../../components/ImageCard.astro";
import BentoGalleryGrid from "../../components/BentoGalleryGrid.astro";
import TextReveal from "../../components/animations/TextReveal.astro";
import CloudinaryImage from "../../components/ui/CloudinaryImage.astro";
import GalleryLightbox from "../../components/GalleryLightbox.tsx";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const galleries = await getCollection("galleries");
  return galleries.map((gallery) => ({
    params: { slug: gallery.id },
    props: { gallery },
  }));
}

const { gallery } = Astro.props;
const { title, description, galleryType, bentoLayout, photos, heroPhotos, ip3aPhotos, ip4aPhotos, cta } = gallery.data;

// If uniform, we fetch uniforms collection to pass to ImageCard
let uniformsData: any[] = [];
let allUniforms: any[] = [];
if (galleryType === "uniform") {
  allUniforms = (await getCollection("uniforms")).sort((a, b) =>
    a.id.localeCompare(b.id),
  );
  uniformsData = allUniforms.map((u) => {
    const originalSrc = u.data.uniformPhotos?.[0];
    const optimizedImg = originalSrc?.includes('/upload/') 
      ? originalSrc.replace('/upload/', '/upload/f_auto,q_auto,c_fill,ar_1:1,w_480/') 
      : originalSrc;
    return {
      id: u.id,
      img: optimizedImg,
      alt: `Foto ${u.data.uniformName}`,
      title: u.data.uniformName,
    };
  });
}

// Prepare Lightbox items based on gallery type
let lightboxItems: any[] = [];

// Helper to transform custom photo objects to lightbox items
const transformToLightbox = (items: any[] | undefined, prefix: string) => {
  if (!items) return [];
  return items.map((p, index) => ({
    id: `${prefix}-${index}`,
    src: p.url,
    alt: p.title,
    title: p.title,
    subtitle: p.title
  }));
};

const heroLightbox = transformToLightbox(heroPhotos, 'hero');
const ip3aLightbox = transformToLightbox(ip3aPhotos, 'ip3a');
const ip4aLightbox = transformToLightbox(ip4aPhotos, 'ip4a');

if (galleryType === "uniform") {
  lightboxItems = allUniforms.map((u) => ({
    id: u.id,
    src: u.data.uniformPhotos?.[0], // Preview src
    alt: `Foto ${u.data.uniformName}`,
    title: u.data.uniformName,
    subtitle: `Model: <span class="text-white font-medium">${u.data.modelName || 'Anonim'}</span> (${u.data.modelClass || '-'})`,
    photos: u.data.uniformPhotos.map((photo: any) => ({ src: photo }))
  }));
} else if (galleryType === "bento") {
  // Merge all sections into lightboxItems for seamless navigation
  const bentoPhotos = (photos || []).map((photo, index) => {
    const isObject = typeof photo === "object";
    const src = isObject ? photo.url : photo;
    const photoTitle = isObject ? photo.title : title;
    
    return {
      id: `photo-${index}`,
      src: src,
      alt: photoTitle,
      title: photoTitle,
      subtitle: `Photo ${index + 1} of ${photos?.length}`
    };
  });

  lightboxItems = [...heroLightbox, ...ip3aLightbox, ...ip4aLightbox, ...bentoPhotos];
}
---

<MainLayout
  title={`${title} - Yearbook 2025`}
  description={description || `Koleksi foto ${title}`}
>
  <section
    class="relative pb-16 overflow-hidden min-h-dvh bg-gradient-to-b from-[#f5f0ea] to-[#f5f0ea]/50"
    aria-label={`Galeri ${title}`}
  >
    {/* ==================== DECORATIVE ELEMENTS ==================== */}

    {/* Top Wave Divider */}
    <div class="wave-top opacity-0 hero-elem">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
      >
        <path d="M1200 0L0 0 892.25 114.72 1200 0z" class="shape-fill-white"
        ></path>
      </svg>
    </div>

    {/* Floating Decorative Circles */}
    <div class="floating-circle circle-1 parallax-circle"></div>
    <div class="floating-circle circle-2 parallax-circle"></div>
    <div class="floating-circle circle-3 parallax-circle"></div>

    {/* Paper Texture Overlay */}
    <div class="paper-texture"></div>

    {/* ==================== CONTENT ==================== */}
    <div class="container max-w-screen mx-auto relative z-10 pt-20 md:pt-32">
      
      {/* Header Section */}
      <header class="py-12 mx-8 text-center relative">
        <div class="inline-block relative hero-title-wrapper">
          <TextReveal>
            <h1 class="text-4xl md:text-5xl lg:text-7xl font-bold text-gray-800 mb-2">
              {title}
            </h1>
          </TextReveal>
        </div>

        {description && (
          <div class="opacity-0 hero-desc mt-6">
            <TextReveal>
              <p class="text-gray-600 text-lg md:text-xl max-w-2xl mx-auto">
                {description}
              </p>
            </TextReveal>
          </div>
        )}
      </header>

      {/* Divider */}
      <div class="divider-section scroll-fade opacity-0">
        <div class="divider-line"></div>
        <div class="divider-icon pulse-icon">
          <svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
            <circle cx="25" cy="25" r="20" fill="#3557A2" opacity="0.2"
            ></circle>
            <path
              d="M 25 15 L 30 25 L 25 35 L 20 25 Z"
              fill="#2A358F"
              opacity="0.4"></path>
          </svg>
        </div>
        <div class="divider-line"></div>
      </div>

      {/* Azzarqo Specific Sections */}
      {gallery.id === 'azzarqo' && (
        <div class="my-16 px-4 md:px-8 max-w-6xl mx-auto space-y-24">
          {/* Hero Styles Section */}
          <div class="space-y-12">
            <TextReveal>
              <h2 class="text-3xl md:text-4xl font-bold text-gray-800 text-center">Gaya Kenangan</h2>
            </TextReveal>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {heroPhotos?.map((photo: any, i: number) => (
                <div class="scroll-fade opacity-0 group">
                  <button 
                    data-gallery-id={`hero-${i}`}
                    class="relative w-full aspect-[16/9] overflow-hidden rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-500 hover:-translate-y-1 cursor-pointer"
                  >
                    <CloudinaryImage
                      src={photo.url}
                      alt={photo.title}
                      class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110"
                      widths={[480, 800, 1200]}
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-6">
                      <p class="text-white font-medium text-lg">{photo.title}</p>
                    </div>
                  </button>
                  <p class="mt-4 text-center text-gray-600 font-medium md:hidden">{photo.title}</p>
                </div>
              ))}
            </div>
          </div>

          {/* IP3A Division Section */}
          <div class="space-y-12">
             <div class="flex items-center gap-4">
              <div class="h-px flex-1 bg-gray-300"></div>
              <TextReveal>
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 px-4">Anggota Divisi IP3A</h2>
              </TextReveal>
              <div class="h-px flex-1 bg-gray-300"></div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6">
              {ip3aPhotos?.map((photo: any, i: number) => (
                <div class="scroll-fade opacity-0">
                  <button 
                    data-gallery-id={`ip3a-${i}`}
                    class="group relative w-full aspect-[4/3] overflow-hidden rounded-xl shadow-md hover:shadow-xl transition-all duration-500 cursor-pointer"
                  >
                    <CloudinaryImage
                      src={photo.url}
                      alt={photo.title}
                      class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110"
                      widths={[240, 480]}
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-4">
                      <span class="text-white text-sm font-medium text-center">{photo.title}</span>
                    </div>
                  </button>
                </div>
              ))}
            </div>
          </div>

          {/* IP4A Division Section */}
          <div class="space-y-12">
            <div class="flex items-center gap-4">
              <div class="h-px flex-1 bg-gray-300"></div>
              <TextReveal>
                <h2 class="text-2xl md:text-3xl font-bold text-gray-800 px-4">Anggota Divisi IP4A</h2>
              </TextReveal>
              <div class="h-px flex-1 bg-gray-300"></div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6">
              {ip4aPhotos?.map((photo: any, i: number) => (
                <div class="scroll-fade opacity-0">
                  <button 
                    data-gallery-id={`ip4a-${i}`}
                    class="group relative w-full aspect-[4/3] overflow-hidden rounded-xl shadow-md hover:shadow-xl transition-all duration-500 cursor-pointer"
                  >
                    <CloudinaryImage
                      src={photo.url}
                      alt={photo.title}
                      class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-110"
                      widths={[240, 480]}
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center p-4">
                      <span class="text-white text-sm font-medium text-center">{photo.title}</span>
                    </div>
                  </button>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* Gallery Grid */}
      <div class="my-12 mx-auto max-w-6xl relative px-4 md:px-8">
        {galleryType === "uniform" ? (
          <ImageCard
            images={uniformsData}
            gridCols={4}
            imageWidth={480}
            imageHeight={480}
            gap="gap-4 md:gap-6"
            className="relative z-10"
          />
        ) : (
          <>
            {gallery.id === 'azzarqo' && (
               <div class="flex items-center gap-4 mb-12">
                <TextReveal>
                  <h2 class="text-2xl md:text-3xl font-bold text-gray-800">Kumpulan Memori</h2>
                </TextReveal>
                <div class="h-px flex-1 bg-gray-300"></div>
              </div>
            )}
            <BentoGalleryGrid
              photos={(photos || []).map((p: any) => {
                if (typeof p === 'string') {
                  return p.includes('/upload/') ? p.replace('/upload/', '/upload/f_auto,q_auto,w_800/') : p;
                }
                return {
                  ...p,
                  url: p.url.includes('/upload/') ? p.url.replace('/upload/', '/upload/f_auto,q_auto,w_800/') : p.url
                };
              })}
              layout={bentoLayout as any}
              className="relative z-10"
            />
          </>
        )}
      </div>

      {/* Tail (CTA) */}
      {cta && (
        <div class="mt-20 mb-10 text-center opacity-0 scroll-fade flex flex-col items-center justify-center">
          <TextReveal>
            <h3 class="text-2xl font-serif text-gray-800 mb-6">{cta.text_title}</h3>
          </TextReveal>
          <a
            href={cta.url}
            class="group relative inline-flex items-center gap-3 px-8 py-4 bg-[#2A358F] text-[#f5f0ea] rounded-full overflow-hidden transition-transform hover:scale-105 active:scale-95"
          >
            <span class="relative z-10 font-medium tracking-wide">
              {cta.text}
            </span>
            <svg
              class="relative z-10 w-5 h-5 transition-transform group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
            <div class="absolute inset-0 bg-[#3557A2] scale-x-0 origin-left transition-transform duration-500 ease-out group-hover:scale-x-100"></div>
          </a>
        </div>
      )}
    </div>

  </section>

  {/* Modal React Island */}
  <GalleryLightbox items={lightboxItems} client:idle />
</MainLayout>

<style>
  /* ==================== CONTAINER ==================== */
  .container {
    position: relative;
    z-index: 10;
  }

  /* ==================== WAVE DIVIDERS ==================== */
  .wave-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 1;
  }

  .wave-top svg {
    position: relative;
    display: block;
    width: calc(166% + 1.3px);
    height: 256px;
  }

  .shape-fill-white {
    fill: #ffffffd9;
  }

  /* ==================== FLOATING CIRCLES ==================== */
  .floating-circle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(53, 87, 162, 0.1),
      rgba(42, 53, 143, 0.05)
    );
    z-index: 0;
    opacity: 0;
  }

  .circle-1 {
    width: 300px;
    height: 300px;
    top: 15%;
    left: -5%;
  }
  .circle-2 {
    width: 200px;
    height: 200px;
    top: 60%;
    right: 5%;
  }
  .circle-3 {
    width: 150px;
    height: 150px;
    bottom: 10%;
    left: 10%;
  }

  /* ==================== PAPER TEXTURE ==================== */
  .paper-texture {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.01) 2px,
      rgba(0, 0, 0, 0.01) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* ==================== DIVIDER SECTION ==================== */
  .divider-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 3rem 0;
  }

  .divider-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(to right, transparent, #3557a2, transparent);
    opacity: 0.3;
  }

  .divider-icon {
    width: 50px;
    height: 50px;
  }

  @media (max-width: 768px) {
    .wave-top svg {
      width: calc(134% + 1.3px);
      height: 181px;
    }
    .floating-circle {
      display: none;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { waitForLoading } from "../../utils/loadingState";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", async () => {
    // Wait for the full loading screen gatekeeper
    await waitForLoading();

    // ==================== ENTRANCE ANIMATION (HERO) ====================
    const tl = gsap.timeline();

    tl.to(".wave-top", {
      opacity: 1,
      y: 0,
      duration: 1.2,
      ease: "power3.out",
    })
      .to(
        ".hero-elem",
        {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power4.out",
          stagger: 0.15,
        },
        "-=0.8",
      )
      .to(
        ".hero-desc",
        {
          opacity: 1,
          duration: 0.8,
          ease: "none",
        },
        "-=0.8",
      );

    // ==================== FLOAT & PULSE ANIMATIONS (INFINITE) ====================
    gsap.to(".floating-circle", {
      y: -30,
      opacity: 1,
      duration: 4,
      yoyo: true,
      repeat: -1,
      ease: "sine.inOut",
      stagger: 0.7,
    });

    gsap.to(".pulse-icon", {
      scale: 1.1,
      duration: 2,
      yoyo: true,
      repeat: -1,
      ease: "sine.inOut",
    });

    // ==================== SCROLL ANIMATIONS (BELOW FOLD) ====================
    
    // Dividers & Text
    gsap.utils.toArray(".scroll-fade").forEach((el) => {
      gsap.to(el as HTMLElement, {
        opacity: 1,
        duration: 1,
        ease: "power2.out",
        scrollTrigger: {
          trigger: el as HTMLElement,
          start: "top 90%",
        },
      });
    });
  });
</script>
