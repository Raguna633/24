---
import MainLayout from "../layouts/MainLayout.astro";
import Copy from "../components/Copy.jsx";
import TextReveal from "../components/animations/TextReveal.astro";
import { Image, getImage } from "astro:assets";

import bgTexture from "../assets/yearbook-committee/watercolor-paper-texture.jpg";
import headerStroke from "../assets/yearbook-committee/header-stroke.svg?raw";
import firstStroke from "../assets/yearbook-committee/first-stroke.svg?raw";
import secondStroke from "../assets/yearbook-committee/second-stroke.svg?raw";
import thirdStroke from "../assets/yearbook-committee/third-stroke.svg?raw";
import trapesiumBg from "../assets/yearbook-committee/trapesium.svg?raw";
import bknPutra from "../assets/yearbook-committee/bkn_putra.webp";
import bknPutri from "../assets/yearbook-committee/bkn_putri.webp";

// Optimize background texture to webp via Astro pipeline
const optimizedBg = await getImage({ src: bgTexture, format: "webp" });
---

<MainLayout
  title="Yearbook Committee | Buken"
  description="Buku Kenangan - Yearbook Committee"
>
  <!-- Background Cover -->
  <div
    class="fixed inset-0 z-[-10] w-full h-full pointer-events-none bg-[var(--color-primary)]"
  >
    <div
      class="absolute inset-0 opacity-50 bg-cover bg-center bg-no-repeat w-full h-full"
      style={`background-image: url(${optimizedBg.src})`}
    >
    </div>
  </div>

  <div
    class="relative z-10 w-full max-w-[1440px] mx-auto pt-32 pb-48 px-8 lg:px-0 flex flex-col items-center overflow-x-hidden"
  >
    <!-- HEADER -->
    <header
      class="flex flex-col items-center justify-center w-full mt-8 md:mt-16"
    >
      <h1
        class="text-4xl md:text-6xl lg:text-7xl font-black uppercase text-center tracking-wide text-black pb-2 text-shadow-lg"
      >
        <Copy client:idle blockColor="#f5f0ea" duration={1.5}>YEARBOOK COMMITTEE</Copy>
      </h1>
      <div
        class="mt-2 w-[300px] md:w-[450px] lg:w-[600px] text-center flex justify-center animated-stroke-wrapper header-stroke relative z-10 transition-transform"
      >
        <div class="w-full flex justify-center" set:html={headerStroke} />
      </div>
    </header>

    <!-- SECTION 1: First Quote -->
    <section
      class="w-full mx-8 relative mt-32 md:mt-40 mb-32 flex justify-center items-center"
    >
      <div class="max-w-2xl text-center relative z-20">
        <span
          class="quotation-mark absolute -top-16 left-0 text-7xl md:text-8xl font-serif text-black leading-none"
          >"</span
        >
        <h2
          class="text-xl md:text-2xl lg:text-3xl font-medium leading-[1.6] tracking-wide text-black mt-4 text-shadow-lg"
        >
          <TextReveal animateOnScroll={false} delay={0.5}>
            Thanks to the Committee, <span class="font-bold">everyone</span><br
            />
            loves the <span class="font-bold">finished</span> book, but few would<br
            />
            survive the <span class="font-bold">deadlines</span> to make it.
          </TextReveal>
        </h2>
      </div>

      <!-- First Stroke Curve -->
      <div
        class="absolute right-0 top-1/2 w-[180px] md:w-[250px] animated-stroke-wrapper first-stroke z-0 pointer-events-none stroke-container"
      >
        <div class="w-full" set:html={firstStroke} />
      </div>
    </section>

    <!-- SECTION 2: Putra Photo & Names -->
    <section
      class="w-full mx-8 flex flex-col lg:flex-row items-center justify-between lg:px-16 gap-16 lg:gap-8 my-24 lg:my-32"
    >
      <!-- Image Group -->
      <div
        class="relative w-full lg:w-3/5 image-reveal-container transform transition-all duration-1000 ease-out"
      >
        <div
          class="absolute image-card -left-6 lg:-left-8 -bottom-6 lg:-bottom-8 w-[95%] h-[95%] bg-[#9ca3af] z-0 shadow-lg"
        >
        </div>
        <div
          class="img-wrapper relative z-10 w-full overflow-hidden shadow-xl aspect-video bg-white"
        >
          <Image
            src={bknPutra}
            alt="Committee Putra"
            class="w-full h-full object-cover overflow-hidden transform transition-transform duration-1000 hover:scale-105"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Names Group -->
      <div
        class="w-full lg:w-2/5 flex flex-col items-center gap-2 text-sm md:text-base lg:text-lg font-bold text-black uppercase tracking-wider md:tracking-widest pr-0 lg:pr-8 text-shadow-lg"
      >
        <div class="text-right name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.0}
            >Fahsa Erdiansyah</Copy
          >
        </div>
        <div class="text-right name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.2}
            >M. Fahri Fathul Rozy</Copy
          >
        </div>
        <div class="text-right name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.4}
            >Rayza Maulana Abdussyukur</Copy
          >
        </div>
        <div class="text-right name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.6}
            >Restu Hadi Nugraha</Copy
          >
        </div>
        <div class="text-right name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.8}
            >Ardian Zahy</Copy
          >
        </div>
      </div>
    </section>

    <!-- SECTION 3: Second Quote & Trapesium -->
    <section
      class="w-full mx-8 relative mt-40 lg:mt-56 mb-32 flex flex-col items-end justify-center lg:justify-end px-4 lg:px-0 min-h-[350px]"
    >
      <!-- Second Stroke Curve -->
      <div
        class="absolute left-[-2rem] md:left-4 lg:-left-4 top-[-60px] md:top-[-80px] w-[140px] md:w-[180px] lg:w-[220px] animated-stroke-wrapper second-stroke z-0 pointer-events-none stroke-container"
      >
        <div class="w-full" set:html={secondStroke} />
      </div>

      <div
        class="relative z-20 w-full max-w-2xl text-right right-0 mt-16 md:mt-24"
      >
        <!-- Trapesium Background -->
        <div
          class="absolute top-1/2 left-1/2 transform -translate-x-1/4 -translate-y-1/2 w-[160%] md:w-[140%] h-[180%] lg:w-[850px] lg:h-[450px] z-[-1] opacity-70 trapesium-reveal"
        >
          <div class="w-full h-full" set:html={trapesiumBg} />
        </div>

        <span
          class="quotation-mark absolute -top-12 left-0 text-6xl md:text-8xl font-serif text-black opacity-80 leading-none"
          >"</span
        >
        <h2
          class="text-xl md:text-2xl lg:text-3xl text-shadow-lg font-medium leading-[1.6] tracking-wide text-black text-center pr-0 lg:pr-12 md:pr-8"
        >
          <TextReveal animateOnScroll={true}>
            Creating <span class="font-bold">history</span> takes a team<br />
            willing to stay behind the<br />
            scenes, so <span class="font-bold">everyone</span> else can<br />
            <span class="font-bold">shine</span> on the pages.
          </TextReveal>
        </h2>
      </div>
    </section>

    <!-- SECTION 4: Putri Photo & Names -->
    <section
      class="w-full mx-8 flex flex-col-reverse lg:flex-row items-center justify-between lg:px-16 gap-16 lg:gap-8 my-0 lg:my-48"
    >
      <!-- Names Group -->
      <div
        class="w-full lg:w-2/5 flex flex-col items-center lg:items-start gap-2 text-sm md:text-base lg:text-lg font-bold text-shadow-lg text-black uppercase tracking-wider md:tracking-widest pl-0 lg:pl-8"
      >
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.0}
            >Amelia Khuzaefa Alena</Copy
          >
        </div>
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.2}
            >Aprillina Cahyani</Copy
          >
        </div>
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.4}
            >Davina Adira Aprilia</Copy
          >
        </div>
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.6}
            >Fidella Nisa</Copy
          >
        </div>
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={0.8}
            >Keyza Allisya Amanda</Copy
          >
        </div>
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={1}
            >Qadira Evania Putri Suangsa</Copy
          >
        </div>
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={1.2}
            >Silvia Azzahra</Copy
          >
        </div>
        <div class="text-left name-text">
          <Copy client:visible blockColor="#f5f0ea" stagger={1.4}
            >Wifa Fauziah</Copy
          >
        </div>
      </div>

      <!-- Image Group -->
      <div
        class="relative w-full lg:w-3/5 image-reveal-container transform transition-all duration-1000 ease-out"
      >
        <div
          class="absolute image-card -right-6 lg:-right-8 -bottom-6 lg:-bottom-8 w-[95%] h-[95%] bg-[#9ca3af] z-0 shadow-lg"
        >
        </div>
        <div
          class="img-wrapper relative z-10 w-full shadow-xl aspect-video bg-white overflow-hidden"
        >
          <Image
            src={bknPutri}
            alt="Committee Putri"
            class="w-full h-full object-cover transform transition-transform duration-1000 hover:scale-105"
            widths={[400, 800, 1200]}
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- SECTION 5: Third Quote -->
    <section
      class="w-full mx-8 relative mt-32 mb-48 flex flex-col md:flex-row justify-center items-start lg:px-16 gap-8 lg:gap-24"
    >
      <!-- Third Stroke Curve -->
      <div
        class="absolute left-0 -translate-x-1/4 -translate-y-1/2 w-[160px] md:w-[150px] lg:w-[220px] animated-stroke-wrapper third-stroke z-0 pointer-events-none mt-8 stroke-container pl-4 md:pl-0"
      >
        <div class="w-full" set:html={thirdStroke} />
      </div>

      <div class="max-w-3xl text-left relative z-10 mx-8 md:mx-0 pr-4 md:pr-0">
        <span
          class="quotation-mark absolute -top-12 -left-16 text-6xl md:text-8xl font-serif text-black opacity-80 leading-none"
          >"</span
        >
        <h2
          class="text-xl md:text-2xl lg:text-3xl font-medium leading-[1.6] tracking-wide text-black mt-4 text-shadow-lg"
        >
          <TextReveal animateOnScroll={true}>
            People <span class="font-bold">never</span> want to be part of the <span
              class="font-bold">process</span
            >, but<br />
            they want to be a part of the <span class="font-bold">outcome</span
            >.<br />
            Unfortunately, during the process is where you<br />
            figure out who's <span class="font-bold">worthy</span> of being part of
            the<br />
            outcome
          </TextReveal>
        </h2>
      </div>
    </section>
  </div>
</MainLayout>

<style is:global>
  /* SVG Custom Wrapper Rules */
  .animated-stroke-wrapper svg {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(4px 4px 5px rgba(0, 0, 0, 0.3));
  }

  .image-card {
    border-radius: 0.5rem;
    box-shadow: 3px 3px 12px 1px #00000085;
  }

  .img-wrapper {
    border-radius: 0.5rem;
    box-shadow: 3px 3px 12px 1px #00000085;
  }

  .quotation-mark {
    opacity: 0;
    will-change: transform, opacity;
    filter: drop-shadow(4px 4px 5px rgba(0, 0, 0, 0.3));
  }

  .animated-stroke-wrapper {
    opacity: 0;
  }

  /* Initial hidden state for paths */
  .animated-stroke-wrapper path {
    opacity: 0;
  }

  .name-text {
    opacity: 0;
    will-change: transform, opacity;
  }

  .trapesium-reveal svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { waitForLoading } from "../utils/loadingState";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", async () => {
    // Preparation Stage
    ScrollTrigger.getAll().forEach((t) => t.kill());

    const paths = document.querySelectorAll(".animated-stroke-wrapper path");
    paths.forEach((path) => {
      // @ts-ignore
      const length = path.getTotalLength ? path.getTotalLength() : 1000;
      gsap.set(path, {
        strokeDasharray: length,
        strokeDashoffset: length,
      });
    });

    const images = document.querySelectorAll(".image-reveal-container");
    images.forEach((img) => {
      gsap.set(img, {
        opacity: 0,
        y: 60,
      });
    });

    const marks = document.querySelectorAll(".quotation-mark");
    gsap.set(marks, { opacity: 0, y: 20 });

    // The Gatekeeper Wait
    await waitForLoading();

    const nameText = document.querySelectorAll(".name-text");
    gsap.set(nameText, { opacity: 1 });

    // 1. Initial Animations (Header Stroke)
    const headerWrapper = document.querySelector(".header-stroke");
    if (headerWrapper) {
      const headerPath = headerWrapper.querySelector("path");
      const headerSvg = headerWrapper.querySelector("svg");
      if (headerPath && headerSvg) {
        gsap.set(headerWrapper, { opacity: 1 });
        // @ts-ignore
        const length = headerPath.getTotalLength
          ? headerPath.getTotalLength()
          : 1000;
        gsap.to(headerPath, {
          opacity: 1,
          strokeDashoffset: 0,
          duration: 2,
          ease: "power2.out",
          delay: 1,
        });
      }
    }

    // 2. Stroke Animations with ScrollTrigger
    const strokeConfigs = [
      { selector: ".first-stroke", start: "top 85%", end: "bottom 80%" },
      { selector: ".second-stroke", start: "top 80%", end: "bottom 80%" },
      { selector: ".third-stroke", start: "top 95%", end: "bottom 80%" },
    ];

    strokeConfigs.forEach((config) => {
      const wrapper = document.querySelector(config.selector);
      if (wrapper) {
        const path = wrapper.querySelector("path");
        const svg = wrapper.querySelector("svg");
        if (path && svg) {
          ScrollTrigger.create({
            trigger: wrapper,
            start: config.start,
            onEnter: () => {
              gsap.set([wrapper, svg, path], { opacity: 1, stroke: "cadetblue", strokeWidth: "8px" });
            },
            once: true,
          });

          ScrollTrigger.create({
            trigger: wrapper,
            start: config.start,
            end: config.end,
            scrub: 1.5,
            animation: gsap.to(path, {
              strokeDashoffset: 0,
              ease: "power1.inOut",
            }),
          });
        }
      }
    });

    const trapesium = document.querySelector(".trapesium-reveal");

    // 3. Trapesium Background Animation
    if (trapesium) {
      const trapSvg = trapesium.querySelector("svg");

      // Set initial state
      gsap.set(trapSvg, { opacity: 0 });
      gsap.set(trapesium, { clipPath: "inset(0% 0% 0% 100%)" });

      // Animasi 1: Reveal ClipPath (Bulak-balik menggunakan scrub)
      ScrollTrigger.create({
        trigger: trapesium,
        start: "top 90%",
        end: "bottom 90%", // Anda harus menambahkan titik 'end' untuk menghitung durasi scrub
        scrub: 1.5,
        animation: gsap.to(trapesium, {
          clipPath: "inset(0% 0% 0% 0%)",
          ease: "none", // Best practice: gunakan "none" untuk animasi scrub agar pergerakan linear
          onStart: () => {
            gsap.set(trapSvg, { opacity: 1 });
          }, // Pastikan SVG muncul saat mulai di-scroll
        }),
      });

      // Animasi 2: Parallax xPercent (Sudah ada sebelumnya)
      gsap.to(trapesium, {
        xPercent: -14,
        ease: "none", // Pastikan ease diset none untuk scrub
        scrollTrigger: {
          trigger: trapesium,
          start: "top 30%",
          end: "bottom -50%",
          scrub: 1.5,
        },
      });
    }

    // 4. Image Container Reveals & Parallax
    images.forEach((img) => {
      ScrollTrigger.create({
        trigger: img,
        start: "top 80%",
        once: true,
        animation: gsap.to(img, {
          opacity: 1,
          y: 0,
          duration: 1.5,
          ease: "power3.out",
        }),
      });

      gsap.to(img, {
        yPercent: -20,
        ease: "power1.inOut",
        scrollTrigger: {
          trigger: img,
          start: "top bottom",
          end: "bottom top",
          scrub: 1.5,
        },
      });
    });

    // 5. Quotation Marks Animation
    marks.forEach((mark) => {
      ScrollTrigger.create({
        trigger: mark,
        start: "top 90%",
        once: true,
        animation: gsap.to(mark, {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power2.out",
        }),
      });
    });
  });

  document.addEventListener("astro:before-swap", () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
  });
</script>
