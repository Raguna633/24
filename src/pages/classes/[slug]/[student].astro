---
import MainLayout from "../../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import {
  mapStudentCollection,
  classToSlug,
  normalizePhotoPath,
  UNIVERSAL_DOWNLOAD_PASSWORD,
} from "../../../utils/student";
import { getNavigationContext } from "../../../utils/navigation";
import { buildQuery } from "../../../utils/urls";
import type { StudentFilters } from "../../../utils/filters";
import { Image } from "astro:assets";
import CloudinaryImage from "../../../components/ui/CloudinaryImage.astro";

// Generate static paths for ALL students (required for SSG)
export async function getStaticPaths() {
  const students = mapStudentCollection(await getCollection("students"));

  // OPTIMIZATION: Only pass minimal data needed
  const studentSlugs = students.map((s) => ({
    slug: s.slug,
    name: s.name,
    jenjang: s.jenjang,
    gender: s.gender,
  }));

  return students.map((s) => ({
    params: {
      slug: classToSlug(s.class),
      student: s.slug,
    },
    props: {
      studentData: s, // Current student full data
      allSlugs: studentSlugs, // Lightweight list for navigation
    },
  }));
}

interface Props {
  studentData: any;
  allSlugs: Array<{
    slug: string;
    name: string;
    jenjang: string;
    gender: string;
  }>;
}

const { studentData } = Astro.props;
const { slug, student } = Astro.params;

import { getEntry } from "astro:content";

// Map URL slug back to collection ID
let classId = slug!.replace("xii-", "");
classId = classId.replace("ipa-", "ipa");
classId = classId.replace("ips-", "ips");
const classData = await getEntry("classes", classId);
const classContent = classData?.data;

// Class-scoped navigation
const allStudents = mapStudentCollection(await getCollection("students"));
const classStudents = allStudents.filter(s => classToSlug(s.class) === slug);
const currentIndex = classStudents.findIndex(s => s.slug === student);

const prevStudent = currentIndex > 0 ? classStudents[currentIndex - 1] : null;
const nextStudent = currentIndex < classStudents.length - 1 ? classStudents[currentIndex + 1] : null;

function buildBackUrl(): string {
  // Kembali ke halaman kelas yang sesuai dengan parameter URL slug
  return `/classes/${slug}`;
}

function buildStudentUrl(studentSlug: string): string {
  return `/classes/${slug}/${studentSlug}`;
}
---

<MainLayout
  title={`${studentData.name} | Profil Siswa`}
  description={`Profil lengkap ${studentData.name}, siswa ${studentData.class} angkatan 2025`}
>
  <div
    class="min-h-dvh bg-[#f5f0ea] relative overflow-hidden"
  >
    <div class="container mx-auto px-4 py-12 relative z-10">
      {/* Back Button */}
      <div class="mb-8 opacity-0 translate-y-8 will-animate" id="back-button-container">
        <a
          href={buildBackUrl()}
          class="inline-flex items-center gap-2 px-4 py-2 bg-[#2A358F] text-[#f5f0ea] rounded-full hover:bg-[#1f2769] hover:scale-105 transition-all shadow-md group font-medium"
        >
          <svg
            class="w-5 h-5 transition-transform group-hover:-translate-x-1"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"></path>
          </svg>
          Kembali ke Kelas {studentData.class}
        </a>
      </div>

      <article class="max-w-4xl mx-auto">
        <div
          class="bg-white/80 backdrop-blur-sm rounded-xl shadow-lg p-6 md:p-8 mb-8 border border-gray-100 opacity-0 translate-y-8 will-animate"
          id="profile-info-container"
        >
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {/* Photo Section */}
            <div class="md:col-span-1">
              <div
                class="relative aspect-3/4 rounded-lg overflow-hidden border-4 border-gray-500 shadow-lg mb-4"
              >
                {
                  typeof studentData.photo === "string" &&
                  studentData.photo.includes("res.cloudinary.com") ? (
                    <CloudinaryImage
                      src={studentData.photo}
                      alt={`Foto ${studentData.name}`}
                      class="w-full h-full object-cover"
                      widths={[720, 1080]}
                      loading="eager"
                    />
                  ) : (
                    <Image
                      src={studentData.photo}
                      width={720}
                      height={1080}
                      alt={`Foto ${studentData.name}`}
                      class="w-full h-full object-cover"
                      loading="eager"
                    />
                  )
                }
              </div>

              {/* Download Button — password is validated via define:vars at build time.
                  No password is stored in DOM attributes for security. */}
              <button
                id="downloadButton"
                data-photo-url={normalizePhotoPath(studentData.photo)}
                data-student-name={studentData.name}
                class="w-full px-4 py-2 text-[#f5f0ea] rounded-lg hover:brightness-110 hover:scale-[1.02] transition-all font-medium focus-visible:ring-2 focus-visible:ring-[#2A358F] focus-visible:ring-offset-2 focus-visible:outline-none"
                style={{ backgroundColor: '#2A358F' }}
                aria-label={`Download foto ${studentData.name}`}
              >
                <svg
                  class="w-5 h-5 inline-block mr-2"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
                  ></path>
                </svg>
                Download Foto
              </button>
              <p class="text-xs text-gray-400 mt-2 text-center">
                🔒 Password diperlukan untuk download
              </p>
            </div>

            {/* Info Section */}
            <div class="md:col-span-2">
              <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
                {studentData.name}
              </h1>
              <p class="text-xl text-gray-600 mb-6">XII {studentData.class}</p>

              {
                studentData.alamat && (
                  <div class="mb-4 bg-gray-50 rounded-lg p-4">
                    <p class="text-sm text-gray-500 uppercase tracking-wide mb-1">
                      Alamat
                    </p>
                    <p class="font-medium text-gray-900">
                      {studentData.alamat}
                    </p>
                  </div>
                )
              }

              {
                studentData.instagram && (
                  <div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-lg p-4">
                    <p class="text-sm text-gray-500 uppercase tracking-wide mb-1">
                      Instagram
                    </p>
                    <a
                      href={`https://instagram.com/${studentData.instagram.replace("@", "")}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-medium text-purple-600 hover:text-purple-700 transition-colors inline-flex items-center gap-1 focus-visible:ring-2 focus-visible:ring-purple-500 focus-visible:ring-offset-2 focus-visible:outline-none rounded-sm"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                      </svg>
                      @{studentData.instagram.replace("@", "")}
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                      </svg>
                    </a>
                  </div>
                )
              }

              {
                studentData.quote && (
                  <div
                    class="mt-4 bg-gray-50 rounded-lg p-4 opacity-0 translate-y-4 will-animate"
                    id="quote-container"
                  >
                    <div class="flex items-start gap-4">
                      <svg
                        class="w-6 h-6 text-[#2A358F] flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
                      </svg>
                      <blockquote class="text-base italic text-gray-700 flex-1">
                        "{studentData.quote}"
                      </blockquote>
                    </div>
                  </div>
                )
              }
            </div>
          </div>
        </div>


        {/* OPTIMIZED NAVIGATION */}
        <nav
          class="bg-white/80 backdrop-blur-sm rounded-xl shadow-lg p-6 border border-gray-100 opacity-0 translate-y-8 will-animate"
          aria-label="Navigasi Profil Siswa"
          id="navigation-container"
        >
          <div class="flex justify-between items-center gap-4">
            {/* Previous Button / Class CTA */}
            <div class="flex-1">
              {
                prevStudent ? (
                  <a
                    href={buildStudentUrl(prevStudent.slug)}
                    class="inline-flex items-center gap-2 px-4 py-2 text-[#f5f0ea] rounded-lg hover:brightness-110 transition-colors group focus-visible:ring-2 focus-visible:ring-[#2A358F] focus-visible:ring-offset-2 focus-visible:outline-none"
                    style={{ backgroundColor: '#2A358F' }}
                    aria-label={`Sebelumnya: ${prevStudent.name}`}
                  >
                    <svg
                      class="w-5 h-5 transition-transform group-hover:-translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 19l-7-7 7-7"
                      />
                    </svg>
                    <span class="hidden sm:inline">Sebelumnya</span>
                    <span class="sm:hidden">Prev</span>
                  </a>
                ) : classContent?.prevClass ? (
                  <a
                    href={`/classes/${classContent.prevClass.slug}`}
                    class="inline-flex items-center gap-2 px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 transition-colors group border border-gray-200 focus-visible:ring-2 focus-visible:ring-gray-400 focus-visible:ring-offset-2 focus-visible:outline-none"
                    aria-label={`Kembali ke Kelas ${classContent.prevClass.name}`}
                  >
                    <svg
                      class="w-5 h-5 transition-transform group-hover:-translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M11 19l-7-7 7-7m8 14l-7-7 7-7"
                      />
                    </svg>
                    <span class="hidden sm:inline">Kelas Sebelumnya</span>
                    <span class="sm:hidden">Kelas Prev</span>
                  </a>
                ) : (
                  <div class="text-gray-400 text-sm">Siswa pertama</div>
                )
              }
            </div>

            {/* Position Indicator */}
            <div class="text-center px-4 py-2 bg-gray-100 rounded-lg">
              <span class="text-sm text-gray-600">
                <span class="font-semibold text-gray-900"
                  >{currentIndex + 1}</span
                >
                <span class="mx-1">/</span>
                <span class="font-semibold text-gray-900">{classStudents.length}</span>
              </span>
            </div>

            {/* Next Button / Class CTA */}
            <div class="flex-1 text-right">
              {
                nextStudent ? (
                  <a
                    href={buildStudentUrl(nextStudent.slug)}
                    class="inline-flex items-center justify-end gap-2 px-4 py-2 text-[#f5f0ea] rounded-lg hover:brightness-110 transition-colors group focus-visible:ring-2 focus-visible:ring-[#2A358F] focus-visible:ring-offset-2 focus-visible:outline-none ml-auto"
                    style={{ backgroundColor: '#2A358F' }}
                    aria-label={`Selanjutnya: ${nextStudent.name}`}
                  >
                    <span class="hidden sm:inline">Selanjutnya</span>
                    <span class="sm:hidden">Next</span>
                    <svg
                      class="w-5 h-5 transition-transform group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                ) : (
                  <a
                    href={classContent?.nextClass ? `/classes/${classContent.nextClass.slug}` : "/gallery/uniform"}
                    class="inline-flex items-center justify-end gap-2 px-4 py-2 bg-[#2A358F] text-[#f5f0ea] rounded-lg hover:bg-[#1f2769] transition-colors group focus-visible:ring-2 focus-visible:ring-[#2A358F] focus-visible:ring-offset-2 focus-visible:outline-none ml-auto"
                    aria-label={classContent?.nextClass ? `Lanjut ke Kelas ${classContent.nextClass.name}` : "Lanjut ke Gallery Uniform"}
                  >
                    <span class="hidden sm:inline">{classContent?.nextClass ? `Kelas Berikutnya` : `Ke Gallery`}</span>
                    <span class="sm:hidden">Lanjut</span>
                    <svg
                      class="w-5 h-5 transition-transform group-hover:translate-x-1"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 5l7 7-7 7M5 5l7 7-7 7"
                      />
                    </svg>
                  </a>
                )
              }
            </div>
          </div>
        </nav>
      </article>
    </div>
  </div>
</MainLayout>

<style>
  .will-animate {
    will-change: transform, opacity;
  }
</style>

<script is:inline define:vars={{ UNIVERSAL_DOWNLOAD_PASSWORD }}>
  window._UNIVERSAL_DOWNLOAD_PASSWORD = UNIVERSAL_DOWNLOAD_PASSWORD;
</script>

<script>
  import gsap from "gsap";
  import { waitForLoading } from "../../../utils/loadingState";

  document.addEventListener('astro:page-load', async () => {
    
    // --- STORYTELLING & PREMIUM ANIMATION (GSAP) ---
    await waitForLoading();

    const tl = gsap.timeline();

    const backBtn = document.getElementById("back-button-container");
    const profileInfo = document.getElementById("profile-info-container");
    const quoteBox = document.getElementById("quote-container");
    const navBox = document.getElementById("navigation-container");

    if (backBtn) {
      tl.to(backBtn, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power2.out",
        force3D: true,
      });
    }

    if (profileInfo) {
      const photoEl = profileInfo.querySelector(".aspect-3\\/4");
      
      if (photoEl) {
        tl.fromTo(photoEl, 
          { scale: 0.95, opacity: 0 },
          { scale: 1, opacity: 1, duration: 1.2, ease: "power3.out", force3D: true },
          "-=0.4"
        );
      }
      
      tl.to(profileInfo, {
        opacity: 1,
        y: 0,
        duration: 1,
        ease: "power3.out",
        force3D: true,
      }, "-=0.8");
    }

    if (quoteBox) {
      tl.to(quoteBox, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        force3D: true,
      }, "-=0.6");
    }

    if (navBox) {
      tl.to(navBox, {
        opacity: 1,
        y: 0,
        duration: 0.8,
        ease: "power3.out",
        force3D: true,
      }, "-=0.6");
    }

    // --- DOWNLOAD BUTTON LOGIC ---
    const downloadButton = document.getElementById('downloadButton');
    
    if (!downloadButton) return;

    downloadButton.addEventListener('click', async () => {
      const photoUrl = downloadButton.dataset.photoUrl;
      const studentName = downloadButton.dataset.studentName;

      if (!photoUrl) {
        alert('Error: Data foto tidak ditemukan');
        return;
      }

      const userPassword = prompt(
        `Masukkan password untuk download foto ${studentName}:`
      );

      if (!userPassword) return;

      // Compare against the universal password (injected server-side via inline script)
      // @ts-ignore - assigned via inline script
      if (userPassword.trim().toLowerCase() !== window._UNIVERSAL_DOWNLOAD_PASSWORD) {
        alert('❌ Password salah! Silakan coba lagi.');
        return;
      }

      try {
        const originalText = downloadButton.innerHTML;
        downloadButton.innerHTML = "Downloading...";
        downloadButton.disabled = true;

        const response = await fetch(photoUrl);
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `${studentName}-Photo.jpg`;
        link.click();
        window.URL.revokeObjectURL(url);
        
        downloadButton.innerHTML = originalText;
        downloadButton.disabled = false;
      } catch (error) {
        alert('❌ Gagal mendownload foto.');
        downloadButton.disabled = false;
      }
    });
  });
</script>
