---
import MainLayout from "../../layouts/MainLayout.astro";
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

import WaveCanvas from '../../components/WaveCanvas.astro'

import bgPattern from "../../../src/assets/bg-pattern.webp";
const bg = bgPattern.src;

import aPPLGPict from "../../assets/ip3a.webp";
import bAPLPict from "../../assets/ip3a.webp";
import cAPLPict from "../../assets/ip3a.webp";
import dOTKPPict from "../../assets/ip3a.webp";
import ipaI from "../../assets/ip3a.webp";
import ipaII from "../../assets/ip3a.webp";
import ipaIII from "../../assets/ip3a.webp";
import ipaIV from "../../assets/ip3a.webp";
import ipsI from "../../assets/ip3a.webp";
import ipsII from "../../assets/ip3a.webp";
import ipsIII from "../../assets/ip3a.webp";

interface Classes {
  img: ImageMetadata;
  width: number;
  height: number;
  alt: string;
}

const classes: Classes[] = [
  {
    img: aPPLGPict,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII A PPLG",
  },
  {
    img: bAPLPict,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII B APL",
  },
  {
    img: cAPLPict,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII C APL",
  },
  {
    img: dOTKPPict,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII D OTKP",
  },
  {
    img: ipaI,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII IPA I",
  },
  {
    img: ipaII,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII IPA II",
  },
  {
    img: ipaIII,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII IPA III",
  },
  {
    img: ipaIV,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII IPA IV",
  },
  {
    img: ipsI,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII IPS I",
  },
  {
    img: ipsII,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII IPS II",
  },
  {
    img: ipsIII,
    width: 1920,
    height: 1080,
    alt: "Foto bersama dengan wali kelas XII IPS III",
  },
];
---

<MainLayout title="" description="">
  <div class=`p-8 bg-[url(../../src/assets/bg-pattern.webp)] w-full min-h-screen bg-cover bg-repeat`>
    <div class="grid lg:grid-cols-2 w-full h-full gap-8">
      {
        classes.map((kelas) => (
          <Image
            src={kelas.img}
            width={kelas.width}
            height={kelas.height}
            alt={kelas.alt}
            class:list={" rounded-4xl"}
          />
        ))
      }
      <WaveCanvas 
        color="#fffbbb" 
        position="bottom" 
        height={120}
        speed={0.05}
      />
    </div>
  </div>
</MainLayout>
