---
import MainLayout from "../layouts/MainLayout.astro";
import ImageCard from "../components/ImageCard.astro";
import abuPutihL from "../assets/abu-putih-l-1.jpg";

interface Uniforms {
  img: typeof abuPutihL;
  alt: string;
  title: string;
}

// Create 18 uniform entries
const uniforms: Uniforms[] = Array.from({ length: 18 }, (_, i) => ({
  img: abuPutihL,
  alt: `Foto seragam sekolah ${i + 1}`,
  title: `Uniform ${i + 1}`,
}));
---

<MainLayout
  title="Our School Uniforms - Yearbook 2025"
  description="Koleksi foto seragam sekolah angkatan 2025"
>
  <section
    class="relative pb-16 overflow-hidden min-h-screen bg-gradient-to-b from-[#f5f0ea] to-[#f5f0ea]/50"
    aria-label="Galeri seragam sekolah"
  >
    {/* ==================== DECORATIVE ELEMENTS ==================== */}
    
    {/* Top Wave Divider */}
    <div class="wave-top animate-on-load" style="--delay: 0s;">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
      >
        <path d="M1200 0L0 0 892.25 114.72 1200 0z" class="shape-fill-white"></path>
      </svg>
    </div>

    {/* Floating Decorative Circles - Kiri */}
    <div class="floating-circle circle-1 parallax-slow"></div>
    <div class="floating-circle circle-2 parallax-slow"></div>
    <div class="floating-circle circle-3 parallax-slow"></div>
    
    {/* Floating Decorative Circles - Kanan */}
    <div class="floating-circle circle-4 parallax-slow"></div>
    <div class="floating-circle circle-5 parallax-slow"></div>

    {/* Decorative Lines Pattern */}
    <div class="decorative-lines lines-left parallax-medium">
      <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
        <line x1="50" y1="0" x2="50" y2="100" stroke="#3557A2" stroke-width="2" opacity="0.2"/>
        <line x1="100" y1="50" x2="100" y2="150" stroke="#2A358F" stroke-width="2" opacity="0.3"/>
        <line x1="150" y1="100" x2="150" y2="200" stroke="#3557A2" stroke-width="2" opacity="0.2"/>
      </svg>
    </div>

    <div class="decorative-lines lines-right parallax-medium">
      <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
        <line x1="50" y1="100" x2="50" y2="200" stroke="#3557A2" stroke-width="2" opacity="0.2"/>
        <line x1="100" y1="150" x2="100" y2="250" stroke="#2A358F" stroke-width="2" opacity="0.3"/>
        <line x1="150" y1="200" x2="150" y2="300" stroke="#3557A2" stroke-width="2" opacity="0.2"/>
      </svg>
    </div>

    {/* Yearbook Badge/Stamp Decoration */}
    <div class="yearbook-badge parallax-fast">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <circle cx="100" cy="100" r="80" fill="none" stroke="#2A358F" stroke-width="3" opacity="0.15"/>
        <circle cx="100" cy="100" r="65" fill="none" stroke="#3557A2" stroke-width="2" opacity="0.2"/>
        <text x="100" y="95" text-anchor="middle" font-size="24" fill="#3557A2" opacity="0.3" font-weight="bold">2026</text>
        <text x="100" y="115" text-anchor="middle" font-size="12" fill="#2A358F" opacity="0.3">AZ24RQO</text>
      </svg>
    </div>

    {/* Paper Texture Overlay (Subtle) */}
    <div class="paper-texture"></div>

    {/* ==================== CONTENT ==================== */}
    <div class="container max-w-screen mx-auto relative z-10">
      
      {/* Decorative Corner Top Left */}
      <div class="corner-decoration top-left animate-on-load" style="--delay: 0.1s;">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <path d="M 0 0 L 100 0 L 0 100 Z" fill="#3557A2" opacity="0.1"/>
          <line x1="0" y1="30" x2="70" y2="0" stroke="#2A358F" stroke-width="2" opacity="0.3"/>
        </svg>
      </div>
      
      {/* Decorative Corner Top Right */}
      <div class="corner-decoration top-right animate-on-load" style="--delay: 0.2s;">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <path d="M 100 0 L 0 0 L 100 100 Z" fill="#3557A2" opacity="0.1"/>
          <line x1="100" y1="30" x2="30" y2="0" stroke="#2A358F" stroke-width="2" opacity="0.3"/>
        </svg>
      </div>

      {/* Header Section dengan Decorative Border */}
      <header class="py-12 mx-8 text-center relative">
        {/* Title with Underline Decoration */}
        <div class="inline-block relative animate-on-load" style="--delay: 0.3s;">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-800 mb-2">
            Our School Uniforms
          </h1>
          {/* Decorative Underline */}
          <div class="decorative-underline">
            <svg viewBox="0 0 400 20" xmlns="http://www.w3.org/2000/svg">
              <path d="M 0 10 Q 100 5, 200 10 T 400 10" stroke="#3557A2" stroke-width="3" fill="none" opacity="0.4"/>
            </svg>
          </div>
        </div>
        
        <p class="text-gray-600 text-lg max-w-2xl mx-auto mt-6 animate-on-load" style="--delay: 0.4s;">
          Kenangan indah dalam seragam kebanggaan kita
        </p>

        {/* Fun Stats Section */}
        <div class="grid grid-cols-3 gap-4 max-w-2xl mx-auto mt-8">
          <div class="stat-card animate-on-load" style="--delay: 0.5s;">
            <div class="stat-number">18</div>
            <div class="stat-label">Photos</div>
          </div>
          <div class="stat-card animate-on-load" style="--delay: 0.6s;">
            <div class="stat-number">3</div>
            <div class="stat-label">Years</div>
          </div>
          <div class="stat-card animate-on-load" style="--delay: 0.7s;">
            <div class="stat-number">∞</div>
            <div class="stat-label">Memories</div>
          </div>
        </div>
      </header>

      {/* Divider dengan Icon */}
      <div class="divider-section scroll-animate" data-animation="fade-in">
        <div class="divider-line"></div>
        <div class="divider-icon">
          <svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
            <circle cx="25" cy="25" r="20" fill="#3557A2" opacity="0.2"/>
            <path d="M 25 15 L 30 25 L 25 35 L 20 25 Z" fill="#2A358F" opacity="0.4"/>
          </svg>
        </div>
        <div class="divider-line"></div>
      </div>

      {/* Image Grid dengan Frame Effect */}
      <div class="my-12 mx-auto max-w-4xl relative scroll-animate" data-animation="slide-up">
        {/* Polaroid Frame Decoration (Background) */}
        <div class="polaroid-decoration polaroid-1"></div>
        <div class="polaroid-decoration polaroid-2"></div>
        
        <ImageCard
          images={uniforms}
          gridCols={4}
          lastRowAlignment="space-between"
          imageWidth={480}
          imageHeight={480}
          gap="gap-4 md:gap-6"
          className="max-w-4xl mx-8 relative z-10"
        />
      </div>

      {/* Quote Section */}
      <div class="quote-section scroll-animate" data-animation="scale-in">
        <svg class="quote-mark quote-left" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
          <text x="10" y="40" font-size="48" fill="#3557A2" opacity="0.2">"</text>
        </svg>
        <p class="quote-text">
          Seragam adalah identitas kita, kenangan adalah harta kita
        </p>
        <svg class="quote-mark quote-right" viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
          <text x="10" y="40" font-size="48" fill="#3557A2" opacity="0.2">"</text>
        </svg>
      </div>
    </div>

    {/* Bottom Wave Divider */}
    <div class="wave-bottom" data-animation="slide-up">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
      >
        <path d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z" class="shape-fill-primary"></path>
      </svg>
    </div>
  </section>
</MainLayout>

<style>
  /* ==================== CONTAINER ==================== */
  .container {
    position: relative;
    z-index: 10;
  }

  /* ==================== PAGE LOAD ANIMATIONS ==================== */
  /* Elemen dengan class "animate-on-load" akan muncul dengan delay bertahap */
  .animate-on-load {
    opacity: 0;
    animation: fadeInUp 0.8s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ==================== SCROLL ANIMATIONS ==================== */
  /* Elemen dengan class "scroll-animate" akan muncul saat di-scroll */
  .scroll-animate {
    opacity: 0;
    transform: translateY(50px);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  /* State ketika elemen visible (akan ditambahkan via JavaScript) */
  .scroll-animate.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Variasi animasi untuk scroll */
  .scroll-animate[data-animation="fade-in"] {
    transform: none;
  }

  .scroll-animate[data-animation="fade-in"].is-visible {
    transform: none;
  }

  .scroll-animate[data-animation="slide-left"] {
    transform: translateX(-50px);
  }

  .scroll-animate[data-animation="slide-left"].is-visible {
    transform: translateX(0);
  }

  .scroll-animate[data-animation="slide-right"] {
    transform: translateX(50px);
  }

  .scroll-animate[data-animation="slide-right"].is-visible {
    transform: translateX(0);
  }

  .scroll-animate[data-animation="scale-in"] {
    transform: scale(0.9);
  }

  .scroll-animate[data-animation="scale-in"].is-visible {
    transform: scale(1);
  }

  /* ==================== PARALLAX EFFECTS ==================== */
  /* Elemen akan bergerak lebih lambat saat scroll (parallax effect) */
  .parallax-slow {
    transition: transform 0.3s ease-out;
  }

  .parallax-medium {
    transition: transform 0.3s ease-out;
  }

  .parallax-fast {
    transition: transform 0.3s ease-out;
  }

  /* ==================== WAVE DIVIDERS ==================== */
  .wave-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 1;
  }

  .wave-top svg {
    position: relative;
    display: block;
    width: calc(166% + 1.3px);
    height: 256px;
  }

  .shape-fill-white {
    fill: #ffffffd9;
  }

  .wave-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    transform: rotate(180deg);
    z-index: 1;
  }

  .wave-bottom svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 150px;
  }

  .shape-fill-primary {
    fill: #f5f0ea;
  }

  /* ==================== FLOATING CIRCLES ==================== */
  .floating-circle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(53, 87, 162, 0.1), rgba(42, 53, 143, 0.05));
    animation: float 6s ease-in-out infinite;
    z-index: 0;
    /* Initial state untuk page load animation */
    opacity: 0;
    animation: float 6s ease-in-out infinite, fadeIn 1s ease-out forwards;
  }

  .circle-1 {
    width: 200px;
    height: 200px;
    top: 15%;
    left: 5%;
    animation-delay: 0s, 0.2s;
  }

  .circle-2 {
    width: 150px;
    height: 150px;
    top: 50%;
    left: 10%;
    animation-delay: 1s, 0.4s;
  }

  .circle-3 {
    width: 100px;
    height: 100px;
    top: 75%;
    left: 8%;
    animation-delay: 2s, 0.6s;
  }

  .circle-4 {
    width: 180px;
    height: 180px;
    top: 20%;
    right: 8%;
    animation-delay: 1.5s, 0.3s;
  }

  .circle-5 {
    width: 120px;
    height: 120px;
    top: 60%;
    right: 5%;
    animation-delay: 3s, 0.5s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0) scale(1);
    }
    50% {
      transform: translateY(-20px) scale(1.05);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* ==================== DECORATIVE LINES ==================== */
  .decorative-lines {
    position: absolute;
    width: 200px;
    height: 400px;
    z-index: 0;
    opacity: 0;
    animation: slideDown 8s ease-in-out infinite, fadeIn 1s ease-out forwards;
  }

  .lines-left {
    top: 30%;
    left: 2%;
    animation-delay: 0s, 0.4s;
  }

  .lines-right {
    top: 40%;
    right: 2%;
    animation-delay: 2s, 0.6s;
  }

  @keyframes slideDown {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(30px);
    }
  }

  /* ==================== YEARBOOK BADGE ==================== */
  .yearbook-badge {
    position: absolute;
    width: 200px;
    height: 200px;
    top: 10%;
    right: 15%;
    z-index: 0;
    opacity: 0;
    animation: rotate 30s linear infinite, fadeIn 1s ease-out forwards;
    animation-delay: 0s, 0.5s;
  }

  @keyframes rotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  /* ==================== PAPER TEXTURE ==================== */
  .paper-texture {
    position: absolute;
    inset: 0;
    background-image: 
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.01) 2px,
        rgba(0, 0, 0, 0.01) 4px
      );
    pointer-events: none;
    z-index: 1;
  }

  /* ==================== CORNER DECORATIONS ==================== */
  .corner-decoration {
    position: absolute;
    width: 100px;
    height: 100px;
    z-index: 0;
  }

  .top-left {
    top: -20px;
    left: 0;
  }

  .top-right {
    top: -20px;
    right: 0;
  }

  /* ==================== DECORATIVE UNDERLINE ==================== */
  .decorative-underline {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 20px;
  }

  .decorative-underline svg path {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: drawLine 1.5s ease-out forwards;
    animation-delay: 0.5s;
  }

  @keyframes drawLine {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* ==================== STATS CARDS ==================== */
  .stat-card {
    background: white;
    padding: 1rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 8px 12px rgba(53, 87, 162, 0.15);
  }

  .stat-number {
    font-size: 2rem;
    font-weight: bold;
    color: #3557A2;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #6b7280;
    margin-top: 0.5rem;
  }

  /* ==================== DIVIDER SECTION ==================== */
  .divider-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 3rem 0;
  }

  .divider-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(to right, transparent, #3557A2, transparent);
    opacity: 0.3;
  }

  .divider-icon {
    width: 50px;
    height: 50px;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  /* ==================== POLAROID DECORATIONS ==================== */
  .polaroid-decoration {
    position: absolute;
    width: 200px;
    height: 240px;
    background: white;
    border: 1px solid #e5e7eb;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transform: rotate(-5deg);
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }

  .polaroid-decoration::after {
    content: '';
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 2px;
    background: #d1d5db;
  }

  .polaroid-1 {
    top: 10%;
    left: -5%;
    transform: rotate(-8deg) translateX(-100px);
  }

  .polaroid-2 {
    bottom: 15%;
    right: -3%;
    transform: rotate(6deg) translateX(100px);
  }

  /* Ketika parent scroll-animate visible */
  .scroll-animate.is-visible .polaroid-1 {
    opacity: 0.6;
    transform: rotate(-8deg) translateX(0);
  }

  .scroll-animate.is-visible .polaroid-2 {
    opacity: 0.6;
    transform: rotate(6deg) translateX(0);
  }

  /* ==================== QUOTE SECTION ==================== */
  .quote-section {
    position: relative;
    text-align: center;
    padding: 3rem 2rem;
    margin: 4rem auto;
    max-width: 800px;
  }

  .quote-text {
    font-size: 1.5rem;
    font-style: italic;
    color: #374151;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  .quote-mark {
    position: absolute;
    width: 50px;
    height: 50px;
    opacity: 0;
    transition: opacity 0.8s ease-out;
  }

  .scroll-animate.is-visible .quote-mark {
    opacity: 1;
  }

  .quote-left {
    top: 0;
    left: 0;
  }

  .quote-right {
    bottom: 0;
    right: 0;
    transform: rotate(180deg);
  }

  /* ==================== RESPONSIVE ==================== */
  @media (max-width: 768px) {
    .wave-top svg {
      width: calc(134% + 1.3px);
      height: 181px;
    }

    .floating-circle {
      display: none;
    }

    .decorative-lines {
      display: none;
    }

    .yearbook-badge {
      width: 120px;
      height: 120px;
      top: 5%;
      right: 5%;
    }

    .polaroid-decoration {
      display: none;
    }

    .corner-decoration {
      width: 60px;
      height: 60px;
    }

    .decorative-underline {
      width: 280px;
    }

    .quote-text {
      font-size: 1.125rem;
    }

    .stat-number {
      font-size: 1.5rem;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .wave-top svg {
      width: calc(134% + 1.3px);
      height: 181px;
    }

    .floating-circle {
      opacity: 0.5;
    }
  }
</style>

<script>
  // ==================== SCROLL ANIMATION OBSERVER ====================
  /**
   * Menggunakan Intersection Observer untuk mendeteksi kapan elemen masuk viewport
   * Best practice untuk performance karena tidak menggunakan scroll event listener
   */
  
  const observerOptions = {
    threshold: 0.1, // Trigger ketika 10% elemen terlihat
    rootMargin: '0px 0px -50px 0px' // Trigger sedikit sebelum masuk viewport
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        // Tambahkan class 'is-visible' ketika elemen masuk viewport
        entry.target.classList.add('is-visible');
        
        // Optional: Unobserve setelah animasi (agar animasi hanya terjadi sekali)
        // observer.unobserve(entry.target);
      } else {
        // Optional: Hapus class ketika keluar viewport (untuk repeating animation)
        // entry.target.classList.remove('is-visible');
      }
    });
  }, observerOptions);

  // Observe semua elemen dengan class 'scroll-animate'
  const animatedElements = document.querySelectorAll('.scroll-animate');
  animatedElements.forEach((el) => observer.observe(el));

  // ==================== PARALLAX EFFECT ====================
  /**
   * Parallax effect: Elemen bergerak dengan kecepatan berbeda saat scroll
   * Memberikan kesan depth/kedalaman pada halaman
   */
  
  let lastScrollY = window.scrollY;
  let ticking = false;

  // Fungsi untuk update posisi parallax
  function updateParallax() {
    const scrollY = window.scrollY;

    // Parallax untuk elemen yang berbeda dengan speed berbeda
    const slowElements = document.querySelectorAll<HTMLElement>('.parallax-slow');
    const mediumElements = document.querySelectorAll<HTMLElement>('.parallax-medium');
    const fastElements = document.querySelectorAll<HTMLElement>('.parallax-fast');

    // Slow parallax (bergerak 20% dari scroll speed)
    slowElements.forEach((el) => {
      const speed = 0.2;
      const yPos = -(scrollY * speed);
      el.style.transform = `translateY(${yPos}px)`;
    });

    // Medium parallax (bergerak 40% dari scroll speed)
    mediumElements.forEach((el) => {
      const speed = 0.4;
      const yPos = -(scrollY * speed);
      el.style.transform = `translateY(${yPos}px)`;
    });

    // Fast parallax (bergerak 60% dari scroll speed)
    fastElements.forEach((el) => {
      const speed = 0.6;
      const yPos = -(scrollY * speed);
      el.style.transform = `translateY(${yPos}px) rotate(${scrollY * 0.1}deg)`;
    });

    ticking = false;
  }

  // Request animation frame untuk smooth performance
  function requestTick() {
    if (!ticking) {
      window.requestAnimationFrame(updateParallax);
      ticking = true;
    }
  }

  // Listen to scroll event
  window.addEventListener('scroll', requestTick, { passive: true });

  // ==================== REDUCE MOTION PREFERENCE ====================
  /**
   * Respect user's motion preferences (accessibility)
   * Jika user prefer reduced motion, disable semua animasi
   */
  
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (prefersReducedMotion.matches) {
    // Disable all animations
    document.querySelectorAll<HTMLElement>('.scroll-animate, .animate-on-load').forEach((el) => {
      el.style.animation = 'none';
      el.style.transition = 'none';
      el.classList.add('is-visible');
    });
  }

  // ==================== CLEANUP ====================
  /**
   * Cleanup observers saat page unload untuk mencegah memory leaks
   */
  
  window.addEventListener('beforeunload', () => {
    observer.disconnect();
    window.removeEventListener('scroll', requestTick);
  });
</script>
