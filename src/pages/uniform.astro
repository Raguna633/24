---
import MainLayout from "../layouts/MainLayout.astro";
import ImageCard from "../components/ImageCard.astro";
import TextReveal from "../components/animations/TextReveal.astro";
import BlockReveal from "../components/BlockReveal.astro";
import UniformModal from "../components/UniformModal.tsx";
import { getCollection } from "astro:content";

// Fetch data from uniforms collection
const allUniforms = (await getCollection("uniforms")).sort((a, b) =>
  a.id.localeCompare(b.id),
);

// Map data for ImageCard
const uniformsData = allUniforms.map((u) => ({
  id: u.slug,
  img: u.data.uniformPhotos[0],
  alt: `Foto ${u.data.uniformName}`,
  title: u.data.uniformName,
}));
---

<MainLayout
  title="Our School Uniforms - Yearbook 2025"
  description="Koleksi foto seragam sekolah kebanggaan kita"
>
  <section
    class="relative pb-16 overflow-hidden min-h-dvh bg-gradient-to-b from-[#f5f0ea] to-[#f5f0ea]/50"
    aria-label="Galeri seragam sekolah"
  >
    {/* ==================== DECORATIVE ELEMENTS ==================== */}

    {/* Top Wave Divider */}
    <div class="wave-top opacity-0 hero-elem">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
      >
        <path d="M1200 0L0 0 892.25 114.72 1200 0z" class="shape-fill-white"
        ></path>
      </svg>
    </div>

    {/* Floating Decorative Circles - Kiri */}
    <div class="floating-circle circle-1 parallax-circle"></div>
    <div class="floating-circle circle-2 parallax-circle"></div>
    <div class="floating-circle circle-3 parallax-circle"></div>

    {/* Floating Decorative Circles - Kanan */}
    <div class="floating-circle circle-4 parallax-circle"></div>
    <div class="floating-circle circle-5 parallax-circle"></div>

    {/* Decorative Lines Pattern */}
    <div class="decorative-lines lines-left parallax-line">
      <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
        <line
          x1="50"
          y1="0"
          x2="50"
          y2="100"
          stroke="#3557A2"
          stroke-width="2"
          opacity="0.2"></line>
        <line
          x1="100"
          y1="50"
          x2="100"
          y2="150"
          stroke="#2A358F"
          stroke-width="2"
          opacity="0.3"></line>
        <line
          x1="150"
          y1="100"
          x2="150"
          y2="200"
          stroke="#3557A2"
          stroke-width="2"
          opacity="0.2"></line>
      </svg>
    </div>

    <div class="decorative-lines lines-right parallax-line">
      <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
        <line
          x1="50"
          y1="100"
          x2="50"
          y2="200"
          stroke="#3557A2"
          stroke-width="2"
          opacity="0.2"></line>
        <line
          x1="100"
          y1="150"
          x2="100"
          y2="250"
          stroke="#2A358F"
          stroke-width="2"
          opacity="0.3"></line>
        <line
          x1="150"
          y1="200"
          x2="150"
          y2="300"
          stroke="#3557A2"
          stroke-width="2"
          opacity="0.2"></line>
      </svg>
    </div>

    {/* Yearbook Badge/Stamp Decoration */}
    <div class="yearbook-badge parallax-badge opacity-0 hero-elem">
      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
        <circle
          cx="100"
          cy="100"
          r="80"
          fill="none"
          stroke="#2A358F"
          stroke-width="3"
          opacity="0.15"></circle>
        <circle
          cx="100"
          cy="100"
          r="65"
          fill="none"
          stroke="#3557A2"
          stroke-width="2"
          opacity="0.2"></circle>
        <text
          x="100"
          y="95"
          text-anchor="middle"
          font-size="24"
          fill="#3557A2"
          opacity="0.3"
          font-weight="bold">2026</text
        >
        <text
          x="100"
          y="115"
          text-anchor="middle"
          font-size="12"
          fill="#2A358F"
          opacity="0.3">AZ24RQO</text
        >
      </svg>
    </div>

    {/* Paper Texture Overlay (Subtle) */}
    <div class="paper-texture"></div>

    {/* ==================== CONTENT ==================== */}
    <div class="container max-w-screen mx-auto relative z-10">
      {/* Decorative Corner Top Left */}
      <div class="corner-decoration top-left opacity-0 hero-elem">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <path d="M 0 0 L 100 0 L 0 100 Z" fill="#3557A2" opacity="0.1"></path>
          <line
            x1="0"
            y1="30"
            x2="70"
            y2="0"
            stroke="#2A358F"
            stroke-width="2"
            opacity="0.3"></line>
        </svg>
      </div>

      {/* Decorative Corner Top Right */}
      <div class="corner-decoration top-right opacity-0 hero-elem">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <path d="M 100 0 L 0 0 L 100 100 Z" fill="#3557A2" opacity="0.1"
          ></path>
          <line
            x1="100"
            y1="30"
            x2="30"
            y2="0"
            stroke="#2A358F"
            stroke-width="2"
            opacity="0.3"></line>
        </svg>
      </div>

      {/* Header Section dengan Decorative Border */}
      <header class="py-12 mx-8 text-center relative">
        {/* Title with Underline Decoration */}
        <div class="inline-block relative hero-title-wrapper">
          <TextReveal>
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-800 mb-2"
            >
              Our School Uniforms
            </h1>
          </TextReveal>
          {/* Decorative Underline */}
          <div class="decorative-underline">
            <svg viewBox="0 0 400 20" xmlns="http://www.w3.org/2000/svg">
              <path
                class="under-path"
                d="M 0 10 Q 100 5, 200 10 T 400 10"
                stroke="#3557A2"
                stroke-width="3"
                fill="none"
                opacity="0.4"></path>
            </svg>
          </div>
        </div>

        <div class="opacity-0 hero-desc mt-6">
          <TextReveal>
            <p class="text-gray-600 text-lg max-w-2xl mx-auto">
              Kenangan indah dalam seragam kebanggaan kita
            </p>
          </TextReveal>
        </div>

        {/* Fun Stats Section */}
        <div class="grid grid-cols-3 gap-4 max-w-2xl mx-auto mt-8">
          <div class="stat-card opacity-0 hero-stat">
            <div class="stat-number">
              <BlockReveal
                blockColor="#f5f0ea"
                text={allUniforms.length.toString()}
                delay={2.2}
              />
            </div>
            <div class="stat-label">
              <BlockReveal blockColor="#f5f0ea" text="Uniforms" delay={2} />
            </div>
          </div>
          <div class="stat-card opacity-0 hero-stat">
            <div class="stat-number">
              <BlockReveal blockColor="#f5f0ea" text="3" delay={2.2} />
            </div>
            <div class="stat-label">
              <BlockReveal blockColor="#f5f0ea" text="Years" delay={2} />
            </div>
          </div>
          <div class="stat-card opacity-0 hero-stat">
            <div class="stat-number">
              <BlockReveal blockColor="#f5f0ea" text="∞" delay={2.2} />
            </div>
            <div class="stat-label">
              <BlockReveal blockColor="#f5f0ea" text="Memories" delay={2} />
            </div>
          </div>
        </div>
      </header>

      {/* Divider dengan Icon */}
      <div class="divider-section scroll-fade opacity-0">
        <div class="divider-line"></div>
        <div class="divider-icon pulse-icon">
          <svg viewBox="0 0 50 50" xmlns="http://www.w3.org/2000/svg">
            <circle cx="25" cy="25" r="20" fill="#3557A2" opacity="0.2"
            ></circle>
            <path
              d="M 25 15 L 30 25 L 25 35 L 20 25 Z"
              fill="#2A358F"
              opacity="0.4"></path>
          </svg>
        </div>
        <div class="divider-line"></div>
      </div>

      {/* Image Grid dengan Frame Effect */}
      <div class="my-12 mx-auto max-w-4xl relative">
        {/* Polaroid Frame Decoration (Background) */}
        <div class="polaroid-decoration polaroid-1 parallax-polaroid"></div>
        <div class="polaroid-decoration polaroid-2 parallax-polaroid"></div>

        <ImageCard
          images={uniformsData}
          gridCols={4}
          imageWidth={480}
          imageHeight={480}
          gap="gap-4 md:gap-6"
          className="max-w-4xl mx-8 relative z-10"
        />
      </div>

      {/* Quote Section */}
      <div class="quote-section quote-fade opacity-0">
        <svg
          class="quote-mark quote-left opacity-0"
          viewBox="0 0 50 50"
          xmlns="http://www.w3.org/2000/svg"
        >
          <text x="10" y="40" font-size="48" fill="#3557A2" opacity="0.2"
            >"</text
          >
        </svg>
        <TextReveal>
          <p class="quote-text">
            Seragam adalah identitas kita, kenangan adalah harta kita
          </p>
        </TextReveal>
        <svg
          class="quote-mark quote-right opacity-0"
          viewBox="0 0 50 50"
          xmlns="http://www.w3.org/2000/svg"
        >
          <text x="10" y="40" font-size="48" fill="#3557A2" opacity="0.2"
            >"</text
          >
        </svg>
      </div>
    </div>

    {/* Bottom Wave Divider */}
    <div class="wave-bottom scroll-fade opacity-0">
      <svg
        data-name="Layer 1"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 1200 120"
        preserveAspectRatio="none"
      >
        <path
          d="M321.39,56.44c58-10.79,114.16-30.13,172-41.86,82.39-16.72,168.19-17.73,250.45-.39C823.78,31,906.67,72,985.66,92.83c70.05,18.48,146.53,26.09,214.34,3V0H0V27.35A600.21,600.21,0,0,0,321.39,56.44Z"
          class="shape-fill-primary"></path>
      </svg>
    </div>
  </section>

  {/* Modal React Island */}
  <UniformModal uniforms={allUniforms as any} client:idle />
</MainLayout>

<style>
  /* ==================== CONTAINER ==================== */
  .container {
    position: relative;
    z-index: 10;
  }

  /* ==================== WAVE DIVIDERS ==================== */
  .wave-top {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    z-index: 1;
  }

  .wave-top svg {
    position: relative;
    display: block;
    width: calc(166% + 1.3px);
    height: 256px;
  }

  .shape-fill-white {
    fill: #ffffffd9;
  }

  .wave-bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    overflow: hidden;
    line-height: 0;
    transform: rotate(180deg);
    z-index: 1;
  }

  .wave-bottom svg {
    position: relative;
    display: block;
    width: calc(100% + 1.3px);
    height: 150px;
  }

  .shape-fill-primary {
    fill: #f5f0ea;
  }

  /* ==================== FLOATING CIRCLES ==================== */
  .floating-circle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(53, 87, 162, 0.1),
      rgba(42, 53, 143, 0.05)
    );
    z-index: 0;
    opacity: 0;
  }

  .circle-1 {
    width: 200px;
    height: 200px;
    top: 15%;
    left: 5%;
  }
  .circle-2 {
    width: 150px;
    height: 150px;
    top: 50%;
    left: 10%;
  }
  .circle-3 {
    width: 100px;
    height: 100px;
    top: 75%;
    left: 8%;
  }
  .circle-4 {
    width: 180px;
    height: 180px;
    top: 20%;
    right: 8%;
  }
  .circle-5 {
    width: 120px;
    height: 120px;
    top: 60%;
    right: 5%;
  }

  /* ==================== DECORATIVE LINES ==================== */
  .decorative-lines {
    position: absolute;
    width: 200px;
    height: 400px;
    z-index: 0;
  }

  .lines-left {
    top: 30%;
    left: 2%;
  }
  .lines-right {
    top: 40%;
    right: 2%;
  }

  /* ==================== YEARBOOK BADGE ==================== */
  .yearbook-badge {
    position: absolute;
    width: 200px;
    height: 200px;
    top: 10%;
    right: 15%;
    z-index: 0;
  }

  /* ==================== PAPER TEXTURE ==================== */
  .paper-texture {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.01) 2px,
      rgba(0, 0, 0, 0.01) 4px
    );
    pointer-events: none;
    z-index: 1;
  }

  /* ==================== CORNER DECORATIONS ==================== */
  .corner-decoration {
    position: absolute;
    width: 100px;
    height: 100px;
    z-index: 0;
  }

  .top-left {
    top: -20px;
    left: 0;
  }
  .top-right {
    top: -20px;
    right: 0;
  }

  /* ==================== DECORATIVE UNDERLINE ==================== */
  .decorative-underline {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 20px;
  }

  /* ==================== STATS CARDS ==================== */
  .stat-card {
    background: white;
    padding: 1rem;
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .stat-card:hover {
    box-shadow: 0 8px 12px rgba(53, 87, 162, 0.15);
  }

  .stat-number {
    font-size: 2rem;
    font-weight: bold;
    color: #3557a2;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #6b7280;
    margin-top: 0.5rem;
  }

  /* ==================== DIVIDER SECTION ==================== */
  .divider-section {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 3rem 0;
  }

  .divider-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(to right, transparent, #3557a2, transparent);
    opacity: 0.3;
  }

  .divider-icon {
    width: 50px;
    height: 50px;
  }

  /* ==================== POLAROID DECORATIONS ==================== */
  .polaroid-decoration {
    position: absolute;
    width: 200px;
    height: 240px;
    background: white;
    border: 1px solid #e5e7eb;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    z-index: 0;
    pointer-events: none;
    opacity: 0;
  }

  .polaroid-decoration::after {
    content: "";
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 2px;
    background: #d1d5db;
  }

  .polaroid-1 {
    top: 10%;
    left: -5%;
    transform: rotate(-8deg) translateX(-100px);
  }

  .polaroid-2 {
    bottom: 15%;
    right: -3%;
    transform: rotate(6deg) translateX(100px);
  }

  /* ==================== QUOTE SECTION ==================== */
  .quote-section {
    position: relative;
    text-align: center;
    padding: 3rem 2rem;
    margin: 4rem auto;
    max-width: 800px;
  }

  .quote-text {
    font-size: 1.5rem;
    font-style: italic;
    color: #374151;
    line-height: 1.6;
    position: relative;
    z-index: 1;
  }

  .quote-mark {
    position: absolute;
    width: 50px;
    height: 50px;
  }

  .quote-left {
    top: 0;
    left: 0;
  }
  .quote-right {
    bottom: 0;
    right: 0;
    transform: rotate(180deg);
  }

  /* ==================== RESPONSIVE ==================== */
  @media (max-width: 768px) {
    .wave-top svg {
      width: calc(134% + 1.3px);
      height: 181px;
    }
    .floating-circle,
    .decorative-lines,
    .polaroid-decoration {
      display: none;
    }
    .yearbook-badge {
      width: 120px;
      height: 120px;
      top: 5%;
      right: 5%;
    }
    .corner-decoration {
      width: 60px;
      height: 60px;
    }
    .decorative-underline {
      width: 280px;
    }
    .quote-text {
      font-size: 1.125rem;
    }
    .stat-number {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import ScrollTrigger from "gsap/ScrollTrigger";
  import { waitForLoading } from "../utils/loadingState";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener("astro:page-load", async () => {
    // Kill existing scroll triggers to prevent duplication during view transitions
    ScrollTrigger.getAll().forEach((t) => t.kill());

    // Set initial states
    gsap.set(".under-path", { strokeDasharray: 1000, strokeDashoffset: 1000 });

    // Wait for the full loading screen gatekeeper
    await waitForLoading();

    // ==================== ENTRANCE ANIMATION (HERO) ====================
    const tl = gsap.timeline();

    tl.to(".wave-top, .corner-decoration", {
      opacity: 1,
      y: 0,
      duration: 1.2,
      ease: "power3.out",
      stagger: 0.2,
    })
      .to(
        ".hero-elem",
        {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power4.out",
          stagger: 0.15,
        },
        "-=0.8",
      )
      .to(
        ".hero-desc",
        {
          opacity: 1,
          duration: 0.8,
          ease: "none",
        },
        "-=0.8",
      )
      .to(
        ".under-path",
        {
          strokeDashoffset: 0,
          duration: 1.5,
          ease: "power2.out",
        },
        "-=1",
      )
      .fromTo(
        ".hero-stat",
        { opacity: 0, y: 30, scale: 0.9 },
        {
          opacity: 1,
          y: 0,
          scale: 1,
          duration: 0.8,
          ease: "back.out(1.5)",
          stagger: 0.1,
          clearProps: "transform", // allow hover effects later
        },
        "-=0.8",
      );

    // ==================== FLOAT & PULSE ANIMATIONS (INFINITE) ====================
    gsap.to(".floating-circle", {
      y: -20,
      opacity: 1,
      duration: 3,
      yoyo: true,
      repeat: -1,
      ease: "sine.inOut",
      stagger: 0.5,
    });

    // Vertical Parallax for individual lines in Decorative SVG
    gsap.utils.toArray(".parallax-line").forEach((container) => {
      const lines = (container as HTMLElement).querySelectorAll("line");

      // Reveal container
      gsap.to(container as HTMLElement, {
        opacity: 1,
        duration: 2,
        ease: "power2.out",
        scrollTrigger: {
          trigger: container as HTMLElement,
          start: "top 90%",
        },
      });

      // Parallax for each line inside
      lines.forEach((line, i) => {
        gsap.to(line, {
          y: -100 - i * 120, // Per-line speed variation: -100, -220, -340 etc
          ease: "none",
          scrollTrigger: {
            trigger: container as HTMLElement,
            start: "top bottom",
            end: "bottom top",
            scrub: 1.5, // Smoother scrub for premium feel
          },
        });
      });
    });

    gsap.to(".pulse-icon", {
      scale: 1.1,
      duration: 2,
      yoyo: true,
      repeat: -1,
      ease: "sine.inOut",
    });

    gsap.to(".yearbook-badge", {
      rotation: 360,
      duration: 30,
      repeat: -1,
      ease: "linear",
      transformOrigin: "center center",
    });

    // ==================== SCROLL ANIMATIONS (BELOW FOLD) ====================

    // Grid Cards
    const cards = document.querySelectorAll('[data-animate-scroll="true"]');
    if (cards.length > 0) {
      // First ensure they are hidden
      gsap.set(cards, { opacity: 0, y: 50 });

      ScrollTrigger.batch(cards, {
        start: "top 85%",
        onEnter: (elements) => {
          gsap.to(elements, {
            opacity: 1,
            y: 0,
            duration: 1,
            stagger: 0.1,
            ease: "power3.out",
            clearProps: "transform",
          });
        },
      });
    }

    // Dividers
    gsap.utils.toArray(".scroll-fade").forEach((el) => {
      gsap.fromTo(
        el as Element,
        { opacity: 0, y: 30 },
        {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power2.out",
          scrollTrigger: {
            trigger: el as Element,
            start: "top 90%",
            toggleActions: "play none none reverse",
          },
        },
      );
    });

    // Quote Section
    const quoteTl = gsap.timeline({
      scrollTrigger: {
        trigger: ".quote-section",
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
    });

    quoteTl
      .to(".quote-fade", { opacity: 1, y: 0, duration: 1, ease: "power2.out" })
      .to(".quote-mark", { opacity: 1, duration: 0.8, stagger: 0.2 }, "-=0.5");

    // ==================== PARALLAX SCROLL ====================
    // Replaces JS requestAnimationFrame parallax
    gsap.utils.toArray(".parallax-circle").forEach((el, i) => {
      gsap.to(el as Element, {
        y: -100 - i * 20,
        ease: "none",
        scrollTrigger: {
          trigger: "body",
          start: "top top",
          end: "bottom top",
          scrub: 1,
        },
      });
    });

    gsap.to(".parallax-badge", {
      y: 150,
      ease: "none",
      scrollTrigger: {
        trigger: "body",
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
    });

    gsap.to(".polaroid-1", {
      y: -50,
      rotation: -10,
      opacity: 0.6,
      scrollTrigger: {
        trigger: ".polaroid-1",
        start: "top 90%",
        end: "bottom top",
        scrub: 1,
      },
    });

    gsap.to(".polaroid-2", {
      y: -80,
      rotation: 8,
      opacity: 0.6,
      scrollTrigger: {
        trigger: ".polaroid-2",
        start: "top 90%",
        end: "bottom top",
        scrub: 1,
      },
    });
  });

  // Cleanup to prevent memory leaks during page swaps
  document.addEventListener("astro:before-swap", () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
    gsap.killTweensOf("*");
  });
</script>
